NODE_ENV=production
PORT=3001
AWS_REGION=sa-east-1
TZ=America/Sao_Paulo
DATABASE_URL=postgresql://username:password@host:5432/database
DATABASE_SSL=require
DATABASE_POOL_SIZE=20
REDIS_URL=redis://username:password@host:6379
REDIS_TLS=true
JWT_SECRET=your-jwt-secret-here
SESSION_SECRET=your-session-secret-here
ENCRYPTION_KEY=your-encryption-key-here
SENDGRID_API_KEY=SG.placeholder
TWILIO_ACCOUNT_SID=AC_placeholder
TWILIO_AUTH_TOKEN=placeholder
API_BASE_URL=https://api.dom-v2.com.br
APP_BASE_URL=https://app.dom-v2.com.br
CDN_BASE_URL=https://cdn.dom-v2.com.br
ENABLE_ANALYTICS=true
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
LOG_LEVEL=info
LOG_FORMAT=json
CLUSTER_MODE=true
MAX_WORKERS=4
ENABLE_METRICS=true
METRICS_INTERVAL=60000
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
GAMIFICATION_ENABLED=true
POINTS_MULTIPLIER=1.0
WEBSOCKET_ENABLED=true
WEBSOCKET_COMPRESSION=true
PILOT_REGION=sudeste
PILOT_START_DATE=2025-08-10
PILOT_DURATION_WEEKS=12