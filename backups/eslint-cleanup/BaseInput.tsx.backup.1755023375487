import React, { memo, useState, useRef, useMemo, useCallback, useEffect } from 'react';
import { TextInput, Text, StyleSheet, Animated, TouchableOpacity } from 'react-native';
import { BaseComponentProps, AccessibilityProps, ThemeProps, InteractionProps } from './types/ComponentProps';
import { useTheme } from './utils/theme';
import { usePerformanceMonitor } from './hooks/usePerformanceMonitor';
import { useDebouncedCallback } from './hooks/useDebouncedCallback';

export interface ValidationRule {
  required?: boolean;
  minLength?: number;
  maxLength?: number;
  pattern?: RegExp;
  email?: boolean;
  phone?: boolean;
  cpf?: boolean;
  custom?: (value: string) => boolean | string;
}

export interface BaseInputProps 
  extends BaseComponentProps, 
          AccessibilityProps, 
          ThemeProps, 
          InteractionProps {
  value?: string;
  onChangeText?: (text: string) => void;
  placeholder?: string;
  label?: string;
  error?: string;
  helperText?: string;
  secureTextEntry?: boolean;
  multiline?: boolean;
  numberOfLines?: number;
  maxLength?: number;
  keyboardType?: 'default' | 'numeric' | 'email-address' | 'phone-pad' | 'decimal-pad';
  autoCapitalize?: 'none' | 'sentences' | 'words' | 'characters';
  autoCorrect?: boolean;
  autoFocus?: boolean;
  onFocus?: () => void;
  onBlur?: () => void;
  onSubmitEditing?: () => void;
  leftIcon?: React.ReactNode;
  rightIcon?: React.ReactNode;
  mask?: string | ((text: string) => string);
  validation?: ValidationRule;
  validateOnChange?: boolean;
  validateOnBlur?: boolean;
  debounceMs?: number;
  floatingLabel?: boolean;
  characterCount?: boolean;
  clearable?: boolean;
  password?: boolean;
}

// Máscaras predefinidas
const MASKS = {
  cpf: (text: string) => text.replace(/\D/g, '').replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4'),
  phone: (text: string) => text.replace(/\D/g, '').replace(/(\d{2})(\d{5})(\d{4})/, '($1) $2-$3'),
  cep: (text: string) => text.replace(/\D/g, '').replace(/(\d{5})(\d{3})/, '$1-$2'),
  currency: (text: string) => {
    const numbers = text.replace(/\D/g, '');
    const amount = parseFloat(numbers) / 100;
    return new Intl.NumberFormat('pt-BR', {
      style: 'currency',
      currency: 'BRL'
    }).format(amount);
  }
};

export const BaseInput: React.FC<BaseInputProps> = memo(({
  value = '',
  onChangeText,
  placeholder,
  label,
  error,
  helperText,
  secureTextEntry = false,
  multiline = false,
  numberOfLines = 1,
  maxLength,
  keyboardType = 'default',
  autoCapitalize = 'sentences',
  autoCorrect = true,
  autoFocus = false,
  disabled = false,
  required = false,
  onFocus,
  onBlur,
  onSubmitEditing,
  leftIcon,
  rightIcon,
  mask,
  validation,
  validateOnChange = false,
  validateOnBlur = true,
  debounceMs = 300,
  floatingLabel = true,
  characterCount = false,
  clearable = false,
  password = false,
  size = 'md',
  style,
  accessibilityLabel,
  ...props
}) => {
  const theme = useTheme();
  const performanceData = usePerformanceMonitor('BaseInput');
  
  // State
  const [isFocused, setIsFocused] = useState(false);
  const [internalError, setInternalError] = useState<string>('');
  const [showPassword, setShowPassword] = useState(!secureTextEntry && !password);
  
  // Refs
  const inputRef = useRef<TextInput>(null);
  const labelAnim = useRef(new Animated.Value(value ? 1 : 0)).current;
  
  // Derived values
  const hasError = error || internalError;
  const showHelper = helperText || hasError;
  const isPasswordType = secureTextEntry || password;
  const actualSecureTextEntry = isPasswordType && !showPassword;

  // Debounced validation
  const debouncedValidation = useDebouncedCallback((text: string) => {
    if (validation && validateOnChange) {
      const validationResult = validateValue(text);
      setInternalError(validationResult || '');
    }
  }, debounceMs);

  // Validation function
  const validateValue = useCallback((text: string): string | null => {
    if (!validation) return null;

    if (validation.required && (!text || text.trim().length === 0)) {
      return 'Este campo é obrigatório';
    }

    if (text && validation.minLength && text.length < validation.minLength) {
      return `Mínimo de ${validation.minLength} caracteres`;
    }

    if (text && validation.maxLength && text.length > validation.maxLength) {
      return `Máximo de ${validation.maxLength} caracteres`;
    }

    if (text && validation.pattern && !validation.pattern.test(text)) {
      return 'Formato inválido';
    }

    if (text && validation.email) {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(text)) {
        return 'E-mail inválido';
      }
    }

    if (text && validation.phone) {
      const phoneRegex = /^\(\d{2}\)\s\d{5}-\d{4}$/;
      if (!phoneRegex.test(text)) {
        return 'Telefone inválido';
      }
    }

    if (text && validation.cpf) {
      const cpfRegex = /^\d{3}\.\d{3}\.\d{3}-\d{2}$/;
      if (!cpfRegex.test(text)) {
        return 'CPF inválido';
      }
    }

    if (text && validation.custom) {
      const customResult = validation.custom(text);
      if (typeof customResult === 'string') {
        return customResult;
      }
      if (!customResult) {
        return 'Valor inválido';
      }
    }

    return null;
  }, [validation]);

  // Size styles
  const sizeStyles = useMemo(() => {
    switch (size) {
      case 'sm':
        return {
          height: 40,
          fontSize: theme.typography.fontSizes.sm,
          paddingHorizontal: theme.spacing.sm,
        };
      case 'md':
        return {
          height: 48,
          fontSize: theme.typography.fontSizes.md,
          paddingHorizontal: theme.spacing.md,
        };
      case 'lg':
        return {
          height: 56,
          fontSize: theme.typography.fontSizes.lg,
          paddingHorizontal: theme.spacing.lg,
        };
      default:
        return {
          height: 48,
          fontSize: theme.typography.fontSizes.md,
          paddingHorizontal: theme.spacing.md,
        };
    }
  }, [size, theme]);

  // Apply mask
  const applyMask = useCallback((text: string): string => {
    if (!mask) return text;
    
    if (typeof mask === 'string') {
      // Predefined mask
      const maskFunction = MASKS[mask as keyof typeof MASKS];
      return maskFunction ? maskFunction(text) : text;
    }
    
    if (typeof mask === 'function') {
      return mask(text);
    }
    
    return text;
  }, [mask]);

  // Handle text change
  const handleChangeText = useCallback((text: string) => {
    // Apply mask
    const maskedText = applyMask(text);
    
    // Clear error when user types
    if (internalError) {
      setInternalError('');
    }
    
    // Call parent handler
    onChangeText?.(maskedText);
    
    // Debounced validation
    if (validateOnChange) {
      debouncedValidation(maskedText);
    }
  }, [applyMask, internalError, onChangeText, validateOnChange, debouncedValidation]);

  // Handle focus
  const handleFocus = useCallback(() => {
    setIsFocused(true);
    
    // Animate label
    if (floatingLabel) {
      Animated.timing(labelAnim, {
        toValue: 1,
        duration: 200,
        useNativeDriver: false,
      }).start();
    }
    
    onFocus?.();
  }, [floatingLabel, labelAnim, onFocus]);

  // Handle blur
  const handleBlur = useCallback(() => {
    setIsFocused(false);
    
    // Animate label back if no value
    if (floatingLabel && !value) {
      Animated.timing(labelAnim, {
        toValue: 0,
        duration: 200,
        useNativeDriver: false,
      }).start();
    }
    
    // Validate on blur
    if (validateOnBlur && value) {
      const validationResult = validateValue(value);
      setInternalError(validationResult || '');
    }
    
    onBlur?.();
  }, [floatingLabel, value, labelAnim, validateOnBlur, validateValue, onBlur]);

  // Clear input
  const handleClear = useCallback(() => {
    onChangeText?.('');
    inputRef.current?.focus();
  }, [onChangeText]);

  // Toggle password visibility
  const togglePasswordVisibility = useCallback(() => {
    setShowPassword(!showPassword);
  }, [showPassword]);

  // Border color based on state
  const getBorderColor = useCallback(() => {
    if (hasError) return theme.colors.error;
    if (isFocused) return theme.colors.primary;
    return theme.colors.border;
  }, [hasError, isFocused, theme.colors]);

  // Label styles
  const labelStyle = useMemo(() => {
    if (!floatingLabel) return null;

    return [
      styles.floatingLabel,
      {
        color: hasError ? theme.colors.error : 
               isFocused ? theme.colors.primary : 
               theme.colors.textSecondary,
        fontSize: labelAnim.interpolate({
          inputRange: [0, 1],
          outputRange: [sizeStyles.fontSize, theme.typography.fontSizes.sm],
        }),
        top: labelAnim.interpolate({
          inputRange: [0, 1],
          outputRange: [sizeStyles.height / 2 - 8, -8],
        }),
        backgroundColor: theme.colors.background,
      },
    ];
  }, [floatingLabel, hasError, isFocused, theme, labelAnim, sizeStyles]);

  // Container styles
  const containerStyle = useMemo(() => [
    styles.inputContainer,
    {
      borderColor: getBorderColor(),
      borderRadius: theme.borderRadius.md,
      backgroundColor: disabled ? theme.colors.disabled : theme.colors.background,
      minHeight: multiline ? sizeStyles.height * numberOfLines : sizeStyles.height,
    },
    leftIcon && styles.withLeftIcon,
    rightIcon && styles.withRightIcon,
  ], [getBorderColor, theme, disabled, multiline, sizeStyles, numberOfLines, leftIcon, rightIcon]);

  // Input styles
  const inputStyle = useMemo(() => [
    styles.input,
    {
      fontSize: sizeStyles.fontSize,
      color: disabled ? theme.colors.textSecondary : theme.colors.text,
      paddingHorizontal: sizeStyles.paddingHorizontal,
      height: multiline ? undefined : sizeStyles.height,
    },
    multiline && styles.multilineInput,
  ], [sizeStyles, disabled, theme.colors, multiline]);

  // Character count
  const characterCountText = useMemo(() => {
    if (!characterCount) return null;
    const current = value.length;
    const max = maxLength || '∞';
    return `${current}/${max}`;
  }, [characterCount, value.length, maxLength]);

  return (
    <View style={[styles.container, style]} {...props}>
      {/* Static Label */}
      {label && !floatingLabel && (
        <Text style={[styles.staticLabel, { color: theme.colors.text }]}>
          {label}{required && ' *'}
        </Text>
      )}

      {/* Floating Label */}
      {label && floatingLabel && (
        <Animated.Text style={labelStyle}>
          {label}{required && ' *'}
        </Animated.Text>
      )}
      
      {/* Input Container */}
      <View style={containerStyle}>
        {/* Left Icon */}
        {leftIcon && (
          <View style={styles.leftIconContainer}>
            {leftIcon}
          </View>
        )}
        
        {/* Text Input */}
        <TextInput
          ref={inputRef}
          value={value}
          onChangeText={handleChangeText}
          placeholder={floatingLabel ? undefined : placeholder}
          placeholderTextColor={theme.colors.textSecondary}
          secureTextEntry={actualSecureTextEntry}
          multiline={multiline}
          numberOfLines={numberOfLines}
          maxLength={maxLength}
          keyboardType={keyboardType}
          autoCapitalize={autoCapitalize}
          autoCorrect={autoCorrect}
          autoFocus={autoFocus}
          editable={!disabled}
          onFocus={handleFocus}
          onBlur={handleBlur}
          onSubmitEditing={onSubmitEditing}
          style={inputStyle}
          accessibilityLabel={accessibilityLabel || label}
          accessibilityHint={hasError ? `Erro: ${hasError}` : helperText}
          accessibilityState={{
            disabled,
          }}
        />
        
        {/* Right Icons */}
        <View style={styles.rightIconsContainer}>
          {/* Clear button */}
          {clearable && value.length > 0 && !disabled && (
            <TouchableOpacity
              onPress={handleClear}
              style={styles.iconButton}
              accessibilityLabel="Limpar campo"
              accessibilityRole="button"
            >
              <Text style={[styles.clearIcon, { color: theme.colors.textSecondary }]}>✕</Text>
            </TouchableOpacity>
          )}
          
          {/* Password toggle */}
          {isPasswordType && (
            <TouchableOpacity
              onPress={togglePasswordVisibility}
              style={styles.iconButton}
              accessibilityLabel={showPassword ? "Ocultar senha" : "Mostrar senha"}
              accessibilityRole="button"
            >
              <Text style={[styles.passwordIcon, { color: theme.colors.textSecondary }]}>
                {showPassword ? '🙈' : '👁️'}
              </Text>
            </TouchableOpacity>
          )}
          
          {/* Custom right icon */}
          {rightIcon && (
            <View style={styles.rightIconContainer}>
              {rightIcon}
            </View>
          )}
        </View>
      </View>
      
      {/* Helper/Error Text and Character Count */}
      <View style={styles.bottomRow}>
        {showHelper && (
          <Text style={[
            styles.helperText,
            {
              color: hasError ? theme.colors.error : theme.colors.textSecondary,
            }
          ]}>
            {hasError || helperText}
          </Text>
        )}
        
        {characterCount && (
          <Text style={[styles.characterCount, { color: theme.colors.textSecondary }]}>
            {characterCountText}
          </Text>
        )}
      </View>
    </View>
  );
});

BaseInput.displayName = 'BaseInput';

