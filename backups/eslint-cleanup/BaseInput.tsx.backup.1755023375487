    flexDirection: 'row',
    alignItems: 'center',
    borderWidth: 1,
    overflow: 'hidden',
  },
  
  withLeftIcon: {
    paddingLeft: 0,
  },
  
  withRightIcon: {
    paddingRight: 0,
  },
  
  input: {
    flex: 1,
    textAlignVertical: 'top',
  },
  
  multilineInput: {
    paddingVertical: 12,
  },
  
  leftIconContainer: {
    paddingLeft: 12,
    paddingRight: 8,
    justifyContent: 'center',
  },
  
  rightIconsContainer: {
    flexDirection: 'row',
    alignItems: 'center',
  },
  
  rightIconContainer: {
    paddingRight: 12,
    paddingLeft: 8,
    justifyContent: 'center',
  },
  
  iconButton: {
    padding: 8,
    justifyContent: 'center',
    alignItems: 'center',
  },
  
  clearIcon: {
    fontSize: 16,
    fontWeight: 'bold',
  },
  
  passwordIcon: {
    fontSize: 16,
  },
  
  bottomRow: {
    flexDirection: 'row',
