import React, { memo, useMemo, useCallback, useState } from 'react';
import { View, Text, StyleSheet, TouchableOpacity } from 'react-native';
import { BaseComponentProps, AccessibilityProps, ThemeProps } from './types/ComponentProps';
import { useTheme } from './utils/theme';
import { usePerformanceMonitor } from './hooks/usePerformanceMonitor';
import { useBreakpoint } from './utils/responsive';
import { VirtualizedList } from './VirtualizedList';

export interface TableColumn<T = any> {
  key: string;
  title: string;
  dataIndex?: keyof T;
  width?: number | string;
  minWidth?: number;
  maxWidth?: number;
  align?: 'left' | 'center' | 'right';
  sortable?: boolean;
  filterable?: boolean;
  render?: (value: unknown, record: T, index: number) => React.ReactNode;
  fixed?: 'left' | 'right';
  ellipsis?: boolean;
  responsive?: ('mobile' | 'tablet' | 'desktop')[];
}

export interface TableProps<T = any> extends BaseComponentProps, AccessibilityProps, ThemeProps {
  data: T[];
  columns: TableColumn<T>[];
  loading?: boolean;
  emptyText?: string;
  pagination?: {
    current: number;
    pageSize: number;
    total: number;
    onChange: (page: number, pageSize: number) => void;
  };
  selection?: {
    selectedRowKeys: (string | number)[];
    onChange: (selectedRowKeys: (string | number)[], selectedRows: T[]) => void;
    getCheckboxProps?: (record: T) => { disabled?: boolean };
  };
  scroll?: {
    x?: number | string;
    y?: number | string;
  };
  onRow?: (record: T, index: number) => {
    onPress?: () => void;
    onLongPress?: () => void;
  };
  showHeader?: boolean;
  size?: 'small' | 'middle' | 'large';
  bordered?: boolean;
  striped?: boolean;
  hoverable?: boolean;
  sticky?: boolean;
  virtual?: boolean;
  expandable?: {
    expandedRowKeys: (string | number)[];
    onExpand: (expanded: boolean, record: T) => void;
    expandedRowRender: (record: T, index: number) => React.ReactNode;
  };
  summary?: (data: T[]) => React.ReactNode;
  rowKey?: string | ((record: T) => string | number);
}

type SortOrder = 'ascend' | 'descend' | null;

interface SortInfo {
  column: string;
  order: SortOrder;
}

export const BaseTable = memo(<T extends Record<string, any>>({
  data,
  columns,
  loading = false,
  emptyText = 'Nenhum dado encontrado',
  pagination,
  selection,
  scroll,
  onRow,
  showHeader = true,
  size = 'middle',
  bordered = false,
  striped = false,
  hoverable = true,
  sticky = false,
  virtual = false,
  expandable,
  summary,
  rowKey = 'id',
  style,
  ...props
}: TableProps<T>) => {
  const theme = useTheme();
  const performanceData = usePerformanceMonitor('BaseTable');
  const { currentBreakpoint, isMobile } = useBreakpoint();
  
  // State
  const [sortInfo, setSortInfo] = useState<SortInfo>({ column: '', order: null });
  const [expandedKeys, setExpandedKeys] = useState<Set<string | number>>(
    expandable ? new Set(expandable.expandedRowKeys) : new Set()
  );

  // Get responsive columns
  const visibleColumns = useMemo(() => {
    return columns.filter(column => {
      if (!column.responsive) return true;
      return column.responsive.includes(currentBreakpoint);
    });
  }, [columns, currentBreakpoint]);

  // Get row key
  const getRowKey = useCallback((record: T, index: number): string | number => {
    if (typeof rowKey === 'function') {
      return rowKey(record);
    }
    return record[rowKey] || index;
  }, [rowKey]);

  // Sort data
  const sortedData = useMemo(() => {
    if (!sortInfo.order || !sortInfo.column) return data;

    const column = columns.find(col => col.key === sortInfo.column);
    if (!column) return data;

    return [...data].sort((a, b) => {
      const aValue = column.dataIndex ? a[column.dataIndex] : a[column.key];
      const bValue = column.dataIndex ? b[column.dataIndex] : b[column.key];

      let result = 0;
      if (aValue < bValue) result = -1;
      if (aValue > bValue) result = 1;

      return sortInfo.order === 'ascend' ? result : -result;
    });
  }, [data, sortInfo, columns]);

  // Handle sort
  const handleSort = useCallback((column: TableColumn<T>) => {
    if (!column.sortable) return;

    const newOrder: SortOrder = 
      sortInfo.column === column.key && sortInfo.order === 'ascend' 
        ? 'descend' 
        : sortInfo.column === column.key && sortInfo.order === 'descend'
        ? null
        : 'ascend';

    setSortInfo({
      column: newOrder ? column.key : '',
      order: newOrder
    });
  }, [sortInfo]);

  // Handle expand
  const handleExpand = useCallback((record: T) => {
    if (!expandable) return;

    const key = getRowKey(record, 0);
    const newExpandedKeys = new Set(expandedKeys);
    
    if (expandedKeys.has(key)) {
      newExpandedKeys.delete(key);
      expandable.onExpand(false, record);
    } else {
      newExpandedKeys.add(key);
      expandable.onExpand(true, record);
    }
    
    setExpandedKeys(newExpandedKeys);
  }, [expandedKeys, expandable, getRowKey]);

  // Handle selection
  const handleRowSelection = useCallback((record: T, selected: boolean) => {
    if (!selection) return;

    const key = getRowKey(record, 0);
    const newSelectedKeys = [...selection.selectedRowKeys];
    
    if (selected) {
      if (!newSelectedKeys.includes(key)) {
        newSelectedKeys.push(key);
      }
    } else {
      const index = newSelectedKeys.indexOf(key);
      if (index > -1) {
        newSelectedKeys.splice(index, 1);
      }
    }

    const selectedRows = data.filter(item => 
      newSelectedKeys.includes(getRowKey(item, 0))
    );
    
    selection.onChange(newSelectedKeys, selectedRows);
  }, [selection, data, getRowKey]);

  // Get cell styles
  const getCellStyles = useCallback((column: TableColumn<T>) => {
    const baseStyle = [styles.cell];
    
    if (column.align === 'center') baseStyle.push(styles.cellCenter);
    if (column.align === 'right') baseStyle.push(styles.cellRight);
    if (column.ellipsis) baseStyle.push(styles.cellEllipsis);
    
    return baseStyle;
  }, []);

  // Render header cell
  const renderHeaderCell = useCallback((column: TableColumn<T>) => {
    const isSorted = sortInfo.column === column.key;
    const sortIcon = isSorted 
      ? sortInfo.order === 'ascend' ? '↑' : '↓'
      : '';

    return (
      <TouchableOpacity
        key={column.key}
        style={[
          styles.headerCell,
          getCellStyles(column),
          {
            backgroundColor: theme.colors.surface,
            borderBottomColor: theme.colors.border,
            minWidth: column.minWidth,
            maxWidth: column.maxWidth,
            width: column.width,
          },
          column.sortable && styles.sortableHeader,
        ]}
        onPress={() => handleSort(column)}
        disabled={!column.sortable}
        accessibilityRole="columnheader"
        accessibilityLabel={`${column.title}${column.sortable ? ', ordenável' : ''}`}
      >
        <Text style={[
          styles.headerText,
          { color: theme.colors.text, fontWeight: theme.typography.fontWeights.semibold }
        ]}>
          {column.title} {sortIcon}
        </Text>
      </TouchableOpacity>
    );
  }, [sortInfo, getCellStyles, handleSort, theme]);

  // Render data cell
  const renderDataCell = useCallback((column: TableColumn<T>, record: T, index: number) => {
    const value = column.dataIndex ? record[column.dataIndex] : record[column.key];
    const cellContent = column.render ? column.render(value, record, index) : value;

    return (
      <View
        key={column.key}
        style={[
          styles.cell,
          getCellStyles(column),
          {
            borderBottomColor: theme.colors.border,
            minWidth: column.minWidth,
            maxWidth: column.maxWidth,
            width: column.width,
          }
        ]}
      >
        <Text
          style={[
            styles.cellText,
            { color: theme.colors.text }
          ]}
          numberOfLines={column.ellipsis ? 1 : undefined}
        >
          {cellContent}
        </Text>
      </View>
    );
  }, [getCellStyles, theme]);

  // Render row
  const renderRow = useCallback((record: T, index: number) => {
    const key = getRowKey(record, index);
    const isExpanded = expandedKeys.has(key);
    const isSelected = selection?.selectedRowKeys.includes(key) || false;
    const rowProps = onRow?.(record, index) || { /* TODO: Implement error handling */ } ;

    return (
      <View key={key}>
        <TouchableOpacity
          style={[
            styles.row,
            {
              backgroundColor: isSelected 
                ? theme.colors.primary + '20'
                : striped && index % 2 === 1 
                ? theme.colors.surface 
                : 'transparent'
            },
            hoverable && styles.hoverableRow,
          ]}
          onPress={rowProps.onPress}
          onLongPress={rowProps.onLongPress}
          accessibilityRole="row"
        >
          {/* Selection checkbox */}
          {selection && (
            <View style={styles.selectionCell}>
              <TouchableOpacity
                onPress={() => handleRowSelection(record, !isSelected)}
                accessibilityRole="checkbox"
                accessibilityState={{ checked: isSelected }}
              >
                <Text style={{ color: theme.colors.primary }}>
                  {isSelected ? '☑️' : '☐'}
                </Text>
              </TouchableOpacity>
            </View>
          )}

          {/* Expand toggle */}
          {expandable && (
            <View style={styles.expandCell}>
              <TouchableOpacity
                onPress={() => handleExpand(record)}
                accessibilityRole="button"
                accessibilityLabel={isExpanded ? "Recolher" : "Expandir"}
              >
                <Text style={{ color: theme.colors.primary }}>
                  {isExpanded ? '▼' : '▶'}
                </Text>
              </TouchableOpacity>
            </View>
          )}

          {/* Data cells */}
          {visibleColumns.map(column => renderDataCell(column, record, index))}
        </TouchableOpacity>

        {/* Expanded content */}
        {expandable && isExpanded && (
          <View style={[styles.expandedContent, { backgroundColor: theme.colors.surface }]}>
            {expandable.expandedRowRender(record, index)}
          </View>
        )}
      </View>
    );
  }, [
    getRowKey, expandedKeys, selection, onRow, theme, striped, hoverable,
    handleRowSelection, expandable, handleExpand, visibleColumns, renderDataCell
  ]);

  // Render mobile card view
  const renderMobileCard = useCallback((record: T, index: number) => {
    const key = getRowKey(record, index);

    return (
      <View
        key={key}
        style={[
          styles.mobileCard,
          {
            backgroundColor: theme.colors.surface,
            borderColor: theme.colors.border,
            borderRadius: theme.borderRadius.md,
          }
        ]}
      >
        {visibleColumns.map(column => {
          const value = column.dataIndex ? record[column.dataIndex] : record[column.key];
          const cellContent = column.render ? column.render(value, record, index) : value;

          return (
            <View key={column.key} style={styles.mobileCardRow}>
              <Text style={[styles.mobileCardLabel, { color: theme.colors.textSecondary }]}>
                {column.title}:
              </Text>
              <Text style={[styles.mobileCardValue, { color: theme.colors.text }]}>
                {cellContent}
              </Text>
            </View>
          );
        })}
      </View>
    );
  }, [getRowKey, visibleColumns, theme]);

  // Empty state
  if (!loading && sortedData.length === 0) {
    return (
      <View style={[styles.emptyContainer, { backgroundColor: theme.colors.surface }]}>
        <Text style={[styles.emptyText, { color: theme.colors.textSecondary }]}>
          {emptyText}
        </Text>
      </View>
    );
  }

  // Mobile view
  if (isMobile) {
    return (
      <ScrollView
        style={[styles.container, style]}
        showsVerticalScrollIndicator={false}
        {...props}
      >
        {sortedData.map(renderMobileCard)}
        {summary && (
          <View style={styles.summaryContainer}>
            {summary(sortedData)}
          </View>
        )}
      </ScrollView>
    );
  }

  // Desktop table view
  return (
    <View style={[styles.container, style]} {...props}>
      <ScrollView
        horizontal={!!scroll?.x}
        showsHorizontalScrollIndicator={!!scroll?.x}
        style={styles.scrollContainer}
      >
        <View style={[styles.table, bordered && styles.borderedTable]}>
          {/* Header */}
          {showHeader && (
            <View style={[styles.header, sticky && styles.stickyHeader]}>
              {selection && (
                <View style={[styles.headerCell, styles.selectionCell]}>
                  <Text style={[styles.headerText, { color: theme.colors.text }]}>
                    ☐
                  </Text>
                </View>
              )}
              {expandable && (
                <View style={[styles.headerCell, styles.expandCell]}>
                  <Text style={[styles.headerText, { color: theme.colors.text }]}>
                    
                  </Text>
                </View>
              )}
              {visibleColumns.map(renderHeaderCell)}
            </View>
          )}

          {/* Body */}
          <View style={styles.body}>
            {virtual && sortedData.length > 50 ? (
              <VirtualizedList
                data={sortedData}
                renderItem={({ item, index }) => renderRow(item, index)}
                itemHeight={size === 'small' ? 40 : size === 'large' ? 60 : 50}
                keyExtractor={(item, index) => String(getRowKey(item, index))}
              />
            ) : (
              sortedData.map(renderRow)
            )}
          </View>

          {/* Summary */}
          {summary && (
            <View style={styles.summaryContainer}>
              {summary(sortedData)}
            </View>
          )}
        </View>
      </ScrollView>

      {/* Pagination */}
      {pagination && (
        <View style={styles.paginationContainer}>
          {/* TODO: Implement pagination component */}
        </View>
      )}
    </View>
  );
});

