import React, { useState, Suspense, lazy } from 'react';
import { View, Text, StyleSheet } from 'react-native';
import { useAuth } from '../context/AuthContext';
const LoginScreen = lazy(() => import('../screens/LoginScreen'));
const DashboardScreen = lazy(() => import('../screens/DashboardScreen'));
const EmployeesScreen = lazy(() => import('../screens/employees/EmployeesScreen'));
const PaymentScreen = lazy(() => import('../screens/payments/PaymentScreen'));
const TimeClockScreen = lazy(() => import('../screens/timeclock/TimeClockScreen'));
const BudgetScreen = lazy(() => import('../screens/budget/BudgetScreen'));
const TasksScreen = lazy(() => import('../screens/TasksScreen'));
const NotificationsScreen = lazy(() => import('../screens/NotificationsScreen'));
const ProfileScreen = lazy(() => import('../screens/ProfileScreen'));
const UsersScreen = lazy(() => import('../screens/UsersScreen'));
const FinanceScreen = lazy(() => import(/* webpackChunkName: "screen-finance", webpackPrefetch: true */ '../screens/FinanceScreen'));
const HRScreen = lazy(() => import('../screens/HRScreen'));
const AdvancedTimeCardScreen = lazy(() => import('../screens/AdvancedTimeCardScreen'));
const PaymentIntegrationsScreen = lazy(() => import('../screens/PaymentIntegrationsScreen'));
const ReportsScreen = lazy(() => import(/* webpackChunkName: "screen-reports", webpackPrefetch: true */ '../screens/ReportsScreen'));
import Header from '../micro-frontends/shared/components/layout/Header';
import SideMenu from '../micro-frontends/shared/components/layout/SideMenu';

const AppNavigator: React.FC = () => {
  const { isAuthenticated, isLoading, logout } = useAuth();

  if (isLoading) {
    return (
      <View style={styles.container}>
        <Text style={styles.loadingText}>Carregando DOM v2...</Text>
      </View>
    );
  }

  const [menuOpen, setMenuOpen] = useState(false);
  const initialByProfile = (() => {
    const p = (useAuth().user?.profile || '').toLowerCase();
    if (p === 'employee') return <TasksScreen />;
    if (p === 'admin') return <UsersScreen />;
    return <DashboardScreen />;
  })();
  const [current, setCurrent] = useState<React.ReactNode>(initialByProfile);

  const Placeholder: React.FC<{ title: string; description?: string }> = ({ title, description }) => (
    <View style={{ flex: 1, padding: 24 }}>
      <Text style={{ fontSize: 22, fontWeight: '700', color: '#111', marginBottom: 8 }}>{title}</Text>
      <Text style={{ fontSize: 14, color: '#666' }}>{description || 'Funcionalidade em desenvolvimento.'}</Text>
    </View>
  );

  if (!isAuthenticated) return (
    <Suspense fallback={<View style={styles.container}><Text style={styles.loadingText}>Carregando…</Text></View>}>
      <LoginScreen />
    </Suspense>
  );

  const handleNavigate = (screen?: string) => {
    switch (screen) {
      case 'employees':
        setCurrent(<EmployeesScreen />);
        break;
      case 'payments':
        setCurrent(<PaymentScreen />);
        break;
      case 'budget':
        setCurrent(<BudgetScreen />);
        break;
      case 'timeclock':
      case 'payroll':
        setCurrent(<TimeClockScreen />);
        break;
      case 'tasks':
        setCurrent(<TasksScreen />);
        break;
      case 'notifications':
        setCurrent(<NotificationsScreen />);
        break;
      case 'profile':
        setCurrent(<ProfileScreen />);
        break;
      case 'settings':
        setCurrent(<Placeholder title="Configurações" description="Configurações administrativas." />);
        break;
      case 'users':
        setCurrent(<UsersScreen />);
        break;
      case 'finance':
        setCurrent(<FinanceScreen />);
        break;
      case 'hr':
        setCurrent(<HRScreen />);
        break;
      case 'advancedTimeCard':
        setCurrent(<AdvancedTimeCardScreen />);
        break;
      case 'paymentIntegrations':
        setCurrent(<PaymentIntegrationsScreen />);
        break;
      case 'reports':
        setCurrent(<ReportsScreen />);
        break;
      case 'dashboard':
      default:
        setCurrent(<DashboardScreen />);
        break;
    }
    setMenuOpen(false);
  };

  return (
    <View style={{ flex: 1 }}>
      <Header
        title="DOM v2"
        onMenuPress={() => setMenuOpen((v) => !v)}
        onLogout={logout}
      />
      <Suspense fallback={<View style={styles.container}><Text style={styles.loadingText}>Carregando…</Text></View>}>
        <View style={{ flex: 1 }}>
          {current}
        </View>
      </Suspense>
      <SideMenu
        visible={menuOpen}
        onClose={() => setMenuOpen(false)}
        onNavigate={handleNavigate}
        onLogout={() => { logout(); setMenuOpen(false); }}
      />
    </View>
  );
};

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#f8fafc',
    justifyContent: 'center',
    alignItems: 'center',
  },
  loadingText: {
    fontSize: 18,
    color: '#6366f1',
    textAlign: 'center',
  },
});

export default AppNavigator; 