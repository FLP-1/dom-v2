            com dificuldades visuais.
          </Text>

          <Button
            title="Ativar Alto Contraste"
            variant="outline"
            onPress={() => {
              // Funcionalidade futura
            }}
            style={styles.accessibilityButton}
          />
        </BaseCard>

        {/* Exemplo de Preview */}
        <BaseCard style={styles.previewCard} padding="lg">
          <Text style={styles.sectionTitle}>
            Preview dos Componentes
          </Text>
          
          <View style={styles.previewContent}>
            <View style={styles.previewButtons}>
              <Button title="Primário" variant="primary" size="small" />
              <Button title="Secundário" variant="secondary" size="small" />
              <Button title="Outline" variant="outline" size="small" />
            </View>

            <BaseCard 
              style={styles.previewNestedCard} 
              padding="md"
            >
              <Text style={styles.previewCardTitle}>
                Card Exemplo
              </Text>
              <Text style={styles.previewCardText}>
                Este é um exemplo de como os cartões aparecem com o tema atual.
              </Text>
            </BaseCard>

            <View style={styles.previewStatusColors}>
              <View style={[styles.statusColor, { backgroundColor: '#34C759' }]}>
                <Text style={styles.statusColorText}>✓</Text>
              </View>
              <View style={[styles.statusColor, { backgroundColor: '#FF9500' }]}>
                <Text style={styles.statusColorText}>⚠</Text>
              </View>
              <View style={[styles.statusColor, { backgroundColor: '#FF3B30' }]}>
                <Text style={styles.statusColorText}>✕</Text>
              </View>
              <View style={[styles.statusColor, { backgroundColor: '#007AFF' }]}>
                <Text style={styles.statusColorText}>ℹ</Text>
              </View>
            </View>
          </View>
        </BaseCard>

        {/* Footer Info */}
        <View style={styles.footer}>
          <Text style={styles.footerText}>
            As configurações de tema são salvas automaticamente e 
            sincronizadas entre todas as telas da aplicação.
          </Text>
        </View>
      </ScrollView>
    </BaseScreen>
  );
};

