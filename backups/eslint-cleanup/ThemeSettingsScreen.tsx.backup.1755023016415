            <Text style={styles.toggleLabel}>
              Seguir tema do sistema
            </Text>
            <Switch
              value={isSystemTheme}
              onValueChange={(value) => {
                if (value) {
                  handleThemeChange('auto');
                }
              }}
              trackColor={{
                false: '#E5E5EA',
                true: '#007AFF',
              }}
              thumbColor={isSystemTheme ? '#FFFFFF' : '#8E8E93'}
            />
          </View>
        </BaseCard>

        {/* Seletor de Temas */}
        <BaseCard style={styles.themeSelectorCard} padding="lg">
          <Text style={styles.sectionTitle}>
            Escolher Tema
          </Text>
          
          <View style={styles.themeOptions}>
            <Button
              title="Tema Claro"
              onPress={() => handleThemeChange('light')}
              variant={userTheme === 'light' ? 'primary' : 'outline'}
              style={styles.themeOption}
            />
            
            <Button
              title="Tema Escuro"
              onPress={() => handleThemeChange('dark')}
              variant={userTheme === 'dark' ? 'primary' : 'outline'}
              style={styles.themeOption}
            />
            
            <Button
              title="Automático"
              onPress={() => handleThemeChange('auto')}
              variant={userTheme === 'auto' ? 'primary' : 'outline'}
              style={styles.themeOption}
            />
          </View>
        </BaseCard>

