export interface ThemeSettingsScreenProps {
  navigation?: unknown;
}

export const ThemeSettingsScreen: React.FC<ThemeSettingsScreenProps> = ({
  navigation,
}) => {
  const { 
    currentTheme, 
    userTheme, 
    systemTheme, 
    updateTheme,
    currentProfile,
    profileDisplay 
  } = useUserProfile();
  
  const [showCustomizer, setShowCustomizer] = useState(false);

  const handleThemeChange = async (theme: 'light' | 'dark' | 'auto') => {
    await updateTheme(theme);
  };

  const handleCustomThemePress = () => {
    setShowCustomizer(true);
  };

  const handleCustomizerSave = () => {
    setShowCustomizer(false);
  };

  const handleCustomizerCancel = () => {
    setShowCustomizer(false);
  };

  const isSystemTheme = userTheme === 'auto';
  const isDark = currentTheme === 'dark';

  if (showCustomizer) {
    return (
      <View style={styles.customizerContainer}>
        <Text style={styles.customizerTitle}>Personalizar Tema</Text>
        <Text style={styles.customizerDescription}>
          Funcionalidade em desenvolvimento
        </Text>
        <View style={styles.customizerActions}>
          <Button 
            title="Cancelar" 
            onPress={handleCustomizerCancel}
            variant="outline"
          />
          <Button 
            title="Salvar" 
            onPress={handleCustomizerSave}
            variant="primary"
          />
        </View>
      </View>
    );
  }

  return (
    <BaseScreen
      screenName="ThemeSettings"
      style={styles.container}
    >
      <ScrollView style={styles.content} showsVerticalScrollIndicator={false}>
        {/* Header */}
        <View style={styles.header}>
          <Text style={styles.title}>
            Configurações de Tema
          </Text>
          <Text style={styles.subtitle}>
            Personalize a aparência da aplicação
          </Text>
          <View style={styles.profileInfo}>
            <Text style={styles.profileLabel}>Perfil atual:</Text>
            <Text style={styles.profileName}>{profileDisplay.name}</Text>
          </View>
        </View>

        {/* Tema Atual */}
        <BaseCard style={styles.currentThemeCard} padding="lg">
          <Text style={styles.sectionTitle}>
            Tema Atual
          </Text>
          
          <View style={styles.currentThemeInfo}>
            <View style={styles.currentThemePreview}>
              <View style={[styles.colorSwatch, { backgroundColor: '#007AFF' }]} />
              <View style={[styles.colorSwatch, { backgroundColor: '#34C759' }]} />
              <View style={[styles.colorSwatch, { backgroundColor: '#FF9500' }]} />
              <View style={[styles.colorSwatch, { backgroundColor: '#FF3B30' }]} />
            </View>
            
            <View style={styles.currentThemeDetails}>
              <Text style={styles.currentThemeName}>
                {isSystemTheme ? 'Automático' : currentTheme === 'dark' ? 'Tema Escuro' : 'Tema Claro'}
              </Text>
              <Text style={styles.currentThemeDescription}>
                {isSystemTheme 
                  ? `Seguindo tema do sistema (${isDark ? 'escuro' : 'claro'})` 
                  : currentTheme === 'dark' ? 'Tema escuro para melhor contraste' : 'Tema claro padrão'
                }
              </Text>
            </View>
          </View>

          <View style={styles.quickActions}>
            <Button
              title="Alternar Tema"
              onPress={() => handleThemeChange(currentTheme === 'light' ? 'dark' : 'light')}
              variant="outline"
              size="small"
              style={styles.quickActionButton}
            />
            
            {!isSystemTheme && (
              <Button
                title="Usar Automático"
                onPress={() => handleThemeChange('auto')}
                variant="outline"
                size="small"
                style={styles.quickActionButton}
              />
