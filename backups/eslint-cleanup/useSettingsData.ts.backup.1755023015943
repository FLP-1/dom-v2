import { useState, useEffect, useCallback, useMemo } from 'react';
import { apiService, UserSettings, UserSettingsUpdate, ThemeConfig } from '../services/apiService';

export const useSettingsData = () => {
  // Estados principais
  const [settings, setSettings] = useState<UserSettings>({
    id: '',
    theme: {
      mode: 'system',
      primary_color: '#007AFF',
      accent_color: '#34C759',
      font_size: 'medium',
      font_family: 'system'
    },
    preferences: {
      language: 'pt-BR',
      currency: 'BRL',
      date_format: 'DD/MM/YYYY',
      time_format: '24h',
      first_day_of_week: 'monday'
    },
    ui_config: {
      sidebar_collapsed: false,
      show_animations: true,
      compact_mode: false,
      high_contrast: false,
      reduce_motion: false
    },
    notifications: {
      email_enabled: true,
      push_enabled: true,
      task_reminders: true,
      payment_alerts: true,
      achievement_notifications: true,
      quiet_hours: {
        enabled: false,
        start: '22:00',
        end: '08:00'
      }
    },
    privacy: {
      profile_visibility: 'family',
      activity_tracking: true,
      data_sharing: false,
      analytics_enabled: true
    },
    updated_at: new Date().toISOString()
  });
  
  // Estados de controle
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState<string | null>(null);

  // Carregar configurações
  const loadSettings = useCallback(async () => {
    try {
      setLoading(true);
      setError(null);

      const settingsData = await apiService.getUserSettings();
      setSettings(settingsData);
      
      // Aplicar configurações de tema ao DOM
      applyThemeToDOM(settingsData.theme);
      
      // Aplicar configurações de UI
      applyUIConfigToDOM(settingsData.ui_config);
      
    } catch (err) {
      console.error('Erro ao carregar configurações:', err);
      setError('Erro ao carregar configurações');
      
      // Manter configurações padrão em caso de erro
      const defaultSettings = settings;
      applyThemeToDOM(defaultSettings.theme);
      applyUIConfigToDOM(defaultSettings.ui_config);
      
    } finally {
      setLoading(false);
    }
  }, [settings]);

  // Aplicar tema ao DOM
  const applyThemeToDOM = useCallback((theme: ThemeConfig) => {
    const root = document.documentElement;
    
    // Aplicar modo de tema
    if (theme.mode === 'system') {
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      root.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
    } else {
      root.setAttribute('data-theme', theme.mode);
    }
    
    // Aplicar cores personalizadas
    root.style.setProperty('--primary-color', theme.primary_color);
    root.style.setProperty('--accent-color', theme.accent_color);
    
    // Aplicar tamanho de fonte
    const fontSizes = {
      small: '14px',
      medium: '16px',
      large: '18px'
    };
    root.style.setProperty('--base-font-size', fontSizes[theme.font_size]);
    
    // Aplicar família de fonte
    if (theme.font_family !== 'system') {
      root.style.setProperty('--font-family', theme.font_family);
    }
  }, []);

  // Aplicar configurações de UI ao DOM
  const applyUIConfigToDOM = useCallback((uiConfig: unknown) => {
    const root = document.documentElement;
    
    // Aplicar animações
    if (!uiConfig.show_animations) {
      root.style.setProperty('--animation-duration', '0s');
    } else {
      root.style.removeProperty('--animation-duration');
    }
    
    // Aplicar modo compacto
    if (uiConfig.compact_mode) {
      root.classList.add('compact-mode');
    } else {
      root.classList.remove('compact-mode');
    }
    
    // Aplicar alto contraste
    if (uiConfig.high_contrast) {
      root.classList.add('high-contrast');
    } else {
      root.classList.remove('high-contrast');
    }
    
    // Aplicar redução de movimento
    if (uiConfig.reduce_motion) {
      root.classList.add('reduce-motion');
    } else {
      root.classList.remove('reduce-motion');
    }
  }, []);

  // Atualizar configurações
  const updateSettings = useCallback(async (updates: UserSettingsUpdate) => {
    try {
      setSaving(true);
      setError(null);

      const updatedSettings = await apiService.updateUserSettings(updates);
      setSettings(updatedSettings);
      
      // Aplicar mudanças ao DOM se necessário
      if (updates.theme) {
        applyThemeToDOM(updatedSettings.theme);
      }
      if (updates.ui_config) {
        applyUIConfigToDOM(updatedSettings.ui_config);
      }
      
      return updatedSettings;
    } catch (err) {
      console.error('Erro ao atualizar configurações:', err);
      setError('Erro ao salvar configurações');
      return null;
    } finally {
      setSaving(false);
    }
  }, [applyThemeToDOM, applyUIConfigToDOM]);

  // Atualizar apenas tema
  const updateTheme = useCallback(async (theme: Partial<ThemeConfig>) => {
    try {
      setSaving(true);
      setError(null);

      const updatedTheme = await apiService.updateTheme({
        ...settings.theme,
        ...theme
      });
      
      setSettings(prev => ({
        ...prev,
        theme: updatedTheme
      }));
      
      applyThemeToDOM(updatedTheme);
      
      return updatedTheme;
    } catch (err) {
      console.error('Erro ao atualizar tema:', err);
      setError('Erro ao salvar tema');
      return null;
    } finally {
      setSaving(false);
    }
  }, [settings.theme, applyThemeToDOM]);

  // Resetar configurações
  const resetSettings = useCallback(async (section: 'all' | 'theme' | 'preferences' | 'ui_config' | 'notifications' | 'privacy') => {
    try {
      setSaving(true);
      setError(null);

      const resetSettings = await apiService.resetSettings(section);
      setSettings(resetSettings);
      
      // Aplicar configurações resetadas ao DOM
      applyThemeToDOM(resetSettings.theme);
      applyUIConfigToDOM(resetSettings.ui_config);
      
      return resetSettings;
    } catch (err) {
      console.error('Erro ao resetar configurações:', err);
      setError('Erro ao resetar configurações');
      return null;
    } finally {
      setSaving(false);
    }
  }, [applyThemeToDOM, applyUIConfigToDOM]);

  // Alternar modo escuro/claro
  const toggleThemeMode = useCallback(async () => {
    const currentMode = settings.theme.mode;
    let newMode: 'light' | 'dark' | 'system';
    
    if (currentMode === 'system') {
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      newMode = prefersDark ? 'light' : 'dark';
    } else if (currentMode === 'light') {
      newMode = 'dark';
    } else {
      newMode = 'light';
    }
    
    return await updateTheme({ mode: newMode });
  }, [settings.theme.mode, updateTheme]);

  // Detectar mudanças no tema do sistema
  useEffect(() => {
    if (settings.theme.mode === 'system') {
      const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      
      const handleChange = () => {
        applyThemeToDOM(settings.theme);
      };
      
      mediaQuery.addListener(handleChange);
      return () => mediaQuery.removeListener(handleChange);
    }
  }, [settings.theme, applyThemeToDOM]);

  // Recarregar configurações
  const reload = useCallback(() => {
    loadSettings();
  }, [loadSettings]);

  // Estatísticas computadas
  const computedStats = useMemo(() => ({
    is_dark_mode: settings.theme.mode === 'dark' || 
      (settings.theme.mode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches),
    is_system_theme: settings.theme.mode === 'system',
    has_custom_colors: settings.theme.primary_color !== '#007AFF' || settings.theme.accent_color !== '#34C759',
    has_accessibility_features: settings.ui_config.high_contrast || settings.ui_config.reduce_motion || settings.theme.font_size !== 'medium',
    notifications_enabled: settings.notifications.email_enabled || settings.notifications.push_enabled,
    privacy_level: settings.privacy.profile_visibility === 'private' ? 'high' : 
                   settings.privacy.profile_visibility === 'family' ? 'medium' : 'low',
    last_updated: new Date(settings.updated_at).toLocaleDateString('pt-BR')
  }), [settings]);

  // Efeito inicial
  useEffect(() => {
    loadSettings();
  }, [loadSettings]);

  return {
    // Dados
    settings,
    stats: computedStats,
    
    // Estados de controle
    loading,
    saving,
    error,
    
    // Ações
    updateSettings,
    updateTheme,
    resetSettings,
    toggleThemeMode,
    reload,
    
    // Helpers
    isUnsaved: false, // Sempre salva automaticamente
    canReset: settings.id !== '',
    getThemePreview: (theme: Partial<ThemeConfig>) => ({
      ...settings.theme,
      ...theme
    }),
    formatLastUpdated: () => computedStats.last_updated,
    
    // Configurações específicas
    theme: settings.theme,
    preferences: settings.preferences,
    uiConfig: settings.ui_config,
    notifications: settings.notifications,
    privacy: settings.privacy
  };
};
