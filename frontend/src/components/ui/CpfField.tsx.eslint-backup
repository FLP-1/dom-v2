React from 'react';
import { View, Text, TextInput, StyleSheet } from 'react-native';
import { formatCPF, validateCPF, onlyDigits } from '../../utils/validation';

type CpfFieldProps = {
  value: string;
  onChange: (cpfDigits: string) => void;
  label?: string;
  placeholder?: string;
  showValidation?: boolean;
};

const CpfField: React.FC<CpfFieldProps> = ({ value, onChange, label = 'CPF', placeholder = '000.000.000-00', showValidation = true }) => {
  const digits = onlyDigits(value);
  const isValid = digits.length === 0 ? true : validateCPF(digits);
  return (
    <View style={styles.container}>
      {label ? <Text style={styles.label}>{label}</Text> : null}
      <TextInput
        placeholder={placeholder}
        value={formatCPF(value)}
        onChangeText={(t) => onChange(onlyDigits(t))}
        keyboardType="numeric"
        style={[styles.input, showValidation && digits.length > 0 && !isValid ? styles.inputError : undefined]}
      />
      {showValidation && digits.length > 0 && !isValid && (
        <Text style={styles.error}>CPF inválido</Text>
      )}
    </View>
  );
};

const styles = StyleSheet.create({
  container: { marginTop: 8 },
  label: { fontSize: 12, color: '#475569' },
  input: { backgroundColor: '#f1f5f9', borderRadius: 8, paddingHorizontal: 12, paddingVertical: 10, marginTop: 4 },
  inputError: { borderWidth: 1, borderColor: '#ef4444' },
  error: { color: '#ef4444', fontSize: 12, marginTop: 4 },
});

export default CpfField;

