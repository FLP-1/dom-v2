import React from 'react';
import { Text, TextProps } from 'react-native';

type GlyphMap = Record<string, number | string>;

export default function createIconSet(glyphMap: GlyphMap) {
  const Icon: React.FC<TextProps & { name?: keyof typeof glyphMap; size?: number; color?: string }>
    = ({ name, size = 20, color = '#2d2d2d', children, ...props }) => {
    const glyph = (name && glyphMap[name as string]) || '';
    return (
      <Text {...props} style={[{ fontSize: size, color }, props.style]}>
        {glyph}
        {children}
      </Text>
    );
  };
  return Icon as any;
}

