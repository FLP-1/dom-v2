            font-size: 12px;
    
            font-weight: 600;
    
            text--webkit-transform: uppercase;
}

        .status-active {
    
            color: #065f46;
    
            background: #d1fae5;
}

        .status-inactive {
    
            color: #991b1b;
    
            background: #fee2e2;
}

        .status-pending {
    
