    <!-- Scripts -->
    <script src="js/messages-system.js"></script>
    <script src="js/components.js"></script>
    <script>
        // Dados dos funcionÃ¡rios
        let employees = JSON.parse(localStorage.getItem('dom_v2_employees')) || [
            {
    
                id: 1,
                name: 'Maria Silva',
                email: 'maria.silva@email.com',
                phone: '(11) 99999-9999',
                position: 'Auxiliar de Limpeza',
                department: 'limpeza',
                salary: 1200.00,
                hireDate: '2023-01-15',
                status: 'active'
            ;
},
            {
    
                id: 2,
                name: 'JoÃ£o Santos',
                email: 'joao.santos@email.com',
                phone: '(11) 88888-8888',
                position: 'Cozinheiro',
                department: 'cozinha',
                salary: 1800.00,
                hireDate: '2023-03-20',
                status: 'active'
            ;
},
            {
    
                id: 3,
                name: 'Ana Costa',
                email: 'ana.costa@email.com',
                phone: '(11) 77777-7777',
                position: 'Jardineiro',
                department: 'jardinagem',
                salary: 1400.00,
                hireDate: '2023-02-10',
                status: 'pending'
            ;
}
        ];

        let editingEmployeeId = null;

        // InicializaÃ§Ã£o da pÃ¡gina
        document.addEventListener('DOMContentLoaded', function() {
    
            // Inicializar sistema de componentes
            const componentManager = new ComponentManager();
    
            componentManager.initPage('FuncionÃ¡rios');
    
            
            // Carregar funcionÃ¡rios
            loadEmployees();
    
            updateStats();
    
            
            // Configurar formulÃ¡rio
            setupForm();
    
            
            // Configurar busca e filtros
            setupSearchAndFilters();
});

        // FunÃ§Ã£o para carregar funcionÃ¡rios
        function loadEmployees() {
    
            const tableBody = document.getElementById('employeesTableBody');
    
            const filteredEmployees = filterEmployees(employees);
    
            
            if (filteredEmployees.length === 0) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="8" class="extracted-style-1">
                            Nenhum funcionÃ¡rio encontrado
                        </td>
                    </tr>
                `;
    
                return;
}
            
            tableBody.innerHTML = filteredEmployees.map(employee => createEmployeeRow(employee)).join('');
        }

        // FunÃ§Ã£o para filtrar funcionÃ¡rios
        function filterEmployees(employees) {
    
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
    
            const statusFilter = document.getElementById('statusFilter').value;
    
            const departmentFilter = document.getElementById('departmentFilter').value;
    
            
            return employees.filter(employee => {
                const matchesSearch = employee.name.toLowerCase().includes(searchTerm) ||
                                    employee.email.toLowerCase().includes(searchTerm) ||
                                    employee.position.toLowerCase().includes(searchTerm);
    
                
                const matchesStatus = !statusFilter || employee.status === statusFilter;
    
                const matchesDepartment = !departmentFilter || employee.department === departmentFilter;
    
                
                return matchesSearch && matchesStatus && matchesDepartment;
});
        }

        // FunÃ§Ã£o para criar linha da tabela
        function createEmployeeRow(employee) {
    
            const statusLabels = {
                active: 'Ativo',
                inactive: 'Inativo',
                pending: 'Pendente'
            ;
};
            
            const departmentLabels = {
    
                limpeza: 'Limpeza',
                cozinha: 'Cozinha',
                jardinagem: 'Jardinagem',
                manutencao: 'ManutenÃ§Ã£o'
            ;
};
            
            return `
                <tr>
                    <td>${
    employee.name;
}</td>
                    <td>${
    employee.position;
}</td>
                    <td>${
    departmentLabels[employee.department];
}</td>
                    <td>${
    employee.email;
}</td>
                    <td>${
    employee.phone;
}</td>
                    <td>
                        <span class="status-badge status-${
    employee.status;
}">
                            ${
    statusLabels[employee.status];
}
                        </span>
                    </td>
                    <td>R$ ${
    employee.salary.toFixed(2);
}</td>
                    <td>
                        <div class="action-buttons">
                            <button class="btn btn-small btn-view" onclick="viewEmployee(${
    employee.id;
})" tabindex="0">ðŸ‘ï¸</button>
                            <button class="btn btn-small btn-edit" onclick="editEmployee(${
    employee.id;
})" tabindex="0">âœï¸</button>
                            <button class="btn btn-small btn-delete" onclick="deleteEmployee(${
    employee.id;
})" tabindex="0">ðŸ—‘ï¸</button>
                        </div>
                    </td>
                </tr>
            `;
        }

        // FunÃ§Ã£o para atualizar estatÃ­sticas
        function updateStats() {
    
            document.getElementById('totalEmployees').textContent = employees.length;
    
            document.getElementById('activeEmployees').textContent = employees.filter(e => e.status === 'active').length;
    
            document.getElementById('pendingEmployees').textContent = employees.filter(e => e.status === 'pending').length;
    
            document.getElementById('inactiveEmployees').textContent = employees.filter(e => e.status === 'inactive').length;
}

        // FunÃ§Ã£o para configurar formulÃ¡rio
        function setupForm() {
    
            document.getElementById('employeeFormElement').addEventListener('submit', function(e) {
                e.preventDefault();
    
                saveEmployee();
});
        }

        // FunÃ§Ã£o para configurar busca e filtros
        function setupSearchAndFilters() {
    
            document.getElementById('searchInput').addEventListener('input', loadEmployees);
    
            document.getElementById('statusFilter').addEventListener('change', loadEmployees);
    
            document.getElementById('departmentFilter').addEventListener('change', loadEmployees);
}

        // FunÃ§Ã£o para mostrar formulÃ¡rio de adiÃ§Ã£o
        function showAddForm() {
    
            editingEmployeeId = null;
    
            document.getElementById('formTitle').textContent = 'Adicionar FuncionÃ¡rio';
    
            document.getElementById('employeeFormElement').reset();
    
            document.getElementById('employeeForm').classList.add('show');
}

        // FunÃ§Ã£o para esconder formulÃ¡rio
        function hideForm() {
    
            document.getElementById('employeeForm').classList.remove('show');
    
            editingEmployeeId = null;
}

        // FunÃ§Ã£o para editar funcionÃ¡rio
        function editEmployee(employeeId) {
    
            const employee = employees.find(e => e.id === employeeId);
    
            if (!employee) return;
    
            
            editingEmployeeId = employeeId;
    
            document.getElementById('formTitle').textContent = 'Editar FuncionÃ¡rio';
    
            
            document.getElementById('name').value = employee.name;
    
            document.getElementById('email').value = employee.email;
    
            document.getElementById('phone').value = employee.phone;
    
            document.getElementById('position').value = employee.position;
    
            document.getElementById('department').value = employee.department;
    
            document.getElementById('salary').value = employee.salary;
    
            document.getElementById('hireDate').value = employee.hireDate;
    
            document.getElementById('status').value = employee.status;
    
            
            document.getElementById('employeeForm').classList.add('show');
}

        // FunÃ§Ã£o para salvar funcionÃ¡rio
        function saveEmployee() {
    
            const employeeData = {
                name: document.getElementById('name').value,
                email: document.getElementById('email').value,
                phone: document.getElementById('phone').value,
                position: document.getElementById('position').value,
                department: document.getElementById('department').value,
                salary: parseFloat(document.getElementById('salary').value),
                hireDate: document.getElementById('hireDate').value,
                status: document.getElementById('status').value
            ;
};
            
            if (editingEmployeeId) {
    
                // Editar funcionÃ¡rio existente
                const employeeIndex = employees.findIndex(e => e.id === editingEmployeeId);
    
                if (employeeIndex !== -1) {
                    employees[employeeIndex] = { ...employees[employeeIndex], ...employeeData ;
};
                }
            } else {
    
                // Adicionar novo funcionÃ¡rio
                const newEmployee = {
                    ...employeeData,
                    id: Date.now()
                ;
};
                employees.push(newEmployee);
            }
            
            // Salvar no localStorage
            localStorage.setItem('dom_v2_employees', JSON.stringify(employees));
            
            // Atualizar interface
            loadEmployees();
            updateStats();
            hideForm();
        }

        // FunÃ§Ã£o para visualizar funcionÃ¡rio
        function viewEmployee(employeeId) {
    
            const employee = employees.find(e => e.id === employeeId);
    
            if (!employee) return;
    
            
            const departmentLabels = {
                limpeza: 'Limpeza',
                cozinha: 'Cozinha',
                jardinagem: 'Jardinagem',
                manutencao: 'ManutenÃ§Ã£o'
            ;
};
            
            const statusLabels = {
    
                active: 'Ativo',
                inactive: 'Inativo',
                pending: 'Pendente'
            ;
};
            
            document.getElementById('employeeDetails').innerHTML = `
                <div class="extracted-style-2">
                    <div><strong>Nome:</strong> ${
    employee.name;
}</div>
                    <div><strong>Email:</strong> ${
    employee.email;
}</div>
                    <div><strong>Telefone:</strong> ${
    employee.phone;
}</div>
                    <div><strong>Cargo:</strong> ${
    employee.position;
}</div>
                    <div><strong>Departamento:</strong> ${
    departmentLabels[employee.department];
}</div>
                    <div><strong>SalÃ¡rio:</strong> R$ ${
    employee.salary.toFixed(2);
}</div>
                    <div><strong>Data de ContrataÃ§Ã£o:</strong> ${
    new Date(employee.hireDate).toLocaleDateString('pt-BR');
}</div>
                    <div><strong>Status:</strong> ${
    statusLabels[employee.status];
}</div>
                </div>
            `;
            
            document.getElementById('viewModal').classList.add('show');
        }

        // FunÃ§Ã£o para fechar modal de visualizaÃ§Ã£o
        function closeViewModal() {
    
            document.getElementById('viewModal').classList.remove('show');
}

        // FunÃ§Ã£o para excluir funcionÃ¡rio
        function deleteEmployee(employeeId) {
    
            if (!await messageSystem.confirm('confirm.delete')) return;
    
            
            employees = employees.filter(e => e.id !== employeeId);
    
            localStorage.setItem('dom_v2_employees', JSON.stringify(employees));
    
            loadEmployees();
    
            updateStats();
}

        // FunÃ§Ãµes de exportaÃ§Ã£o e importaÃ§Ã£o (simuladas)
        function exportData() {
    
            const dataStr = JSON.stringify(employees, null, 2);
    
            const dataBlob = new Blob([dataStr], {type: 'application/json';
});
            const url = URL.createObjectURL(dataBlob);
            const link = document.createElement('a');
            link.href = url;
            link.download = 'funcionarios.json';
            link.click();
            URL.revokeObjectURL(url);
        }

        function importData() {
    
            showMessage('feature.import.soon');
}

        // Fechar modais ao clicar fora
        document.getElementById('viewModal').addEventListener('click', function(e) {
    
            if (e.target === this) {
                closeViewModal();
}
        });
    </script>
