                    <!-- Dados serÃ£o carregados dinamicamente -->
                </tbody>
            </table>
        </div>

        <!-- View Employee Modal -->
        <div class="modal" id="viewModal">
            <div class="modal-content">
                <h3 class="modal-title">Detalhes do FuncionÃ¡rio</h3>
