    <script>
        // ConfiguraÃ§Ã£o da API
        const API_BASE_URL = 'http://localhost:3001/api';
        
        // FunÃ§Ãµes de API
        async function fetchAdminData() {
    
            try {
                const [usersResponse, notificationsResponse, systemStatsResponse] = await Promise.all([
                    fetch(`${API_BASE_URL;
}/admin/users`),
                    fetch(`${
    API_BASE_URL;
}/notifications`),
                    fetch(`${
    API_BASE_URL;
}/admin/users/stats/summary`)
                ]);

                const users = await usersResponse.json();
                const notifications = await notificationsResponse.json();
                const systemStats = await systemStatsResponse.json();

                return {
    
                    users: users.success ? users.users : [],
                    notifications: notifications.success ? notifications.notifications : [],
                    systemStats: systemStats.success ? systemStats.stats : {;
}
                };
            } catch (error) {
    
                console.error('Erro ao buscar dados administrativos:', error);
    
                return { users: [], notifications: [], systemStats: {;
} };
            }
        }

        // Carregar dados dinÃ¢micos
        async function loadDashboardData() {
    
            try {
                const data = await fetchAdminData();
    
                
                // Atualizar mÃ©tricas com dados reais
                updateMetrics(data);
    
                
                // Atualizar lista de usuÃ¡rios
                updateUserList(data.users);
    
                
                // Atualizar alertas do sistema
                updateAlertList(data.notifications);
} catch (error) {
    
                console.error('Erro ao carregar dados do dashboard:', error);
}
        }

        function updateMetrics(data) {
    
            // UsuÃ¡rios ativos
            const activeUsers = data.users.filter(user => user.status === 'active').length;
    
            
            // NotificaÃ§Ãµes crÃ­ticas
            const criticalAlerts = data.notifications.filter(notif => 
                notif.priority === 'high' && !notif.read
            ).length;
    
            
            // Sistema online (sempre 100% por enquanto)
            const systemStatus = 100;
    
            
            // SeguranÃ§a (sempre 100% por enquanto)
            const securityStatus = 100;
    
            
            // Atualizar cards de mÃ©tricas
            const usersElement = document.querySelector('.metric-card.users .metric-value');
    
            const systemElement = document.querySelector('.metric-card.system .metric-value');
    
            const securityElement = document.querySelector('.metric-card.security .metric-value');
    
            const alertsElement = document.querySelector('.metric-card.alerts .metric-value');
    
            
            if (usersElement) usersElement.textContent = activeUsers.toString();
    
            if (systemElement) systemElement.textContent = `${systemStatus;
}%`;
            if (securityElement) securityElement.textContent = `${
    securityStatus;
}%`;
            if (alertsElement) alertsElement.textContent = criticalAlerts.toString();
        }

        function updateUserList(users) {
    
            const userList = document.getElementById('userList');
    
            if (!userList) return;
    

            if (users.length === 0) {
                userList.innerHTML = `
                    <div class="extracted-style-3">
                        Nenhum usuÃ¡rio encontrado
                    </div>
                `;
    
                return;
}

            userList.innerHTML = users.slice(0, 5).map(user => `
                <div class="user-item">
                    <div class="user-avatar-small">${
    user.name ? user.name.charAt(0).toUpperCase() : 'U';
}</div>
                    <div class="user-info-small">
                        <div class="user-name">${
    user.name || 'UsuÃ¡rio';
}</div>
                        <div class="user-email">${
    user.email || 'email@exemplo.com';
}</div>
                    </div>
                    <div class="user-status ${
    user.status === 'active' ? 'active' : 'inactive';
}">
                        ${
    user.status === 'active' ? 'Ativo' : 'Inativo';
}
                    </div>
                </div>
            `).join('');
        }

        function updateAlertList(notifications) {
    
            const alertList = document.getElementById('alertList');
    
            if (!alertList) return;
    

            const criticalNotifications = notifications.filter(notif => 
                notif.priority === 'high' && !notif.read
            ).slice(0, 3);
    

            if (criticalNotifications.length === 0) {
                alertList.innerHTML = `
                    <div class="extracted-style-4">
                        Nenhum alerta crÃ­tico
                    </div>
                `;
    
                return;
}

            alertList.innerHTML = criticalNotifications.map(notif => `
                <div class="alert-item critical">
                    <div class="alert-icon">âš ï¸</div>
                    <div class="alert-content">
                        <div class="alert-title">${
    notif.title;
}</div>
                        <div class="alert-message">${
    notif.message;
}</div>
                    </div>
                    <div class="alert-time">${
    new Date(notif.created_at).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' ;
})}</div>
                </div>
            `).join('');
        }

        // InicializaÃ§Ã£o
        document.addEventListener('DOMContentLoaded', function() {
    
            loadDashboardData();
});
