            border-radius: 8px;
    
            font-size: 16px;
    
            cursor: pointer;
    
            -webkit-transition: all 0.2s ease;
    
            align-items: center;
    
            gap: 5px;
}

        .back-button:hover {
    
            background: #0056CC;
    
    transform: translateY(-1px);
    
            -webkit-transform: translateY(-1px);
}

        .header-title {
    
            color: #1e293b;
    
            font-size: 20px;
    
            font-weight: bold;
}

        .header-right {
    
            display: flex;
    
            align-items: center;
    
            gap: 10px;
}

