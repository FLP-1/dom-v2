<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Administrador - DOM v2</title>
    <style>
        * {
    
            margin: 0;
    
            padding: 0;
    
            box-sizing: border-box;
}

        body {
    
            color: #1f2937;
    
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
    
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
    
            line-height: 1.6;
    
            min-height: 100vh;
}

        .container {
    
            margin: 0 auto;
    
            padding: 20px;
    
            max-width: 1400px;
}

        /* Header Administrativo */
        .header-admin {
    -webkit--webkit-backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    display: flex;
    padding: 24px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    margin-bottom: 24px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    justify-content: space-between;
    align-items: center;
}

        .user-info {
    
            display: flex;
    
            align-items: center;
    
            gap: 16px;
}

        .user-avatar {
    
            display: flex;
    
            width: 60px;
    
            height: 60px;
    
            color: white;
    
            background: linear-gradient(135deg, #1e3c72, #2a5298);
    
            border-radius: 50%;
    
            align-items: center;
    
            justify-content: center;
    
            font-size: 24px;
}

        .user-details h1 {
    
            color: #1f2937;
    
            font-size: 1.8rem;
    
            font-weight: 700;
    
            margin-bottom: 4px;
}

        .user-role {
    
            padding: 4px 12px;
    
            color: white;
    
            background: linear-gradient(135deg, #1e3c72, #2a5298);
    
            border-radius: 20px;
    
            font-size: 0.85rem;
    
            font-weight: 600;
}

        .header-actions {
    
            display: flex;
    
            gap: 12px;
    
            align-items: center;
}

        .notification-btn {
    
            position: relative;
    
            padding: 12px;
    
            border: 1px solid #e5e7eb;
    
            background: rgba(255, 255, 255, 0.8);
    
    transition: all 0.2s ease;
    
            border-radius: 12px;
    
            cursor: pointer;
    
            -webkit-transition: all 0.2s ease;
}

        .notification-btn:hover {
    
            background: white;
    
    transform: translateY(-1px);
    
            -webkit-transform: translateY(-1px);
}

        .notification-badge {
    
            display: flex;
    
            position: absolute;
    
            top: -4px;
    
            right: -4px;
    
            width: 20px;
    
            height: 20px;
    
            color: white;
    
            background: #ef4444;
    
            border-radius: 50%;
    
            font-size: 0.75rem;
    
            align-items: center;
    
            justify-content: center;
}

        /* MÃ©tricas Administrativas */
        .metrics-grid {
    
            display: grid;
    
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    
            gap: 20px;
    
            margin-bottom: 24px;
}

        .metric-card {
    
            padding: 24px;
    
            background: white;
    
    transition: transform 0.2s ease;
    
            border-radius: 16px;
    
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    
            border-left: 4px solid;
    
            -webkit-transition: transform 0.2s ease;
}

        .metric-card:hover {
    
    transform: translateY(-2px);
    
            -webkit-transform: translateY(-2px);
}

        .metric-card.users {
    
            border-left-color: #3b82f6;
}

        .metric-card.system {
    
            border-left-color: #10b981;
}

        .metric-card.security {
    
            border-left-color: #f59e0b;
}

        .metric-card.alerts {
    
            border-left-color: #ef4444;
}

        .metric-header {
    
            display: flex;
    
            justify-content: space-between;
    
            align-items: center;
    
            margin-bottom: 16px;
}

        .metric-icon {
    
            font-size: 2rem;
}

        .metric-trend {
    
            padding: 4px 8px;
    
            font-size: 0.8rem;
    
            border-radius: 6px;
    
            font-weight: 600;
}

        .metric-trend.positive {
    
            color: #065f46;
    
            background: #d1fae5;
}

        .metric-trend.negative {
    
            color: #991b1b;
    
            background: #fee2e2;
}

        .metric-value {
    
            color: #1f2937;
    
            font-size: 2rem;
    
            font-weight: 700;
    
            margin-bottom: 8px;
}

        .metric-label {
    
            color: #6b7280;
    
            font-size: 0.9rem;
}

        /* AÃ§Ãµes Administrativas */
        .admin-actions {
    
            padding: 24px;
    
            background: white;
    
            border-radius: 16px;
    
            margin-bottom: 24px;
    
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

        .admin-actions h2 {
    
            color: #1f2937;
    
            font-size: 1.3rem;
    
            font-weight: 600;
    
            margin-bottom: 16px;
}

        .actions-grid {
    
            display: grid;
    
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    
            gap: 12px;
}

        .action-btn {
    
            display: flex;
    
            padding: 16px 20px;
    
            border: none;
    
            color: white;
    
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
    
    transition: all 0.2s ease;
    
            border-radius: 12px;
    
            font-weight: 600;
    
            cursor: pointer;
    
            -webkit-transition: all 0.2s ease;
    
            align-items: center;
    
            gap: 8px;
    
            text-decoration: none;
    
            justify-content: center;
}

        .action-btn:hover {
    
    transform: translateY(-1px);
    
            -webkit-transform: translateY(-1px);
    
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
}

        /* SeÃ§Ãµes Principais */
        .main-sections {
    
            display: grid;
    
            grid-template-columns: 2fr 1fr;
    
            gap: 24px;
}

        .section-card {
    
            padding: 24px;
    
            background: white;
    
            border-radius: 16px;
    
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

        .section-header {
    
            display: flex;
    
            justify-content: space-between;
    
            align-items: center;
    
            margin-bottom: 20px;
}

        .section-title {
    
            color: #1f2937;
    
            font-size: 1.3rem;
    
            font-weight: 600;
}

        .view-all-btn {
    
            padding: 8px 16px;
    
            border: 1px solid #d1d5db;
    
            color: #6b7280;
    
            background: none;
    
    transition: all 0.2s ease;
    
            border-radius: 8px;
    
            cursor: pointer;
    
            -webkit-transition: all 0.2s ease;
    
            font-size: 0.9rem;
}

        .view-all-btn:hover {
    
            background: #f9fafb;
    
            border-color: #9ca3af;
}

        /* Lista de UsuÃ¡rios */
        .user-list {
    
            display: flex;
    
            flex-direction: column;
    
            gap: 12px;
}

        .user-item {
    
            display: flex;
    
            padding: 12px;
    
    transition: background-color 0.2s ease;
    
            align-items: center;
    
            gap: 12px;
    
            border-radius: 8px;
    
            -webkit-transition: background-color 0.2s ease;
}

        .user-item:hover {
    
            background: #f9fafb;
}

        .user-avatar-small {
    
            display: flex;
    
            width: 40px;
    
            height: 40px;
    
            color: white;
    
            background: linear-gradient(135deg, #1e3c72, #2a5298);
    
            border-radius: 50%;
    
            align-items: center;
    
            justify-content: center;
    
            font-weight: 600;
}

        .user-info-small {
    
            flex: 1;
}

        .user-name {
    
            color: #1f2937;
    
            font-weight: 600;
    
            margin-bottom: 2px;
}

        .user-email {
    
            color: #6b7280;
    
            font-size: 0.85rem;
}

        .user-status {
    
            padding: 4px 8px;
    
            border-radius: 6px;
    
            font-size: 0.75rem;
    
            font-weight: 600;
}

        .user-status.active {
    
            color: #065f46;
    
            background: #d1fae5;
}

        .user-status.inactive {
    
            color: #991b1b;
    
            background: #fee2e2;
}

        /* Alertas do Sistema */
        .alert-list {
    
            display: flex;
    
            flex-direction: column;
    
            gap: 12px;
}

        .alert-item {
    
            display: flex;
    
            padding: 12px;
    
    transition: background-color 0.2s ease;
    
            align-items: center;
    
            gap: 12px;
    
            border-radius: 8px;
    
            border-left: 4px solid;
    
            -webkit-transition: background-color 0.2s ease;
}

        .alert-item:hover {
    
            background: #f9fafb;
}

        .alert-item.critical {
    
            border-left-color: #ef4444;
}

        .alert-item.warning {
    
            border-left-color: #f59e0b;
}

        .alert-item.info {
    
            border-left-color: #3b82f6;
}

        .alert-icon {
    
            font-size: 1.2rem;
}

        .alert-content {
    
            flex: 1;
}

        .alert-title {
    
            color: #1f2937;
    
            font-weight: 600;
    
            margin-bottom: 2px;
}

        .alert-message {
    
            color: #6b7280;
    
            font-size: 0.85rem;
}

        .alert-time {
    
            color: #9ca3af;
    
            font-size: 0.75rem;
}

        /* Responsividade */
        @media (max-width: 768px) {
    
            .container {
                padding: 10px;
}

            .header-admin {
    
                flex-direction: column;
    
                gap: 16px;
    
                text-align: center;
}

            .main-sections {
    
                grid-template-columns: 1fr;
}

            .metrics-grid {
    
                grid-template-columns: 1fr;
}

            .actions-grid {
    
                grid-template-columns: 1fr;
}
        }

        /* AnimaÃ§Ãµes */
        @keyframes fadeIn {
    
    transform: translateY(20px);
    
            from { opacity: 0;
     -webkit-transform: translateY(20px);
}
            to {
    
    transform: translateY(0);
     opacity: 1;
     -webkit-transform: translateY(0);
}
        }

        .fade-in {
    -webkit-animation: fadeIn 0.3s ease-out;
    animation: fadeIn 0.3s ease-out;
}
    
        /* Sidebar Styles */
        .sidebar {
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    -webkit--webkit-backdrop-filter: blur(10px);
    -webkit-transition: left 0.3s ease;
    position: fixed;
    top: 0;
    left: -280px;
    width: 280px;
    height: 100vh;
    background: rgba(255, 255, 255, 0.95);
    transition: left 0.3s ease;
    border-right: 1px solid rgba(255, 255, 255, 0.2);
    z-index: 1000;
    overflow-y: auto;
}

        .sidebar.open {
    
            left: 0;
}

        .sidebar-header {
    
            padding: 20px;
    
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    
            text-align: center;
}

        .sidebar-logo {
    
            font-size: 32px;
    
            margin-bottom: 10px;
}

        .sidebar-title {
    
            color: #1e293b;
    
            font-size: 18px;
    
            font-weight: bold;
}

        .sidebar-user {
    
            padding: 15px 20px;
    
            background: rgba(0, 122, 255, 0.1);
    
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
}

        .user-info {
    
            display: flex;
    
            align-items: center;
    
            gap: 10px;
}

        .user-avatar {
    
            display: flex;
    
            width: 40px;
    
            height: 40px;
    
            color: white;
    
            background: #007AFF;
    
            border-radius: 50%;
    
            align-items: center;
    
            justify-content: center;
    
            font-weight: bold;
}

        .user-details h4 {
    
            color: #1e293b;
    
            font-size: 14px;
    
            margin-bottom: 2px;
}

        .user-details p {
    
            color: #64748b;
    
            font-size: 12px;
}

        .sidebar-nav {
    
            padding: 20px 0;
}

        .nav-section {
    
            margin-bottom: 20px;
}

        .nav-section-title {
    
            padding: 0 20px 10px;
    
            color: #64748b;
    
    transform: uppercase;
    
            font-size: 12px;
    
            font-weight: 600;
    
            text--webkit-transform: uppercase;
    
            letter-spacing: 0.5px;
}

        .nav-item {
    
            display: flex;
    
            padding: 12px 20px;
    
            color: #1e293b;
    
    transition: all 0.2s ease;
    
            align-items: center;
    
            text-decoration: none;
    
            -webkit-transition: all 0.2s ease;
    
            border-left: 3px solid transparent;
}

        .nav-item:hover {
    
            background: rgba(0, 122, 255, 0.1);
    
            border-left-color: #007AFF;
}

        .nav-item.active {
    
            color: #007AFF;
    
            background: rgba(0, 122, 255, 0.15);
    
            border-left-color: #007AFF;
}

        .nav-icon {
    
            width: 20px;
    
            font-size: 18px;
    
            margin-right: 12px;
    
            text-align: center;
}

        .nav-text {
    
            font-size: 14px;
    
            font-weight: 500;
}

        .sidebar-overlay {
    
            position: fixed;
    
            top: 0;
    
            left: 0;
    
            width: 100%;
    
            height: 100%;
    
            background: rgba(0, 0, 0, 0.5);
    
    transition: all 0.3s ease;
    
            z-index: 999;
    
            opacity: 0;
    
            visibility: hidden;
    
            -webkit-transition: all 0.3s ease;
}

        .sidebar-overlay.open {
    
            opacity: 1;
    
            visibility: visible;
}

        .main-content {
    
    transition: margin-left 0.3s ease;
    
            margin-left: 0;
    
            -webkit-transition: margin-left 0.3s ease;
}

        .main-content.sidebar-open {
    
            margin-left: 280px;
}

        .header-actions {
    
            display: flex;
    
            gap: 10px;
}

        .menu-button {
    
            padding: 8px 12px;
    
            border: none;
    
            color: white;
    
            background: #007AFF;
    
    transition: all 0.2s ease;
    
            border-radius: 8px;
    
            font-size: 16px;
    
            cursor: pointer;
    
            -webkit-transition: all 0.2s ease;
}

        .menu-button:hover {
    
            background: #0056CC;
    
    transform: translateY(-1px);
    
            -webkit-transform: translateY(-1px);
}

        .logout-button {
    
            padding: 8px 16px;
    
            border: none;
    
            color: white;
    
            background: #ef4444;
    
    transition: all 0.2s ease;
    
            border-radius: 8px;
    
            font-size: 14px;
    
            cursor: pointer;
    
            -webkit-transition: all 0.2s ease;
}

        .logout-button:hover {
    
            background: #dc2626;
    
    transform: translateY(-1px);
    
            -webkit-transform: translateY(-1px);
}

        /* Responsividade */
        @media (max-width: 768px) {
    
                width: 100%;
    
            .sidebar {
                left: -100%;
}

            .main-content.sidebar-open {
    
                margin-left: 0;
}

            .header-actions {
    
                position: static;
    
                justify-content: center;
    
                margin-top: 15px;
}
        }

        /* Profile Selector Styles */
        .profile-selector {
    
            display: inline-block;
    
            position: relative;
}

        .profile-selector-button {
    -webkit-transition: all 0.2s ease;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    -webkit--webkit-backdrop-filter: blur(10px);
    display: flex;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
    background: rgba(255, 255, 255, 0.2);
    transition: all 0.2s ease;
    border-radius: 20px;
    cursor: pointer;
    align-items: center;
    gap: 8px;
    font-size: 14px;
}

        .profile-selector-button:hover {
    
            background: rgba(255, 255, 255, 0.3);
    
    transform: translateY(-1px);
    
            -webkit-transform: translateY(-1px);
}

        .profile-selector-button .profile-icon {
    
            font-size: 16px;
}

        .profile-selector-button .profile-name {
    
            font-weight: 500;
}

        .profile-selector-button .dropdown-arrow {
    
    transition: transform 0.2s ease;
    
            font-size: 12px;
    
            -webkit-transition: transform 0.2s ease;
}

        .profile-selector-button.open .dropdown-arrow {
    
    transform: rotate(180deg);
    
            -webkit-transform: rotate(180deg);
}

        .profile-dropdown {
    
            position: absolute;
    
            top: 100%;
    
            right: 0;
    
            background: white;
    
    transform: translateY(-10px);
    
    transition: all 0.2s ease;
    
            border-radius: 12px;
    
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    
            min-width: 200px;
    
            z-index: 1000;
    
            opacity: 0;
    
            visibility: hidden;
    
            -webkit-transform: translateY(-10px);
    
            -webkit-transition: all 0.2s ease;
    
            margin-top: 8px;
}

        .profile-dropdown.open {
    
    transform: translateY(0);
    
            opacity: 1;
    
            visibility: visible;
    
            -webkit-transform: translateY(0);
}

        .profile-dropdown-header {
    
            padding: 16px;
    
            border-bottom: 1px solid #e1e5e9;
    
            text-align: center;
}

        .profile-dropdown-header h4 {
    
            margin: 0;
    
            color: #1e293b;
    
            font-size: 14px;
    
            font-weight: 600;
}

        .profile-dropdown-header p {
    
            margin: 4px 0 0 0;
    
            color: #64748b;
    
            font-size: 12px;
}

        .profile-options {
    
            padding: 8px 0;
}

        .profile-option {
    
            display: flex;
    
            padding: 12px 16px;
    
            color: #1e293b;
    
    transition: background 0.2s ease;
    
            align-items: center;
    
            cursor: pointer;
    
            -webkit-transition: background 0.2s ease;
    
            text-decoration: none;
}

        .profile-option:hover {
    
            background: #f8fafc;
}

        .profile-option.active {
    
            color: #007AFF;
    
            background: rgba(0, 122, 255, 0.1);
}

        .profile-option .option-icon {
    
            width: 20px;
    
            font-size: 18px;
    
            margin-right: 12px;
    
            text-align: center;
}

        .profile-option .option-info {
    
            flex: 1;
}

        .profile-option .option-name {
    
            font-weight: 500;
    
            font-size: 14px;
    
            margin-bottom: 2px;
}

        .profile-option .option-description {
    
            color: #64748b;
    
            font-size: 12px;
}

        .profile-option .option-check {
    
            color: #007AFF;
    
            font-size: 16px;
    
            opacity: 0;
}

        .profile-option.active .option-check {
    
            opacity: 1;
}

        .profile-dropdown-footer {
    
            padding: 12px 16px;
    
            border-top: 1px solid #e1e5e9;
    
            text-align: center;
}

        .profile-dropdown-footer button {
    
            padding: 8px 16px;
    
            border: none;
    
            color: white;
    
            background: #007AFF;
    
    transition: background 0.2s ease;
    
            border-radius: 6px;
    
            font-size: 12px;
    
            font-weight: 500;
    
            cursor: pointer;
    
            -webkit-transition: background 0.2s ease;
}

        .profile-dropdown-footer button:hover {
    
            background: #0056CC;
}

        /* Responsividade */
        @media (max-width: 768px) {
    
            .profile-selector-button .profile-name {
                display: none;
}
            
            .profile-dropdown {
    
                right: -50px;
    
                min-width: 180px;
}
        }

        
    
    
        
    
    
        
    
    
    
        
    
