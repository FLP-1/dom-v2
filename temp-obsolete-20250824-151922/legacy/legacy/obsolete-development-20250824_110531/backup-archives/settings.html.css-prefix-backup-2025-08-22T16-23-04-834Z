        /* AnimaÃ§Ãµes */
        .fade-in {
    -webkit-animation: fadeIn 0.5s ease-in;
    animation: fadeIn 0.5s ease-in;
}

        @keyframes fadeIn {
    
    transform: translateY(20px);
    
            from { opacity: 0;
     -webkit-transform: translateY(20px);
}
            to {
    
    transform: translateY(0);
