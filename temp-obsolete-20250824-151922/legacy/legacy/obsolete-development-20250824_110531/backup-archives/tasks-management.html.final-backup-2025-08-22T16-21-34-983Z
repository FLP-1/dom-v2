        <!-- Lista de Tarefas -->
        <div class="tasks-grid fade-in" id="tasksGrid">
            <!-- Tarefas serÃ£o carregadas dinamicamente -->
        </div>

        <!-- Modal Adicionar/Editar Tarefa -->
        <div class="modal" id="taskModal">
            <div class="modal-content">
                <h3 class="modal-title" id="modalTitle">Adicionar Tarefa</h3>
                <form id="taskForm">
                    <div class="form-group">
                        <label class="form-label" for="taskTitle">TÃ­tulo da Tarefa</label>
                        <input id="taskTitle" aria-label="text input" type="text" class="form-input" id="taskTitle" required tabindex="0">
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" for="taskDescription">DescriÃ§Ã£o</label>
                        <textarea class="form-textarea" id="taskDescription" rows="3" tabindex="0"></textarea>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="taskPriority">Prioridade</label>
                            <select class="form-select" id="taskPriority" required tabindex="0">
                                <option value="low">Baixa</option>
                                <option value="medium">MÃ©dia</option>
                                <option value="high">Alta</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label" for="taskAssignee">ResponsÃ¡vel</label>
                            <select class="form-select" id="taskAssignee" required tabindex="0">
                                <option value="">Selecione um responsÃ¡vel</option>
                                <option value="maria">Maria Silva</option>
                                <option value="joao">JoÃ£o Silva</option>
                                <option value="ana">Ana Silva</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="taskDueDate">Data de Vencimento</label>
                            <input id="taskDueDate" aria-label="date input" type="date" class="form-input" id="taskDueDate" required tabindex="0">
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label" for="taskStatus">Status</label>
                            <select class="form-select" id="taskStatus" required tabindex="0">
                                <option value="pending">Pendente</option>
                                <option value="in-progress">Em Andamento</option>
                                <option value="completed">ConcluÃ­da</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="modal-buttons">
                        <button type="button" class="modal-btn cancel" onclick="closeTaskModal()" tabindex="0">Cancelar</button>
                        <button type="submit" class="modal-btn save" tabindex="0">Salvar</button>
                    </div>
                </form>
            </div>
        </div>

        </div>
    </div>

    <!-- Scripts -->
    <script src="js/messages-system.js"></script>`n    <script src="js/components.js"></script>
    <script>
        // Dados das tarefas
        let tasks = JSON.parse(localStorage.getItem('dom_v2_tasks')) || [
            {
    
                id: 1,
                title: 'Limpar a casa',
                description: 'Fazer limpeza geral da casa incluindo quartos, banheiros e cozinha',
                priority: 'high',
                assignee: 'maria',
                dueDate: '2024-01-15',
                status: 'pending',
                createdAt: '2024-01-10'
            ;
},
            {
    
                id: 2,
                title: 'Fazer compras',
                description: 'Comprar mantimentos para a semana',
                priority: 'medium',
                assignee: 'joao',
                dueDate: '2024-01-12',
                status: 'in-progress',
                createdAt: '2024-01-09'
            ;
},
            {
    
                id: 3,
                title: 'Pagar contas',
                description: 'Pagar contas de luz, Ã¡gua e internet',
                priority: 'high',
                assignee: 'maria',
                dueDate: '2024-01-14',
                status: 'completed',
                createdAt: '2024-01-08'
            ;
}
        ];

        let currentFilter = 'all';
        let editingTaskId = null;

        // InicializaÃ§Ã£o da pÃ¡gina
        document.addEventListener('DOMContentLoaded', function() {
    
            // Inicializar sistema de componentes
            const componentManager = new ComponentManager();
    
            componentManager.initPage('Tarefas');
    
            
            // Carregar tarefas
            loadTasks();
    
            updateStats();
    
            
            // Configurar filtros
            setupFilters();
    
            
            // Configurar formulÃ¡rio
            setupForm();
});

        // FunÃ§Ã£o para carregar tarefas
        function loadTasks() {
    
            const tasksGrid = document.getElementById('tasksGrid');
    
            const filteredTasks = filterTasks(tasks, currentFilter);
    
            
            if (filteredTasks.length === 0) {
                tasksGrid.innerHTML = `
                    <div class="empty-state">
                        <h3>Nenhuma tarefa encontrada</h3>
                        <p>${currentFilter === 'all' ? 'Comece adicionando sua primeira tarefa!' : 'NÃ£o hÃ¡ tarefas com este status.';
}</p>
                        ${
    currentFilter === 'all' ? '<button class="add-task-btn" onclick="openAddTaskModal()" tabindex="0">âž• Adicionar Tarefa</button>' : '';
}
                    </div>
                `;
                return;
            }
            
            tasksGrid.innerHTML = filteredTasks.map(task => createTaskCard(task)).join('');
        }

        // FunÃ§Ã£o para filtrar tarefas
        function filterTasks(tasks, filter) {
    
            if (filter === 'all') return tasks;
    
            return tasks.filter(task => task.status === filter);
}

        // FunÃ§Ã£o para criar card de tarefa
        function createTaskCard(task) {
    
            const priorityLabels = {
                high: 'Alta',
                medium: 'MÃ©dia',
                low: 'Baixa'
            ;
};
            
            const assigneeNames = {
    
                maria: 'Maria Silva',
                joao: 'JoÃ£o Silva',
                ana: 'Ana Silva'
            ;
};
            
            const statusLabels = {
    
                pending: 'Pendente',
                'in-progress': 'Em Andamento',
                completed: 'ConcluÃ­da'
            ;
};
            
            const dueDate = new Date(task.dueDate);
            const today = new Date();
            const isOverdue = dueDate < today && task.status !== 'completed';
            
            return `
                <div class="task-card ${
    task.status;
} ${
    isOverdue ? 'overdue' : '';
}" data-task-id="${
    task.id;
}">
                    <div class="task-header">
                        <div>
                            <h3 class="task-title">${
    task.title;
}</h3>
                            <span class="task-priority ${
    task.priority;
}">${
    priorityLabels[task.priority];
}</span>
                        </div>
                    </div>
                    
                    <p class="task-description">${
    task.description;
}</p>
                    
                    <div class="task-meta">
                        <div class="task-date">
                            ðŸ“… ${
    dueDate.toLocaleDateString('pt-BR');
}
                            ${
    isOverdue ? ' âš ï¸ Atrasada' : '';
}
                        </div>
                        <div class="task-assignee">
                            ðŸ‘¤ ${
    assigneeNames[task.assignee];
}
                        </div>
                    </div>
                    
                    <div class="task-actions">
                        <button class="task-btn edit" onclick="editTask(${
    task.id;
})" tabindex="0">âœï¸ Editar</button>
                        ${
    task.status === 'completed' 
                            ? '<button class="task-btn incomplete" onclick="toggleTaskStatus(' + task.id + ')" tabindex="0">â†©ï¸ Desfazer</button>'
                            : '<button class="task-btn complete" onclick="toggleTaskStatus(' + task.id + ')" tabindex="0">âœ… Concluir</button>'
                        ;
}
                        <button class="task-btn delete" onclick="deleteTask(${
    task.id;
})" tabindex="0">ðŸ—‘ï¸ Excluir</button>
                    </div>
                </div>
            `;
        }

        // FunÃ§Ã£o para atualizar estatÃ­sticas
        function updateStats() {
    
            document.getElementById('totalTasks').textContent = tasks.length;
    
            document.getElementById('pendingTasks').textContent = tasks.filter(t => t.status === 'pending').length;
    
            document.getElementById('inProgressTasks').textContent = tasks.filter(t => t.status === 'in-progress').length;
    
            document.getElementById('completedTasks').textContent = tasks.filter(t => t.status === 'completed').length;
}

        // FunÃ§Ã£o para configurar filtros
        function setupFilters() {
    
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    
                    this.classList.add('active');
    
                    currentFilter = this.dataset.filter;
    
                    loadTasks();
});
            });
        }

        // FunÃ§Ã£o para configurar formulÃ¡rio
        function setupForm() {
    
            document.getElementById('taskForm').addEventListener('submit', function(e) {
                e.preventDefault();
    
                saveTask();
});
        }

        // FunÃ§Ã£o para abrir modal
        function openAddTaskModal() {
    
            editingTaskId = null;
    
            document.getElementById('modalTitle').textContent = 'Adicionar Tarefa';
    
            document.getElementById('taskForm').reset();
    
            document.getElementById('taskModal').classList.add('show');
}

        // FunÃ§Ã£o para fechar modal
        function closeTaskModal() {
    
            document.getElementById('taskModal').classList.remove('show');
    
            editingTaskId = null;
}

        // FunÃ§Ã£o para editar tarefa
        function editTask(taskId) {
    
            const task = tasks.find(t => t.id === taskId);
    
            if (!task) return;
    
            
            editingTaskId = taskId;
    
            document.getElementById('modalTitle').textContent = 'Editar Tarefa';
    
            
            document.getElementById('taskTitle').value = task.title;
    
            document.getElementById('taskDescription').value = task.description;
    
            document.getElementById('taskPriority').value = task.priority;
    
            document.getElementById('taskAssignee').value = task.assignee;
    
            document.getElementById('taskDueDate').value = task.dueDate;
    
            document.getElementById('taskStatus').value = task.status;
    
            
            document.getElementById('taskModal').classList.add('show');
}

        // FunÃ§Ã£o para salvar tarefa
        function saveTask() {
    
            const taskData = {
                title: document.getElementById('taskTitle').value,
                description: document.getElementById('taskDescription').value,
                priority: document.getElementById('taskPriority').value,
                assignee: document.getElementById('taskAssignee').value,
                dueDate: document.getElementById('taskDueDate').value,
                status: document.getElementById('taskStatus').value
            ;
};
            
            if (editingTaskId) {
    
                // Editar tarefa existente
                const taskIndex = tasks.findIndex(t => t.id === editingTaskId);
    
                if (taskIndex !== -1) {
                    tasks[taskIndex] = { ...tasks[taskIndex], ...taskData ;
};
                }
            } else {
    
                // Adicionar nova tarefa
                const newTask = {
                    ...taskData,
                    id: Date.now(),
                    createdAt: new Date().toISOString().split('T')[0]
                ;
};
                tasks.push(newTask);
            }
            
            // Salvar no localStorage
            localStorage.setItem('dom_v2_tasks', JSON.stringify(tasks));
            
            // Atualizar interface
            loadTasks();
            updateStats();
            closeTaskModal();
        }

        // FunÃ§Ã£o para alternar status da tarefa
        function toggleTaskStatus(taskId) {
    
            const task = tasks.find(t => t.id === taskId);
    
            if (!task) return;
    
            
            task.status = task.status === 'completed' ? 'pending' : 'completed';
    
            
            localStorage.setItem('dom_v2_tasks', JSON.stringify(tasks));
    
            loadTasks();
    
            updateStats();
}

        // FunÃ§Ã£o para excluir tarefa
        function deleteTask(taskId) {
    
            if (!await messageSystem.confirm('confirm.delete')) return;
    
            
            tasks = tasks.filter(t => t.id !== taskId);
    
            localStorage.setItem('dom_v2_tasks', JSON.stringify(tasks));
    
            loadTasks();
    
            updateStats();
}

        // Fechar modal ao clicar fora
        document.getElementById('taskModal').addEventListener('click', function(e) {
    
            if (e.target === this) {
                closeTaskModal();
}
        });
    </script>
</body>
</html>

