            min-height: 100vh;
}
        
        .container {
    
            margin: 0 auto;
    
            padding: 40px 20px;
    
            max-width: 800px;
}
        
        .header {
    
            padding: 30px;
    
            background: white;
    
            border-radius: 20px;
    
            margin-bottom: 30px;
    
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    
            text-align: center;
}
        
        .logo {
    
            display: flex;
    
            align-items: center;
    
            justify-content: center;
    
            gap: 20px;
    
            margin-bottom: 20px;
}
        
        .logo img {
    
            width: 60px;
    
            height: 60px;
    
            border-radius: 12px;
}
        
        .logo-text {
    
            margin: 0;
    
            color: #007AFF;
    
            font-size: 28px;
    
            font-weight: bold;
}
        
        .title {
    
            margin: 0 0 10px 0;
    
            color: #333;
    
            font-size: 32px;
    
            font-weight: bold;
}
        
        .subtitle {
    
            margin: 0;
    
            color: #666;
    
            font-size: 16px;
}
        
        .content {
    
            padding: 40px;
    
            background: white;
    
            border-radius: 20px;
    
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    
            line-height: 1.6;
}
        
        .section {
    
            margin-bottom: 30px;
}
        
        .section h2 {
    
            color: #007AFF;
    
            font-size: 24px;
    
            margin-bottom: 15px;
    
            border-bottom: 2px solid #f0f0f0;
    
            padding-bottom: 10px;
}
        
        .section h3 {
    
            margin: 25px 0 15px 0;
    
            color: #333;
    
            font-size: 20px;
}
        
        .section p {
    
            margin-bottom: 15px;
    
            text-align: justify;
}
        
        .section ul {
    
            margin-bottom: 15px;
    
            padding-left: 20px;
}
        
        .section li {
    
            margin-bottom: 8px;
}
        
        .back-btn {
    
            display: inline-block;
    
            padding: 12px 24px;
    
            color: white;
    
            background: #007AFF;
    
    transition: all 0.3s ease;
    
            border-radius: 10px;
    
            text-decoration: none;
    
            font-weight: 600;
    
            -webkit-transition: all 0.3s ease;
    
            margin-top: 20px;
}
        
        .back-btn:hover {
    
            background: #0056CC;
    
    transform: translateY(-2px);
    
            -webkit-transform: translateY(-2px);
    
            box-shadow: 0 4px 12px rgba(0, 122, 255, 0.3);
}
        
        .last-updated {
    
            padding: 15px;
    
            border: 1px solid #e1e5e9;
    
            color: #666;
    
            background: #f8f9fa;
    
            border-radius: 10px;
    
            margin-top: 30px;
    
            text-align: center;
    
            font-size: 14px;
}
        
        .lgpd-badge {
    
            display: inline-block;
    
            padding: 5px 10px;
    
            color: white;
    
            background: #28a745;
    
            border-radius: 15px;
    
            font-size: 12px;
    
            font-weight: bold;
    
            margin-left: 10px;
}
        
        @media (max-width: 768px) {
    
            .container {
                padding: 20px 15px;
}
            
            .header, .content {
    
                padding: 20px;
}
            
            .title {
    
                font-size: 24px;
}
            
            .logo-text {
    
                font-size: 20px;
}
        }
