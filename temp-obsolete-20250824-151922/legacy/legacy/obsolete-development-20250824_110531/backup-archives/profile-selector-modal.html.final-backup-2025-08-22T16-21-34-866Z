<!-- Modal Seletor de Perfil -->
<div id="profileSelectorModal" class="modal" class="extracted-style-1">
    <div class="modal-content profile-selector-content">
        <div class="modal-header">
            <h3>Selecione seu Perfil</h3>
            <button onclick="closeProfileSelector()" class="extracted-style-2" tabindex="0">&times;</button>
        </div>
        <div class="modal-body">
            <p class="extracted-style-3">Você possui múltiplos perfis. Selecione qual deseja usar:</p>
            
            <div class="profile-grid" id="profileGrid">
                <!-- Perfis serão carregados dinamicamente -->
            </div>
        </div>
    </div>
</div>

<style>
    .profile-selector-content {
    
        width: 90%;
    
        max-width: 600px;
}

    .profile-grid {
    
        display: grid;
    
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    
        gap: 20px;
    
        margin-top: 20px;
}

    .profile-card {
    
        padding: 20px;
    
        border: 2px solid #e1e5e9;
    
        background: white;
    
    transition: all 0.3s ease;
    
        border-radius: 12px;
    
        text-align: center;
    
        cursor: pointer;
    
        -webkit-transition: all 0.3s ease;
}

    .profile-card:hover {
    
    transform: translateY(-2px);
    
        border-color: #007AFF;
    
        -webkit-transform: translateY(-2px);
    
        box-shadow: 0 4px 12px rgba(0, 122, 255, 0.15);
}

    .profile-card.selected {
    
        background: rgba(0, 122, 255, 0.05);
    
        border-color: #007AFF;
}

    .profile-icon {
    
        font-size: 48px;
    
        margin-bottom: 12px;
}

    .profile-name {
    
        color: #1e293b;
    
        font-size: 18px;
    
        font-weight: 600;
    
        margin-bottom: 8px;
}

    .profile-description {
    
        color: #64748b;
    
        font-size: 14px;
    
        line-height: 1.4;
}

    .profile-actions {
    
        display: flex;
    
        margin-top: 20px;
    
        gap: 12px;
    
        justify-content: center;
}

    .btn-select-profile {
    
        padding: 12px 24px;
    
        border: none;
    
        color: white;
    
        background: #007AFF;
    
    transition: all 0.2s ease;
    
        border-radius: 8px;
    
        font-weight: 600;
    
        cursor: pointer;
    
        -webkit-transition: all 0.2s ease;
}

    .btn-select-profile:hover {
    
        background: #0056CC;
    
    transform: translateY(-1px);
    
        -webkit-transform: translateY(-1px);
}

    .btn-cancel {
    
        padding: 12px 24px;
    
        border: none;
    
        color: white;
    
        background: #6b7280;
    
    transition: all 0.2s ease;
    
        border-radius: 8px;
    
        font-weight: 600;
    
        cursor: pointer;
    
        -webkit-transition: all 0.2s ease;
}

    .btn-cancel:hover {
    
        background: #4b5563;
}
</style>

<script>
    let selectedProfile = null;
    let userProfiles = [];

    function showProfileSelector(profiles) {
    
        userProfiles = profiles;
    
        selectedProfile = null;
    
        
        const modal = document.getElementById('profileSelectorModal');
    
        const profileGrid = document.getElementById('profileGrid');
    
        
        // Limpar grid
        profileGrid.innerHTML = '';
    
        
        // Criar cards de perfil
        profiles.forEach(profile => {
            const profileCard = createProfileCard(profile);
    
            profileGrid.appendChild(profileCard);
});
        
        modal.style.display = 'flex';
    }

    function createProfileCard(profile) {
    
        const card = document.createElement('div');
    
        card.className = 'profile-card';
    
        card.onclick = () => selectProfile(profile);
    
        
        const profileInfo = getProfileInfo(profile);
    
        
        card.innerHTML = `
            <div class="profile-icon">${profileInfo.icon;
}</div>
            <div class="profile-name">${
    profileInfo.name;
}</div>
            <div class="profile-description">${
    profileInfo.description;
}</div>
        `;
        
        return card;
    }

    function getProfileInfo(profile) {
    
        const profiles = {
            'EMPLOYER': {
                icon: '👨‍💼',
                name: 'Empregador',
                description: 'Gerencie funcionários, finanças e controle total do sistema'
            ;
},
            'EMPLOYEE': {
    
                icon: '👷',
                name: 'Funcionário',
                description: 'Acesse suas tarefas, ponto eletrônico e informações pessoais'
            ;
},
            'FAMILY': {
    
                icon: '👨‍👩‍👧‍👦',
                name: 'Familiar',
                description: 'Visualize tarefas domésticas e informações da família'
            ;
},
            'ADMIN': {
    
                icon: '🔧',
                name: 'Administrador',
                description: 'Controle completo do sistema e configurações avançadas'
            ;
}
        };
        
        return profiles[profile] || {
    
            icon: '👤',
            name: 'Usuário',
            description: 'Acesso básico ao sistema'
        ;
};
    }

    function selectProfile(profile) {
    
        // Remover seleção anterior
        document.querySelectorAll('.profile-card').forEach(card => {
            card.classList.remove('selected');
});
        
        // Selecionar novo perfil
        event.target.closest('.profile-card').classList.add('selected');
        selectedProfile = profile;
        
        // Mostrar botão de confirmação
        showConfirmButton();
    }

    function showConfirmButton() {
    
        const actions = document.querySelector('.profile-actions');
    
        if (!actions) {
            const actionsDiv = document.createElement('div');
    
            actionsDiv.className = 'profile-actions';
    
            actionsDiv.innerHTML = `
                <button class="btn-cancel" onclick="closeProfileSelector()" tabindex="0">Cancelar</button>
                <button class="btn-select-profile" onclick="confirmProfileSelection()" tabindex="0">Confirmar Seleção</button>
            `;
    
            document.querySelector('.modal-body').appendChild(actionsDiv);
}
    }

    function confirmProfileSelection() {
    
        if (selectedProfile) {
            // Salvar perfil selecionado
            const userData = JSON.parse(localStorage.getItem('dom_v2_user') || '{;
}');
            userData.selectedProfile = selectedProfile;
            localStorage.setItem('dom_v2_user', JSON.stringify(userData));
            
            // Redirecionar para o dashboard do perfil
            const profileRoutes = {
    
                'EMPLOYER': 'dashboard-employer.html',
                'EMPLOYEE': 'dashboard-employee.html',
                'FAMILY': 'dashboard-family.html',
                'ADMIN': 'dashboard-admin.html'
            ;
};
            
            const route = profileRoutes[selectedProfile] || 'dashboard.html';
            window.location.href = route;
        }
    }

    function closeProfileSelector() {
    
        document.getElementById('profileSelectorModal').style.display = 'none';
}

    // Fechar modal ao clicar fora
    document.addEventListener('click', function(e) {
    
        const modal = document.getElementById('profileSelectorModal');
    
        if (e.target === modal) {
            closeProfileSelector();
}
    });
</script>
