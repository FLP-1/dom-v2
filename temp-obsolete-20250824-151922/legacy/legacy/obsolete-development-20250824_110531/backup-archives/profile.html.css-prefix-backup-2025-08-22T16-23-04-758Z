                pushNotifications: false,
                darkMode: false,
                weeklyReports: true
            ;
};

            // Aplicar preferÃªncias aos toggles
            Object.keys(preferences).forEach(key => {
    
                const toggle = document.getElementById(key);
    
                if (toggle && preferences[key]) {
                    toggle.classList.add('active');
}
            });
        }

        // FunÃ§Ã£o para alternar preferÃªncias
        function togglePreference(preference) {
    
            const toggle = document.getElementById(preference);
    
            toggle.classList.toggle('active');
    
            
            // Salvar preferÃªncia
            const preferences = JSON.parse(localStorage.getItem('dom_v2_preferences')) || {;
};
            preferences[preference] = toggle.classList.contains('active');
            localStorage.setItem('dom_v2_preferences', JSON.stringify(preferences));
        }

        // FunÃ§Ã£o para alternar entre tabs
        function setTab(tabName) {
    
            // Remover classe active de todas as tabs
            document.querySelectorAll('.tab-button').forEach(button => {
                button.classList.remove('active');
});
            document.querySelectorAll('.tab-content').forEach(content => {
    
                content.classList.remove('active');
});

            // Adicionar classe active Ã  tab selecionada
            document.querySelector(`[onclick="setTab('${
    tabName;
}')"]`).classList.add('active');
            document.getElementById(`tab${
    tabName.charAt(0).toUpperCase() + tabName.slice(1);
}`).classList.add('active');
        }

        // FunÃ§Ã£o para abrir modal de ediÃ§Ã£o
        function openEditModal() {
    
            document.getElementById('editModal').classList.add('show');
}

        // FunÃ§Ã£o para fechar modal de ediÃ§Ã£o
        function closeEditModal() {
    
            document.getElementById('editModal').classList.remove('show');
}

        // FunÃ§Ã£o para salvar ediÃ§Ãµes
        document.getElementById('editForm').addEventListener('submit', function(e) {
    
            e.preventDefault();
    
            
            // Simular salvamento
            const user = JSON.parse(localStorage.getItem('dom_v2_user')) || {;
};
            user.name = document.getElementById('editFullName').value;
            user.nickname = document.getElementById('editNickname').value;
            user.email = document.getElementById('editEmail').value;
            user.phone = document.getElementById('editPhone').value;
            user.bio = document.getElementById('editBio').value;
            
            localStorage.setItem('dom_v2_user', JSON.stringify(user));
            
            // Recarregar dados
            loadUserData();
            closeEditModal();
            
            // Mostrar feedback
            showMessage('profile.update.success');
        });

        // FunÃ§Ãµes de seguranÃ§a (simuladas)
        function changePassword() {
    
            showMessage('system.error');
}

        function setup2FA() {
    
            showMessage('system.error');
}

        function manageSessions() {
    
            showMessage('system.error');
}

        // Fechar modal ao clicar fora
        document.getElementById('editModal').addEventListener('click', function(e) {
    
            if (e.target === this) {
                closeEditModal();
}
        });
    </script>
</body>
