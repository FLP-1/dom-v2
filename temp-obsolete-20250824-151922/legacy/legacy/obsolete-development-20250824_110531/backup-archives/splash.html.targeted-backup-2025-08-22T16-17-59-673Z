<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DOM - Carregando...</title>
    <link rel="icon" type="image/png" href="Logo.png">
    <meta name="theme-color" content="#007AFF">
    
    <style>
        body {
    
            display: flex;
    
            margin: 0;
    
            padding: 0;
    
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
    
            min-height: 100vh;
    
            align-items: center;
    
            justify-content: center;
    
            overflow: hidden;
}
        
        .splash-container {
    
            color: white;
    
            text-align: center;
    
            -webkit-animation: fadeIn 1s ease-in;
    
    animation: fadeIn 1s ease-in;
}
        
        .logo {
    
            width: 120px;
    
            height: 120px;
    
            border-radius: 20px;
    
            margin-bottom: 30px;
    
            -webkit-animation: pulse 2s infinite;
    
    animation: pulse 2s infinite;
}
        
        .app-name {
    
            font-size: 48px;
    
            font-weight: bold;
    
            margin-bottom: 10px;
    
            -webkit-animation: slideUp 1s ease-out 0.5s both;
    
    animation: slideUp 1s ease-out 0.5s both;
}
        
        .app-description {
    
            font-size: 18px;
    
            opacity: 0.9;
    
            margin-bottom: 40px;
    
            -webkit-animation: slideUp 1s ease-out 0.7s both;
    
    animation: slideUp 1s ease-out 0.7s both;
}
        
        .loading-spinner {
    
            width: 40px;
    
            height: 40px;
    
            margin: 0 auto 20px;
    
            border: 4px solid rgba(255, 255, 255, 0.3);
    
            border-top: 4px solid white;
    
            border-radius: 50%;
    
            -webkit-animation: spin 1s linear infinite;
    
    animation: spin 1s linear infinite;
}
        
        .loading-text {
    
            font-size: 14px;
    
            opacity: 0.8;
    
            -webkit-animation: fadeIn 1s ease-in 1s both;
    
    animation: fadeIn 1s ease-in 1s both;
}
        
        .progress-bar {
    
            width: 200px;
    
            height: 4px;
    
            margin: 20px auto 0;
    
            background: rgba(255, 255, 255, 0.3);
    
            border-radius: 2px;
    
            overflow: hidden;
}
        
        .progress-fill {
    
            width: 0%;
    
            height: 100%;
    
            background: white;
    
            border-radius: 2px;
    
            -webkit-animation: progress 3s ease-in-out;
    
    animation: progress 3s ease-in-out;
}
        
        @keyframes fadeIn {
    
            from { opacity: 0;
}
            to {
     opacity: 1;
}
        }
        
        @keyframes slideUp {
    
    transform: translateY(30px);
    
            from {
                opacity: 0;
    
                -webkit-transform: translateY(30px);
}
            to {
    
    transform: translateY(0);
    
                opacity: 1;
    
                -webkit-transform: translateY(0);
}
        }
        
        @keyframes pulse {
    
    transform: scale(1);
    
            0%, 100% {
                -webkit-transform: scale(1);
    
                box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
}
            50% {
    
    transform: scale(1.05);
    
                -webkit-transform: scale(1.05);
    
                box-shadow: 0 0 0 20px rgba(255, 255, 255, 0);
}
        }
        
        @keyframes spin {
    
    transform: rotate(0deg);
    
            0% { -webkit-transform: rotate(0deg);
}
            100% {
    
    transform: rotate(360deg);
     -webkit-transform: rotate(360deg);
}
        }
        
        @keyframes progress {
    
            0% { width: 0%;
}
            100% {
     width: 100%;
}
        }
        
        @media (max-width: 480px) {
    
                height: 80px;
    
            .logo {
                width: 80px;
}
            
            .app-name {
    
                font-size: 32px;
}
            
            .app-description {
    
                font-size: 16px;
}
        }
    </style>
</head>
<body>
    <div class="splash-container">
        <img src="Logo.png" alt="DOM Logo" class="logo">
        <h1 class="app-name">DOM</h1>
        <p class="app-description">Sistema de Gestão de Documentos e Orçamentos</p>
        
        <div class="loading-spinner"></div>
        <p class="loading-text">Carregando sistema...</p>
        
        <div class="progress-bar">
            <div class="progress-fill"></div>
        </div>
    </div>

    <script>
        // Verificar se há dados de login salvos
        function checkLoginStatus() {
    
            const token = localStorage.getItem('dom_v2_token');
    
            const user = localStorage.getItem('dom_v2_user');
    
            const loginTime = localStorage.getItem('dom_v2_login_time');
    
            
            if (token && user && loginTime) {
                // Verificar se o login ainda é válido (24 horas)
                const loginDate = new Date(loginTime);
    
                const now = new Date();
    
                const hoursDiff = (now - loginDate) / (1000 * 60 * 60);
    
                
                if (hoursDiff < 24) {
                    // Login válido, verificar se tem múltiplos perfis
                    try {
                        const userData = JSON.parse(user);
    
                        if (userData.profiles && userData.profiles.length > 1) {
                            // Múltiplos perfis, ir para seletor
                            setTimeout(() => {
                                window.location.href = 'profile-selector.html';
}, 3000);
                        } else {
    
                            // Perfil único, ir direto para dashboard
                            setTimeout(() => {
                                window.location.href = 'dashboard.html';
}, 3000);
                        }
                    } catch (e) {
    
                        // Erro ao parsear dados, ir para login
                        setTimeout(() => {
                            window.location.href = 'login-screen.html';
}, 3000);
                    }
                } else {
    
                    // Login expirado, ir para login
                    setTimeout(() => {
                        window.location.href = 'login-screen.html';
}, 3000);
                }
            } else {
    
                // Sem dados de login, ir para login
                setTimeout(() => {
                    window.location.href = 'login-screen.html';
}, 3000);
            }
        }
        
        // Iniciar verificação após carregamento
        document.addEventListener('DOMContentLoaded', function() {
    
            checkLoginStatus();
});
    </script>
</body>
</html>



