    <link rel="stylesheet" href="themes/user-themes.css">
    <style>
        * {
    
            margin: 0;
    
            padding: 0;
    
            box-sizing: border-box;
}

        body {
    
            color: var(--text-primary);
    
            background: linear-gradient(135deg, var(--bg-primary), var(--bg-secondary));
    
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    
            min-height: 100vh;
}

        .container {
    
            margin: 0 auto;
    
            padding: 20px;
    
            max-width: 1400px;
}

        .header {
    
            margin-bottom: 30px;
    
            text-align: center;
}

        .header h1 {
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    font-size: 2.5rem;
    font-weight: bold;
    margin-bottom: 10px;
}

        .header p {
    
            color: var(--text-secondary);
    
            font-size: 1.1rem;
    
            opacity: 0.8;
}

        .stats-grid {
    
            display: grid;
    
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    
            gap: 20px;
    
            margin-bottom: 30px;
}

        .stat-card {
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    -webkit--webkit-backdrop-filter: blur(10px);
    -webkit-transition: transform 0.3s ease, box-shadow 0.3s ease;
    padding: 25px;
    border: 1px solid var(--border-color);
    background: var(--card-bg);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border-radius: 15px;
    text-align: center;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
}

        .stat-card:hover {
    
    transform: translateY(-5px);
    
            -webkit-transform: translateY(-5px);
    
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
}

        .stat-icon {
    
            font-size: 2.5rem;
    
            margin-bottom: 15px;
}

        .stat-value {
    
            color: var(--accent-primary);
    
            font-size: 2rem;
    
            font-weight: bold;
    
            margin-bottom: 8px;
}

        .stat-label {
    
            color: var(--text-secondary);
    
            font-size: 0.9rem;
    
            font-weight: 500;
}

        .main-content {
    
            display: grid;
    
            grid-template-columns: 1fr 1fr;
    
            gap: 30px;
    
            margin-bottom: 30px;
}

        .section {
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    -webkit--webkit-backdrop-filter: blur(10px);
    padding: 25px;
    border: 1px solid var(--border-color);
    background: var(--card-bg);
    border-radius: 15px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
}

        .section-title {
    
            display: flex;
    
            color: var(--text-primary);
    
            font-size: 1.3rem;
    
            font-weight: 600;
    
            margin-bottom: 20px;
    
            align-items: center;
    
            gap: 10px;
}

        .clock-display {
    
            text-align: center;
    
            margin-bottom: 30px;
}

        .current-time {
    
            color: var(--accent-primary);
    
            font-size: 3rem;
    
            font-weight: bold;
    
            margin-bottom: 10px;
    
            font-family: 'Courier New', monospace;
}

        .current-date {
    
            color: var(--text-secondary);
    
            font-size: 1.1rem;
    
            margin-bottom: 20px;
}

        .clock-actions {
    
            display: flex;
    
            gap: 15px;
    
            justify-content: center;
    
            flex-wrap: wrap;
}

        .btn {
    
            display: inline-flex;
    
            padding: 12px 24px;
    
            border: none;
    
    transition: all 0.3s ease;
    
            border-radius: 8px;
    
            font-size: 1rem;
    
            font-weight: 500;
    
            cursor: pointer;
    
            -webkit-transition: all 0.3s ease;
    
            text-decoration: none;
    
            align-items: center;
    
            gap: 8px;
    
            min-width: 120px;
    
            justify-content: center;
}

        .btn-primary {
    
            color: white;
    
            background: var(--accent-primary);
}

        .btn-primary:hover {
    
            background: var(--accent-secondary);
    
    transform: translateY(-2px);
    
            -webkit-transform: translateY(-2px);
}

        .btn-success {
    
            color: white;
    
            background: #10b981;
}

        .btn-success:hover {
    
            background: #059669;
    
    transform: translateY(-2px);
    
            -webkit-transform: translateY(-2px);
}

        .btn-warning {
    
            color: white;
    
            background: #f59e0b;
}

        .btn-warning:hover {
    
            background: #d97706;
    
    transform: translateY(-2px);
    
            -webkit-transform: translateY(-2px);
}

        .btn-danger {
    
            color: white;
    
            background: #dc2626;
}

        .btn-danger:hover {
    
            background: #b91c1c;
    
    transform: translateY(-2px);
    
            -webkit-transform: translateY(-2px);
}

        .btn-secondary {
    
            color: var(--text-primary);
    
            background: var(--bg-secondary);
}

        .btn-secondary:hover {
    
            background: var(--border-color);
    
    transform: translateY(-2px);
    
            -webkit-transform: translateY(-2px);
}

        .employee-list {
    
            max-height: 400px;
    
            overflow-y: auto;
}

        .employee-item {
    
            display: flex;
    
            padding: 15px;
    
    transition: background-color 0.3s ease;
    
            align-items: center;
    
            justify-content: space-between;
    
            border-bottom: 1px solid var(--border-color);
    
            -webkit-transition: background-color 0.3s ease;
}

        .employee-item:hover {
    
            background: var(--bg-secondary);
}

        .employee-item:last-child {
    
            border-bottom: none;
}

        .employee-info {
    
            display: flex;
    
            align-items: center;
    
            gap: 12px;
}

        .employee-avatar {
    
            display: flex;
    
            width: 40px;
    
            height: 40px;
    
            color: white;
    
            background: var(--accent-primary);
    
            border-radius: 50%;
    
            align-items: center;
    
            justify-content: center;
    
            font-weight: bold;
}

        .employee-details h4 {
    
            color: var(--text-primary);
    
            font-size: 1rem;
    
            font-weight: 600;
    
            margin-bottom: 4px;
}

        .employee-details p {
    
            color: var(--text-secondary);
    
            font-size: 0.8rem;
}

        .employee-status {
    
            display: flex;
    
            align-items: center;
    
            gap: 10px;
}

        .status-indicator {
    
            width: 10px;
    
            height: 10px;
    
            border-radius: 50%;
}

        .status-online {
    
            background: #10b981;
}

        .status-offline {
    
            background: #6b7280;
}

        .status-break {
    
            background: #f59e0b;
}

        .status-text {
    
            font-size: 0.8rem;
    
            font-weight: 500;
}

        .status-online .status-text {
    
            color: #10b981;
}

        .status-offline .status-text {
    
            color: #6b7280;
}

        .status-break .status-text {
    
            color: #f59e0b;
}

        .tabs {
    
            display: flex;
    
            border-bottom: 2px solid var(--border-color);
    
            margin-bottom: 20px;
}

        .tab {
    
            padding: 12px 20px;
    
    transition: all 0.3s ease;
    
            cursor: pointer;
    
            border-bottom: 2px solid transparent;
    
            -webkit-transition: all 0.3s ease;
    
            font-weight: 500;
}

        .tab.active {
    
            color: var(--accent-primary);
    
            border-bottom-color: var(--accent-primary);
}

        .tab:hover {
    
            background: var(--bg-secondary);
}

        .tab-content {
    
            display: none;
}

        .tab-content.active {
    
            display: block;
}

        .report-filters {
    
            display: grid;
    
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    
            gap: 15px;
    
            margin-bottom: 20px;
}

        .form-group {
    
            margin-bottom: 15px;
}

        .form-label {
    
            display: block;
    
            color: var(--text-primary);
    
            font-size: 0.9rem;
    
            font-weight: 500;
    
            margin-bottom: 8px;
}

        .form-input, .form-select {
    
            width: 100%;
    
            padding: 10px 12px;
    
            border: 2px solid var(--border-color);
    
            color: var(--text-primary);
    
            background: var(--bg-primary);
    
    transition: border-color 0.3s ease;
    
            border-radius: 8px;
    
            font-size: 0.9rem;
    
            -webkit-transition: border-color 0.3s ease;
}

        .form-input:focus, .form-select:focus {
    
            outline: none;
    
            border-color: var(--accent-primary);
}

        .report-table {
    
            width: 100%;
    
            border-collapse: collapse;
    
            margin-top: 20px;
}

        .report-table th,
        .report-table td {
    
            padding: 12px;
    
            text-align: left;
    
            border-bottom: 1px solid var(--border-color);
}

        .report-table th {
    
            color: var(--text-primary);
    
            background: var(--bg-secondary);
    
            font-weight: 600;
}

        .report-table tr:hover {
    
            background: var(--bg-secondary);
}

        .productivity-chart {
    
            display: flex;
    
            height: 300px;
    
            color: var(--text-secondary);
    
            background: var(--bg-secondary);
    
            border-radius: 8px;
    
            align-items: center;
    
            justify-content: center;
    
            font-size: 1.1rem;
    
            margin-bottom: 20px;
}

        .shift-management {
    
            display: grid;
    
            gap: 15px;
}

        .shift-card {
    
            padding: 15px;
    
            border: 1px solid var(--border-color);
    
            background: var(--bg-secondary);
    
            border-radius: 8px;
}

        .shift-header {
    
            display: flex;
    
            justify-content: space-between;
    
            align-items: center;
    
            margin-bottom: 10px;
}

        .shift-name {
    
            color: var(--text-primary);
    
            font-weight: 600;
}

        .shift-time {
    
            color: var(--text-secondary);
    
            font-size: 0.9rem;
}

        .shift-employees {
    
            display: flex;
    
            flex-wrap: wrap;
    
            gap: 8px;
}

        .shift-employee {
    
            padding: 4px 8px;
    
            color: white;
    
            background: var(--accent-primary);
    
            border-radius: 12px;
    
            font-size: 0.8rem;
}

        .settings-grid {
    
            display: grid;
    
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    
            gap: 20px;
}

        .setting-card {
    
            padding: 20px;
    
            border: 1px solid var(--border-color);
    
            background: var(--bg-secondary);
    
            border-radius: 8px;
}

        .setting-title {
    
            color: var(--text-primary);
    
            font-weight: 600;
    
            margin-bottom: 15px;
}

        .setting-item {
    
            display: flex;
    
            padding: 10px 0;
    
            justify-content: space-between;
    
            align-items: center;
    
            border-bottom: 1px solid var(--border-color);
}

        .setting-item:last-child {
    
            border-bottom: none;
}

        .setting-label {
    
            color: var(--text-primary);
    
            font-size: 0.9rem;
}

        .toggle-switch {
    
            position: relative;
    
            width: 50px;
    
            height: 24px;
    
            background: var(--border-color);
    
    transition: background 0.3s ease;
    
            border-radius: 12px;
    
            cursor: pointer;
    
            -webkit-transition: background 0.3s ease;
}

        .toggle-switch.active {
    
            background: var(--accent-primary);
}

        .toggle-switch::after {
    
            position: absolute;
    
            top: 2px;
    
            left: 2px;
    
            width: 20px;
    
            height: 20px;
    
            background: white;
    
    transition: transform 0.3s ease;
    
            content: '';
    
            border-radius: 50%;
    
            -webkit-transition: transform 0.3s ease;
}

        .toggle-switch.active::after {
    
    transform: translateX(26px);
    
            -webkit-transform: translateX(26px);
}

        .loading {
    
            display: none;
    
            padding: 20px;
    
            text-align: center;
}

        .spinner {
    -webkit-animation: spin 1s linear infinite;
    animation: spin 1s linear infinite;
    width: 30px;
    height: 30px;
    margin: 0 auto 10px;
    border: 3px solid var(--border-color);
    border-top: 3px solid var(--accent-primary);
    border-radius: 50%;
}

        @keyframes spin {
    
    transform: rotate(0deg);
    
            0% { -webkit-transform: rotate(0deg);
}
            100% {
    
    transform: rotate(360deg);
     -webkit-transform: rotate(360deg);
}
        }

        @media (max-width: 768px) {
    
            .container {
                padding: 15px;
}

            .header h1 {
    
                font-size: 2rem;
}

            .main-content {
    
                grid-template-columns: 1fr;
    
                gap: 20px;
}

            .stats-grid {
    
                grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    
                gap: 15px;
}

            .current-time {
    
                font-size: 2rem;
}

            .clock-actions {
    
                flex-direction: column;
    
                align-items: center;
}

            .btn {
    
                width: 100%;
    
                max-width: 200px;
}

            .tabs {
    
                flex-wrap: wrap;
}

            .report-filters {
    
                grid-template-columns: 1fr;
}
        }
    
        /* Sidebar Styles */
        .sidebar {
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    -webkit--webkit-backdrop-filter: blur(10px);
    -webkit-transition: left 0.3s ease;
    position: fixed;
    top: 0;
    left: -280px;
    width: 280px;
    height: 100vh;
    background: rgba(255, 255, 255, 0.95);
    transition: left 0.3s ease;
    border-right: 1px solid rgba(255, 255, 255, 0.2);
    z-index: 1000;
    overflow-y: auto;
}

        .sidebar.open {
    
            left: 0;
}

        .sidebar-header {
    
            padding: 20px;
    
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    
            text-align: center;
}

        .sidebar-logo {
    
            font-size: 32px;
    
            margin-bottom: 10px;
}

        .sidebar-title {
    
            color: #1e293b;
    
            font-size: 18px;
    
            font-weight: bold;
}

        .sidebar-user {
    
            padding: 15px 20px;
    
            background: rgba(0, 122, 255, 0.1);
    
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
}

        .user-info {
    
            display: flex;
    
            align-items: center;
    
            gap: 10px;
}

        .user-avatar {
    
            display: flex;
    
            width: 40px;
    
            height: 40px;
    
            color: white;
    
            background: #007AFF;
    
            border-radius: 50%;
    
            align-items: center;
    
            justify-content: center;
    
            font-weight: bold;
}

        .user-details h4 {
    
            color: #1e293b;
    
            font-size: 14px;
    
            margin-bottom: 2px;
}

        .user-details p {
    
            color: #64748b;
    
            font-size: 12px;
}

        .sidebar-nav {
    
            padding: 20px 0;
}

        .nav-section {
    
            margin-bottom: 20px;
}

        .nav-section-title {
    
            padding: 0 20px 10px;
    
            color: #64748b;
    
    transform: uppercase;
    
            font-size: 12px;
    
            font-weight: 600;
    
            text--webkit-transform: uppercase;
    
            letter-spacing: 0.5px;
}

        .nav-item {
    
            display: flex;
    
            padding: 12px 20px;
    
            color: #1e293b;
    
    transition: all 0.2s ease;
    
            align-items: center;
    
            text-decoration: none;
    
            -webkit-transition: all 0.2s ease;
    
            border-left: 3px solid transparent;
}

        .nav-item:hover {
    
            background: rgba(0, 122, 255, 0.1);
    
            border-left-color: #007AFF;
}

        .nav-item.active {
    
            color: #007AFF;
    
            background: rgba(0, 122, 255, 0.15);
    
            border-left-color: #007AFF;
}

        .nav-icon {
    
            width: 20px;
    
            font-size: 18px;
    
            margin-right: 12px;
    
            text-align: center;
}

        .nav-text {
    
            font-size: 14px;
    
            font-weight: 500;
}

        .sidebar-overlay {
    
            position: fixed;
    
            top: 0;
    
            left: 0;
    
            width: 100%;
    
            height: 100%;
    
            background: rgba(0, 0, 0, 0.5);
    
    transition: all 0.3s ease;
    
            z-index: 999;
    
            opacity: 0;
    
            visibility: hidden;
    
            -webkit-transition: all 0.3s ease;
}

        .sidebar-overlay.open {
    
            opacity: 1;
    
            visibility: visible;
}

        .main-content {
    
    transition: margin-left 0.3s ease;
    
            margin-left: 0;
    
            -webkit-transition: margin-left 0.3s ease;
}

        .main-content.sidebar-open {
    
            margin-left: 280px;
}

        .header-actions {
    
            display: flex;
    
            gap: 10px;
}

        .menu-button {
    
            padding: 8px 12px;
    
            border: none;
    
            color: white;
    
            background: #007AFF;
    
    transition: all 0.2s ease;
    
            border-radius: 8px;
    
            font-size: 16px;
    
            cursor: pointer;
    
            -webkit-transition: all 0.2s ease;
}

        .menu-button:hover {
    
            background: #0056CC;
    
    transform: translateY(-1px);
    
            -webkit-transform: translateY(-1px);
}

        .logout-button {
    
            padding: 8px 16px;
    
            border: none;
    
            color: white;
    
            background: #ef4444;
    
    transition: all 0.2s ease;
    
            border-radius: 8px;
    
            font-size: 14px;
    
            cursor: pointer;
    
            -webkit-transition: all 0.2s ease;
}

        .logout-button:hover {
    
            background: #dc2626;
    
    transform: translateY(-1px);
    
            -webkit-transform: translateY(-1px);
}

        /* Responsividade */
        @media (max-width: 768px) {
    
                width: 100%;
    
            .sidebar {
                left: -100%;
}

            .main-content.sidebar-open {
    
                margin-left: 0;
}

            .header-actions {
    
                position: static;
    
                justify-content: center;
    
                margin-top: 15px;
}
        }

        /* Profile Selector Styles */
        .profile-selector {
    
            display: inline-block;
    
            position: relative;
}

        .profile-selector-button {
    -webkit-transition: all 0.2s ease;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    -webkit--webkit-backdrop-filter: blur(10px);
    display: flex;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
    background: rgba(255, 255, 255, 0.2);
    transition: all 0.2s ease;
    border-radius: 20px;
    cursor: pointer;
    align-items: center;
    gap: 8px;
    font-size: 14px;
}

        .profile-selector-button:hover {
    
            background: rgba(255, 255, 255, 0.3);
    
    transform: translateY(-1px);
    
            -webkit-transform: translateY(-1px);
}

        .profile-selector-button .profile-icon {
    
            font-size: 16px;
}

        .profile-selector-button .profile-name {
    
            font-weight: 500;
}

        .profile-selector-button .dropdown-arrow {
    
    transition: transform 0.2s ease;
    
            font-size: 12px;
    
            -webkit-transition: transform 0.2s ease;
}

        .profile-selector-button.open .dropdown-arrow {
    
    transform: rotate(180deg);
    
            -webkit-transform: rotate(180deg);
}

        .profile-dropdown {
    
            position: absolute;
    
            top: 100%;
    
            right: 0;
    
            background: white;
    
    transform: translateY(-10px);
    
    transition: all 0.2s ease;
    
            border-radius: 12px;
    
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    
            min-width: 200px;
    
            z-index: 1000;
    
            opacity: 0;
    
            visibility: hidden;
    
            -webkit-transform: translateY(-10px);
    
            -webkit-transition: all 0.2s ease;
    
            margin-top: 8px;
}

        .profile-dropdown.open {
    
    transform: translateY(0);
    
            opacity: 1;
    
            visibility: visible;
    
            -webkit-transform: translateY(0);
}

        .profile-dropdown-header {
    
            padding: 16px;
    
            border-bottom: 1px solid #e1e5e9;
    
            text-align: center;
}

        .profile-dropdown-header h4 {
    
            margin: 0;
    
            color: #1e293b;
    
            font-size: 14px;
    
            font-weight: 600;
}

        .profile-dropdown-header p {
    
            margin: 4px 0 0 0;
    
            color: #64748b;
    
            font-size: 12px;
}

        .profile-options {
    
            padding: 8px 0;
}

        .profile-option {
    
            display: flex;
    
            padding: 12px 16px;
    
            color: #1e293b;
    
    transition: background 0.2s ease;
    
            align-items: center;
    
            cursor: pointer;
    
            -webkit-transition: background 0.2s ease;
    
            text-decoration: none;
}

        .profile-option:hover {
    
            background: #f8fafc;
}

        .profile-option.active {
    
            color: #007AFF;
    
            background: rgba(0, 122, 255, 0.1);
}

        .profile-option .option-icon {
    
            width: 20px;
    
            font-size: 18px;
    
            margin-right: 12px;
    
            text-align: center;
}

        .profile-option .option-info {
    
            flex: 1;
}

        .profile-option .option-name {
    
            font-weight: 500;
    
            font-size: 14px;
    
