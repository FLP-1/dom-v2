    <script>
        // ConfiguraÃ§Ã£o da API
        const API_BASE_URL = 'http://localhost:3001/api';
        
        // Estado da aplicaÃ§Ã£o
        let timeEntries = [];
        let isClockedIn = false;
        let lastEntry = null;
        let currentTime = new Date();

        // FunÃ§Ãµes de API
        async function fetchTimeEntries() {
    
            try {
                const response = await fetch(`${API_BASE_URL;
}/timeclock`);
                const data = await response.json();
                return data.success ? data.timeEntries : [];
            } catch (error) {
    
                console.error('Erro ao buscar registros:', error);
    
                return [];
}
        }

        async function createTimeEntry(entryData) {
    
            try {
                const response = await fetch(`${API_BASE_URL;
}/timeclock`, {
    
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' ;
},
                    body: JSON.stringify(entryData)
                });
                return await response.json();
            } catch (error) {
    
                console.error('Erro ao criar registro:', error);
    
                return { success: false, error: 'Erro de conexÃ£o' ;
};
            }
        }

        // FunÃ§Ãµes utilitÃ¡rias
        function formatTime(date) {
    
            return date.toLocaleTimeString('pt-BR', {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            ;
});
        }

        function formatDate(date) {
    
            return date.toLocaleDateString('pt-BR', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric'
            ;
});
        }

        function calculateWorkHours(entry) {
    
            if (!entry.exit_time) return 'Em andamento';
    
            
            const entryTime = new Date(entry.entry_time);
    
            const exitTime = new Date(entry.exit_time);
    
            const diffMs = exitTime.getTime() - entryTime.getTime();
    
            const diffHours = diffMs / (1000 * 60 * 60);
    
            
            const hours = Math.floor(diffHours);
    
            const minutes = Math.floor((diffHours - hours) * 60);
    
            
            return `${hours;
}h ${
    minutes;
}min`;
        }

        // Atualizar relÃ³gio
        function updateClock() {
    
            currentTime = new Date();
    
            document.getElementById('currentTime').textContent = formatTime(currentTime);
    
            document.getElementById('currentDate').textContent = formatDate(currentTime);
}

        // Atualizar estado do botÃ£o
        function updateClockButton() {
    
            const button = document.getElementById('clockButton');
    
            const status = document.getElementById('status');
    
            
            if (isClockedIn) {
                button.textContent = 'ðŸ• Registrar SaÃ­da';
    
                button.classList.add('clocked-out');
    
                status.textContent = 'ðŸŸ¢ VocÃª estÃ¡ trabalhando';
    
                status.classList.remove('clocked-out');
} else {
    
                button.textContent = 'ðŸ• Registrar Entrada';
    
                button.classList.remove('clocked-out');
    
                status.textContent = 'ðŸ”´ VocÃª nÃ£o estÃ¡ no trabalho';
    
                status.classList.add('clocked-out');
}
        }

        // Renderizar resumo de hoje
        function renderTodaySummary() {
    
            const container = document.getElementById('todaySummary');
    
            const todayEntries = timeEntries.filter(entry => 
                formatDate(new Date(entry.entry_time)) === formatDate(currentTime)
            );
    

            if (todayEntries.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon">ðŸ“…</div>
                        <div class="empty-title">Nenhum registro hoje</div>
                    </div>
                `;
    
                return;
}

            container.innerHTML = todayEntries.map(entry => `
                <div class="entry-item">
                    <div class="entry-info">
                        <div class="entry-type">${
    entry.type === 'entry' ? 'Entrada' : 'SaÃ­da';
}</div>
                        <div class="entry-time">
                            ${
    formatTime(new Date(entry.entry_time));
}
                            ${
    entry.exit_time ? ` - ${formatTime(new Date(entry.exit_time));
}` : ''}
                        </div>
                    </div>
                    <div class="entry-hours">${
    calculateWorkHours(entry);
}</div>
                </div>
            `).join('');
        }

        // Renderizar registros recentes
        function renderRecentEntries() {
    
            const container = document.getElementById('recentEntries');
    
            
            if (timeEntries.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon">â°</div>
                        <div class="empty-title">Nenhum registro encontrado</div>
                        <div class="empty-subtitle">FaÃ§a seu primeiro registro de ponto</div>
                    </div>
                `;
    
                return;
}

            const recentEntries = timeEntries.slice(-10).reverse();
            container.innerHTML = recentEntries.map(entry => `
                <div class="entry-row">
                    <div class="entry-icon ${
    entry.type === 'entry' ? 'entry' : 'exit';
}">
                        ðŸ•
                    </div>
                    <div class="entry-details">
                        <div class="entry-title">${
    entry.type === 'entry' ? 'Entrada' : 'SaÃ­da';
}</div>
                        <div class="entry-date">${
    formatDate(new Date(entry.entry_time));
}</div>
                        <div class="entry-times">
                            <span>Entrada: ${
    formatTime(new Date(entry.entry_time));
}</span>
                            ${
    entry.exit_time ? `<span>SaÃ­da: ${formatTime(new Date(entry.exit_time));
}</span>` : ''}
                            <span class="entry-duration">${
    calculateWorkHours(entry);
}</span>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Handlers de eventos
        async function handleClockInOut() {
    
            if (isClockedIn) {
                await handleClockOut();
} else {
    
                await handleClockIn();
}
        }

        async function handleClockIn() {
    
            try {
                const result = await createTimeEntry({
                    type: 'entry',
                    entry_time: new Date().toISOString(),
                    exit_time: null,
                    notes: 'Entrada registrada'
                ;
});

                if (result.success) {
    
                    showMessage('timeclock.entry.success');
    
                    await loadTimeEntries();
} else {
    
                    showMessage('timeclock.entry.error', {
                        customText: 'Erro ao registrar entrada: ' + (result.error || 'Erro desconhecido')
                    ;
});
                }
            } catch (error) {
    
                console.error('Erro ao registrar entrada:', error);
    
                showMessage('timeclock.entry.error');
}
        }

        async function handleClockOut() {
    
            try {
                if (lastEntry) {
                    const result = await createTimeEntry({
                        type: 'exit',
                        entry_time: lastEntry.entry_time,
                        exit_time: new Date().toISOString(),
                        notes: 'SaÃ­da registrada'
                    ;
});

                    if (result.success) {
    
                        showMessage('timeclock.exit.success');
    
                        await loadTimeEntries();
} else {
    
                        showMessage('timeclock.exit.error', {
                            customText: 'Erro ao registrar saÃ­da: ' + (result.error || 'Erro desconhecido')
                        ;
});
                    }
                }
            } catch (error) {
    
                console.error('Erro ao registrar saÃ­da:', error);
    
                showMessage('timeclock.exit.error');
}
        }

        // Carregar dados
        async function loadTimeEntries() {
    
            try {
                timeEntries = await fetchTimeEntries();
    
                
                if (timeEntries.length > 0) {
                    lastEntry = timeEntries[timeEntries.length - 1];
    
                    isClockedIn = lastEntry.type === 'entry' && !lastEntry.exit_time;
} else {
    
                    isClockedIn = false;
    
                    lastEntry = null;
}

                updateClockButton();
                renderTodaySummary();
                renderRecentEntries();
            } catch (error) {
    
                console.error('Erro ao carregar registros:', error);
    
                document.getElementById('todaySummary').innerHTML = `
                    <div class="error">Erro ao carregar registros: ${error.message;
}</div>
                `;
                document.getElementById('recentEntries').innerHTML = `
                    <div class="error">Erro ao carregar registros: ${
    error.message;
}</div>
                `;
            }
        }

        // InicializaÃ§Ã£o
        document.addEventListener('DOMContentLoaded', function() {
    
            // Configurar relÃ³gio
            updateClock();
    
            setInterval(updateClock, 1000);
    

            // Configurar botÃ£o
            document.getElementById('clockButton').addEventListener('click', handleClockInOut);
    

            // Carregar dados
            loadTimeEntries();
});
    </script
