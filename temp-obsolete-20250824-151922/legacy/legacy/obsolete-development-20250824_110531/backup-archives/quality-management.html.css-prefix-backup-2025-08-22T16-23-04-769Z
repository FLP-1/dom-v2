<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Qualidade e Inspeção - DOM v2</title>
    <style>
        * {
    
            margin: 0;
    
            padding: 0;
    
            box-sizing: border-box;
}

        body {
    
            color: #333;
    
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    
            min-height: 100vh;
}

        .container {
    
            margin: 0 auto;
    
            padding: 20px;
    
            max-width: 1400px;
}

        .header {
    
            color: white;
    
            text-align: center;
    
            margin-bottom: 30px;
}

        .header h1 {
    
            font-size: 2.5rem;
    
            margin-bottom: 10px;
    
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}

        .stats-grid {
    
            display: grid;
    
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    
            gap: 20px;
    
            margin-bottom: 30px;
}

        .stat-card {
    
            padding: 25px;
    
            background: rgba(255, 255, 255, 0.95);
    
            border-radius: 15px;
    
            text-align: center;
    
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
}

        .stat-value {
    
            color: #667eea;
    
            font-size: 2.5rem;
    
            font-weight: bold;
    
            margin-bottom: 10px;
}

        .tabs {
    
            display: flex;
    
            padding: 5px;
    
            background: rgba(255, 255, 255, 0.95);
    
            border-radius: 15px;
    
            margin-bottom: 30px;
}

        .tab {
    
            padding: 15px 20px;
    
            border: none;
    
            color: #666;
    
            background: transparent;
    
    transition: all 0.3s ease;
    
            flex: 1;
    
            font-size: 1rem;
    
            cursor: pointer;
    
            border-radius: 10px;
    
            -webkit-transition: all 0.3s ease;
}

        .tab.active {
    
            color: white;
    
            background: #667eea;
}

        .tab-content {
    
            display: none;
    
            padding: 30px;
    
            background: rgba(255, 255, 255, 0.95);
    
            border-radius: 15px;
}

        .tab-content.active {
    
            display: block;
}

        .btn {
    
            margin: 5px;
    
            padding: 12px 24px;
    
            border: none;
    
            color: white;
    
            background: #667eea;
    
            border-radius: 8px;
    
            font-size: 0.9rem;
    
            cursor: pointer;
}

        .btn:hover {
    
            background: #5a6fd8;
}

        .message {
    
            padding: 15px;
    
            border-radius: 8px;
    
            margin-bottom: 20px;
}

        .success {
    
            border: 1px solid #c3e6cb;
    
            color: #155724;
    
            background: #d4edda;
}

        .error {
    
            border: 1px solid #f5c6cb;
    
            color: #721c24;
    
            background: #f8d7da;
}
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🔍 Sistema de Qualidade e Inspeção</h1>
            <p>Controle de qualidade, inspeções e padrões de excelência</p>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-value">0</div>
                <div class="stat-label">Verificações</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">0</div>
                <div class="stat-label">Concluídas</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">0</div>
                <div class="stat-label">Pontuação Média</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">0</div>
                <div class="stat-label">Templates</div>
            </div>
        </div>

        <div class="tabs">
            <button class="tab active" onclick="showTab('checks')" tabindex="0">🔍 Verificações</button>
            <button class="tab" onclick="showTab('templates')" tabindex="0">📋 Templates</button>
            <button class="tab" onclick="showTab('reports')" tabindex="0">📊 Relatórios</button>
        </div>

        <div id="checks-tab" class="tab-content active">
            <h2>Verificações de Qualidade</h2>
            <button class="btn" onclick="testAPI()" tabindex="0">Testar API</button>
            <div id="checks-content">
                <p>Sistema de verificações de qualidade implementado com sucesso!</p>
            </div>
        </div>

        <div id="templates-tab" class="tab-content">
            <h2>Templates de Qualidade</h2>
            <div id="templates-content">
                <p>Sistema de templates de qualidade implementado com sucesso!</p>
            </div>
        </div>

        <div id="reports-tab" class="tab-content">
            <h2>Relatórios de Qualidade</h2>
            <div id="reports-content">
                <p>Sistema de relatórios de qualidade implementado com sucesso!</p>
            </div>
        </div>
    </div>

    <script>
        function showTab(tabName) {
    
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
});
            document.querySelectorAll('.tab').forEach(tab => {
    
                tab.classList.remove('active');
});

            document.getElementById(tabName + '-tab').classList.add('active');
            event.target.classList.add('active');
        }

        function testAPI() {
    
            fetch('/api/quality/checks')
                .then(response => response.json())
                .then(data => {
                    showMessage('API funcionando: ' + JSON.stringify(data), 'success');
})
                .catch(error => {
    
                    showMessage('Erro na API: ' + error.message, 'error');
});
        }

        function showMessage(message, type) {
    
            const messageDiv = document.createElement('div');
    
            messageDiv.className = `message ${type;
}`;
            messageDiv.textContent = message;
            
            const container = document.querySelector('.container');
            container.insertBefore(messageDiv, container.firstChild);
            
            setTimeout(() => {
    
                messageDiv.remove();
}, 5000);
        }
    </script>
</body>
</html>
