<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DOM v2 - Gestão de Tarefas</title>
    <style>
        * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

        body {
    color: #333;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    min-height: 100vh;
}

        .container {
    margin: 0 auto;
    padding: 20px;
    max-width: 1400px;
}

        .header {
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    -webkit--webkit-backdrop-filter: blur(10px);
    padding: 20px;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 15px;
    margin-bottom: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
}

        .header h1 {
    display: flex;
    color: #4a5568;
    margin-bottom: 10px;
    align-items: center;
    gap: 10px;
}

        .header .icon {
    color: #667eea;
    font-size: 2em;
}

        .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
    margin-bottom: 20px;
}

        .stat-card {
    -webkit-transition: transform 0.3s ease;
    padding: 20px;
    background: rgba(255, 255, 255, 0.9);
    transition: transform 0.3s ease;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
}

        .stat-card:hover {
    -webkit-transform: translateY(-5px);
    transform: translateY(-5px);
}

        .stat-number {
    color: #667eea;
    font-size: 2em;
    font-weight: bold;
    margin-bottom: 5px;
}

        .stat-label {
    color: #718096;
    font-size: 0.9em;
}

        .main-content {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 20px;
}

        .tasks-section {
    padding: 20px;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 15px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
}

        .tasks-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

        .btn {
    -webkit-transition: all 0.3s ease;
    display: inline-block;
    padding: 12px 24px;
    border: none;
    color: white;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    transition: all 0.3s ease;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
    text-decoration: none;
}

        .btn:hover {
    -webkit-transform: translateY(-2px);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
}

        .btn-secondary {
    background: linear-gradient(135deg, #718096 0%, #4a5568 100%);
}

        .btn-success {
    background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
}

        .btn-warning {
    background: linear-gradient(135deg, #ed8936 0%, #dd6b20 100%);
}

        .btn-danger {
    background: linear-gradient(135deg, #f56565 0%, #e53e3e 100%);
}

        .filters {
    display: flex;
    gap: 15px;
    margin-bottom: 20px;
    flex-wrap: wrap;
}

        .filter-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

        .filter-group label {
    color: #718096;
    font-size: 0.9em;
    font-weight: 500;
}

        .filter-group select,
        .filter-group input {
    -webkit-transition: border-color 0.3s ease;
    padding: 8px 12px;
    border: 2px solid #e2e8f0;
    transition: border-color 0.3s ease;
    border-radius: 6px;
    font-size: 14px;
}

        .filter-group select:focus,
        .filter-group input:focus {
    outline: none;
    border-color: #667eea;
}

        .tasks-list {
    max-height: 600px;
    overflow-y: auto;
}

        .task-item {
    -webkit-transition: all 0.3s ease;
    padding: 15px;
    background: white;
    transition: all 0.3s ease;
    border-radius: 10px;
    margin-bottom: 15px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    border-left: 4px solid #e2e8f0;
}

        .task-item:hover {
    -webkit-transform: translateX(5px);
    transform: translateX(5px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
}

        .task-item.high-priority {
    border-left-color: #f56565;
}

        .task-item.medium-priority {
    border-left-color: #ed8936;
}

        .task-item.low-priority {
    border-left-color: #48bb78;
}

        .task-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 10px;
}

        .task-title {
    color: #2d3748;
    font-weight: 600;
    font-size: 1.1em;
}

        .task-status {
    padding: 4px 12px;
    transform: uppercase;
    border-radius: 20px;
    font-size: 0.8em;
    font-weight: 500;
    text--webkit-transform: uppercase;
}

        .status-pending {
    color: #c53030;
    background: #fed7d7;
}

        .status-in-progress {
    color: #d69e2e;
    background: #fef5e7;
}

        .status-completed {
    color: #2f855a;
    background: #c6f6d5;
}

        .status-paused {
    color: #4a5568;
    background: #e2e8f0;
}

        .task-description {
    color: #718096;
    margin-bottom: 10px;
    line-height: 1.5;
}

        .task-meta {
    display: flex;
    color: #a0aec0;
    justify-content: space-between;
    align-items: center;
    font-size: 0.9em;
}

        .task-priority {
    display: flex;
    align-items: center;
    gap: 5px;
}

        .priority-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
}

        .priority-high {
    background: #f56565;
}

        .priority-medium {
    background: #ed8936;
}

        .priority-low {
    background: #48bb78;
}

        .task-actions {
    display: flex;
    gap: 8px;
    margin-top: 10px;
}

        .btn-small {
    padding: 6px 12px;
    font-size: 12px;
}

        .sidebar {
    height: fit-content;
    padding: 20px;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 15px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
}

        .sidebar h3 {
    display: flex;
    color: #4a5568;
    margin-bottom: 15px;
    align-items: center;
    gap: 8px;
}

        .form-group {
    margin-bottom: 15px;
}

        .form-group label {
    display: block;
    color: #718096;
    margin-bottom: 5px;
    font-weight: 500;
}

        .form-group input,
        .form-group select,
        .form-group textarea {
    -webkit-transition: border-color 0.3s ease;
    width: 100%;
    padding: 10px;
    border: 2px solid #e2e8f0;
    transition: border-color 0.3s ease;
    border-radius: 6px;
    font-size: 14px;
}

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
    outline: none;
    border-color: #667eea;
}

        .form-group textarea {
    resize: vertical;
    min-height: 80px;
}

        .modal {
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
    -webkit--webkit-backdrop-filter: blur(5px);
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    background-color: rgba(0, 0, 0, 0.5);
}

        .modal-content {
    width: 90%;
    margin: 5% auto;
    padding: 30px;
    background: white;
    border-radius: 15px;
    max-width: 600px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
}

        .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

        .modal-header h2 {
    color: #4a5568;
}

        .close {
    -webkit-transition: color 0.3s ease;
    color: #a0aec0;
    transition: color 0.3s ease;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
}

        .close:hover {
    color: #4a5568;
}

        .loading {
    padding: 40px;
    color: #718096;
    text-align: center;
}

        .error {
    padding: 15px;
    color: #c53030;
    background: #fed7d7;
    border-radius: 8px;
    margin-bottom: 20px;
}

        .success {
    padding: 15px;
    color: #2f855a;
    background: #c6f6d5;
    border-radius: 8px;
    margin-bottom: 20px;
}

        @media (max-width: 768px) {
    .main-content {
                grid-template-columns: 1fr;
}
            
            .filters {
    flex-direction: column;
}
            
            .tasks-header {
    flex-direction: column;
    gap: 15px;
    align-items: stretch;
}
        }
    </style>
  <style>
    .extracted-style-1 {
    margin-top: 30px;
}
    .extracted-style-2 {
    width: 100%;
    margin-bottom: 10px;
}
    .extracted-style-3 {
    width: 100%;
}
    .extracted-style-4 {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
}
    .extracted-style-5 {
    margin-bottom: 15px;
}
  </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>
                <span class="icon">📋</span>
                Gestão de Tarefas - DOM v2
            </h1>
            <div class="stats-grid" id="statsGrid">
                <!-- Stats will be loaded here -->
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Tasks Section -->
            <div class="tasks-section">
                <div class="tasks-header">
                    <h2>Lista de Tarefas</h2>
                    <button class="btn" onclick="openCreateModal()" tabindex="0">
                        <span>➕</span> Nova Tarefa
                    </button>
                </div>

                <!-- Filters -->
                <div class="filters">
                    <div class="filter-group">
                        <label>Status</label>
                        <select aria-label="Seleção" id="statusFilter" tabindex="0">
                            <option value="">Todos</option>
                            <option value="pending">Pendente</option>
                            <option value="in_progress">Em Progresso</option>
                            <option value="paused">Pausada</option>
                            <option value="completed">Concluída</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Prioridade</label>
                        <select aria-label="Seleção" id="priorityFilter" tabindex="0">
                            <option value="">Todas</option>
                            <option value="1">Alta</option>
                            <option value="2">Média</option>
                            <option value="3">Baixa</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Categoria</label>
                        <input id="categoryFilter" aria-label="text input" type="text" id="categoryFilter" placeholder="Filtrar por categoria" tabindex="0">
                    </div>
                    <div class="filter-group">
                        <label>&nbsp;</label>
                        <button class="btn btn-secondary" onclick="loadTasks()" tabindex="0">Filtrar</button>
                    </div>
                </div>

                <!-- Tasks List -->
                <div class="tasks-list" id="tasksList">
                    <!-- Tasks will be loaded here -->
                </div>
            </div>

            <!-- Sidebar -->
            <div class="sidebar">
                <h3>
                    <span>📊</span>
                    Dashboard
                </h3>
                <div id="dashboardStats">
                    <!-- Dashboard stats will be loaded here -->
                </div>

                <h3 class="extracted-style-1">
                    <span>📈</span>
                    Relatórios
                </h3>
                <button class="btn btn-secondary" class="extracted-style-2" onclick="loadKanbanData()" tabindex="0">
                    Ver Kanban
                </button>
                <button class="btn btn-secondary" class="extracted-style-3" onclick="exportTasks()" tabindex="0">
                    Exportar Dados
                </button>
            </div>
        </div>
    </div>

    <!-- Create/Edit Task Modal -->
    <div id="taskModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle">Nova Tarefa</h2>
                <span class="close" onclick="closeModal()">&times;</span>
            </div>
            <form id="taskForm">
                <div class="form-group">
                    <label for="taskTitle">Título *</label>
                    <input id="taskTitle" aria-label="text input" type="text" id="taskTitle" required tabindex="0">
                </div>
                <div class="form-group">
                    <label for="taskDescription">Descrição *</label>
                    <textarea id="taskDescription" required tabindex="0"></textarea>
                </div>
                <div class="form-group">
                    <label for="taskPriority">Prioridade</label>
                    <select aria-label="Seleção" id="taskPriority" tabindex="0">
                        <option value="1">Alta</option>
                        <option value="2" selected>Média</option>
                        <option value="3">Baixa</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="taskCategory">Categoria</label>
                    <input id="taskCategory" aria-label="text input" type="text" id="taskCategory" placeholder="Ex: Desenvolvimento, Design, Marketing" tabindex="0">
                </div>
                <div class="form-group">
                    <label for="taskDueDate">Data de Vencimento</label>
                    <input id="taskDueDate" aria-label="datetime-local input" type="datetime-local" id="taskDueDate" tabindex="0">
                </div>
                <div class="form-group">
                    <label for="taskResponsible">Responsável</label>
                    <select aria-label="Seleção" id="taskResponsible" tabindex="0">
                        <option value="">Selecionar responsável</option>
                    </select>
                </div>
                <div class="extracted-style-4">
                    <button type="button" class="btn btn-secondary" onclick="closeModal()" tabindex="0">Cancelar</button>
                    <button type="submit" class="btn" tabindex="0">Salvar Tarefa</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Global variables
        let currentTaskId = null;
        let users = [];

        // API Base URL
        const API_BASE = 'http://localhost:3001/api';

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
    
            loadStats();
    
            loadTasks();
    
            loadUsers();
    
            loadDashboardStats();
});

        // Load statistics
        async function loadStats() {
    
            try {
                const response = await fetch(`${API_BASE;
}/tasks/reports/dashboard`);
                const data = await response.json();
                
                if (data.success) {
    
                    const stats = data.data.summary;
    
                    document.getElementById('statsGrid').innerHTML = `
                        <div class="stat-card">
                            <div class="stat-number">${stats.total;
}</div>
                            <div class="stat-label">Total de Tarefas</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-number">${
    stats.pending;
}</div>
                            <div class="stat-label">Pendentes</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-number">${
    stats.inProgress;
}</div>
                            <div class="stat-label">Em Progresso</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-number">${
    stats.completed;
}</div>
                            <div class="stat-label">Concluídas</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-number">${
    stats.overdue;
}</div>
                            <div class="stat-label">Atrasadas</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-number">${
    stats.completionRate;
}%</div>
                            <div class="stat-label">Taxa de Conclusão</div>
                        </div>
                    `;
                }
            } catch (error) {
    console.error('Erro ao carregar estatísticas:', error);
}
        }

        // Load tasks
        async function loadTasks() {
    
            try {
                const statusFilter = document.getElementById('statusFilter').value;
    
                const priorityFilter = document.getElementById('priorityFilter').value;
    
                const categoryFilter = document.getElementById('categoryFilter').value;
    

                let url = `${API_BASE;
}/tasks?limit=100`;
                if (statusFilter) url += `&status=${
    statusFilter;
}`;
                if (priorityFilter) url += `&priority=${
    priorityFilter;
}`;
                if (categoryFilter) url += `&category=${
    categoryFilter;
}`;

                const response = await fetch(url);
                const data = await response.json();

                if (data.success) {
    
                    displayTasks(data.data.tasks);
} else {
    showError('Erro ao carregar tarefas: ' + data.error);
}
            } catch (error) {
    console.error('Erro ao carregar tarefas:', error);
}
        }

        // Display tasks
        function displayTasks(tasks) {
    
            const tasksList = document.getElementById('tasksList');
    
            
            if (tasks.length === 0) {
                tasksList.innerHTML = '<div class="loading">Nenhuma tarefa encontrada</div>';
    
                return;
}

            tasksList.innerHTML = tasks.map(task => `
                <div class="task-item ${
    getPriorityClass(task.priority);
}">
                    <div class="task-header">
                        <div class="task-title">${
    task.title;
}</div>
                        <div class="task-status ${
    getStatusClass(task.status);
}">
                            ${
    getStatusText(task.status);
}
                        </div>
                    </div>
                    <div class="task-description">${
    task.description;
}</div>
                    <div class="task-meta">
                        <div class="task-priority">
                            <div class="priority-indicator ${
    getPriorityClass(task.priority);
}"></div>
                            ${
    getPriorityText(task.priority);
}
                        </div>
                        <div>
                            ${
    task.category ? `<span>📁 ${task.category;
}</span>` : ''}
                            ${
    task.due_date ? `<span>📅 ${formatDate(task.due_date);
}</span>` : ''}
                        </div>
                    </div>
                    <div class="task-actions">
                        ${
    getTaskActions(task);
}
                    </div>
                </div>
            `).join('');
        }

        // Get priority class
        function getPriorityClass(priority) {
    switch (priority) {
                case 1: return 'high-priority priority-high';
    case 2: return 'medium-priority priority-medium';
    case 3: return 'low-priority priority-low';
    default: return '';
}
        }

        // Get priority text
        function getPriorityText(priority) {
    switch (priority) {
                case 1: return 'Alta';
    case 2: return 'Média';
    case 3: return 'Baixa';
    default: return 'Não definida';
}
        }

        // Get status class
        function getStatusClass(status) {
    switch (status) {
                case 'pending': return 'status-pending';
    case 'in_progress': return 'status-in-progress';
    case 'completed': return 'status-completed';
    case 'paused': return 'status-paused';
    default: return '';
}
        }

        // Get status text
        function getStatusText(status) {
    switch (status) {
                case 'pending': return 'Pendente';
    case 'in_progress': return 'Em Progresso';
    case 'completed': return 'Concluída';
    case 'paused': return 'Pausada';
    default: return status;
}
        }

        // Get task actions
        function getTaskActions(task) {
    
            let actions = '';
    
            
            if (task.status === 'pending') {
                actions += `<button class="btn btn-success btn-small" onclick="startTask('${task.id;
}')" tabindex="0">Iniciar</button>`;
            } else if (task.status === 'in_progress') {
    
                actions += `<button class="btn btn-success btn-small" onclick="completeTask('${task.id;
}')" tabindex="0">Concluir</button>`;
                actions += `<button class="btn btn-warning btn-small" onclick="pauseTask('${
    task.id;
}')" tabindex="0">Pausar</button>`;
            } else if (task.status === 'paused') {
    
                actions += `<button class="btn btn-success btn-small" onclick="startTask('${task.id;
}')" tabindex="0">Retomar</button>`;
            }
            
            actions += `<button class="btn btn-secondary btn-small" onclick="editTask('${
    task.id;
}')" tabindex="0">Editar</button>`;
            actions += `<button class="btn btn-danger btn-small" onclick="deleteTask('${
    task.id;
}')" tabindex="0">Excluir</button>`;
            
            return actions;
        }

        // Load users
        async function loadUsers() {
    
            try {
                const response = await fetch(`${API_BASE;
}/users`);
                const data = await response.json();
                
                if (data.success) {
    
                    users = data.data;
    
                    const select = document.getElementById('taskResponsible');
    
                    select.innerHTML = '<option value="">Selecionar responsável</option>';
    
                    users.forEach(user => {
                        select.innerHTML += `<option value="${user.id;
}">${
    user.name;
}</option>`;
                    });
                }
            } catch (error) {
    console.error('Erro ao carregar usuários:', error);
}
        }

        // Load dashboard stats
        async function loadDashboardStats() {
    
            try {
                const response = await fetch(`${API_BASE;
}/tasks/reports/dashboard`);
                const data = await response.json();
                
                if (data.success) {
    document.getElementById('dashboardStats').innerHTML = `
                        <div class="extracted-style-5">
                            <strong>Por Prioridade:</strong><br>
                            🔴 Alta: ${stats.byPriority.high;
}<br>
                            🟡 Média: ${
    stats.byPriority.medium;
}<br>
                            🟢 Baixa: ${
    stats.byPriority.low;
}
                        </div>
                        <div>
                            <strong>Por Categoria:</strong><br>
                            ${
    Object.entries(stats.byCategory).map(([category, count]) => 
                                `📁 ${category;
}: ${
    count;
}`
                            ).join('<br>')}
                        </div>
                    `;
                }
            } catch (error) {
    console.error('Erro ao carregar dashboard:', error);
}
        }

        // Modal functions
        function openCreateModal() {
    
            currentTaskId = null;
    
            document.getElementById('modalTitle').textContent = 'Nova Tarefa';
    
            document.getElementById('taskForm').reset();
    
            document.getElementById('taskModal').style.display = 'block';
}

        function closeModal() {
    
            document.getElementById('taskModal').style.display = 'none';
    
            currentTaskId = null;
}

        // Task actions
        async function startTask(taskId) {
    
            try {
                const response = await fetch(`${API_BASE;
}/tasks/${
    taskId;
}/start`, {
    method: 'PUT';
});
                const data = await response.json();
                
                if (data.success) {
    
                    showSuccess('Tarefa iniciada com sucesso');
    
                    loadTasks();
    
                    loadStats();
    
                    loadDashboardStats();
} else {
    showError('Erro ao iniciar tarefa: ' + data.error);
}
            } catch (error) {
    console.error('Erro ao iniciar tarefa:', error);
}
        }

        async function completeTask(taskId) {
    
            try {
                const response = await fetch(`${API_BASE;
}/tasks/${
    taskId;
}/complete`, {
    method: 'PUT',
                    headers: {
