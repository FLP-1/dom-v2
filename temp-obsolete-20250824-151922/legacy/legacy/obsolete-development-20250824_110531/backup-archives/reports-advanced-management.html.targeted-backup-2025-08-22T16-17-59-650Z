<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Relatórios Avançados - DOM v2</title>
    <style>
        * {
    
            margin: 0;
    
            padding: 0;
    
            box-sizing: border-box;
}

        body {
    
            color: #333;
    
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    
            min-height: 100vh;
}

        .container {
    
            margin: 0 auto;
    
            padding: 20px;
    
            max-width: 1400px;
}

        .header {
    
            color: white;
    
            text-align: center;
    
            margin-bottom: 30px;
}

        .header h1 {
    
            font-size: 2.5rem;
    
            margin-bottom: 10px;
    
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}

        .header p {
    
            font-size: 1.1rem;
    
            opacity: 0.9;
}

        .icon {
    
            font-size: 2rem;
    
            margin-right: 10px;
}

        .stats-grid {
    
            display: grid;
    
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    
            gap: 20px;
    
            margin-bottom: 30px;
}

        .stat-card {
    
            padding: 25px;
    
            border: 1px solid rgba(255,255,255,0.2);
    
            background: rgba(255, 255, 255, 0.95);
    
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    
            border-radius: 15px;
    
            text-align: center;
    
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
    
            -webkit-backdrop-filter: blur(10px);
    
    backdrop-filter: blur(10px);
    
            -webkit--webkit-backdrop-filter: blur(10px);
    
    backdrop-filter: blur(10px);
    
            -webkit-transition: transform 0.3s ease, box-shadow 0.3s ease;
}

        .stat-card:hover {
    
    transform: translateY(-5px);
    
            -webkit-transform: translateY(-5px);
    
            box-shadow: 0 12px 40px rgba(0,0,0,0.15);
}

        .stat-value {
    
            color: #667eea;
    
            font-size: 2.5rem;
    
            font-weight: bold;
    
            margin-bottom: 10px;
}

        .stat-label {
    
            color: #666;
    
            font-size: 1rem;
    
            font-weight: 500;
}

        .tabs {
    
            display: flex;
    
            padding: 5px;
    
            border: 1px solid rgba(255,255,255,0.2);
    
            background: rgba(255, 255, 255, 0.95);
    
            border-radius: 15px;
    
            margin-bottom: 30px;
    
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
    
            -webkit-backdrop-filter: blur(10px);
    
    backdrop-filter: blur(10px);
    
            -webkit--webkit-backdrop-filter: blur(10px);
    
    backdrop-filter: blur(10px);
}

        .tab {
    
            padding: 15px 20px;
    
            border: none;
    
            color: #666;
    
            background: transparent;
    
    transition: all 0.3s ease;
    
            flex: 1;
    
            font-size: 1rem;
    
            font-weight: 500;
    
            cursor: pointer;
    
            border-radius: 10px;
    
            -webkit-transition: all 0.3s ease;
}

        .tab.active {
    
            color: white;
    
            background: #667eea;
    
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
}

        .tab:hover:not(.active) {
    
            color: #667eea;
    
            background: rgba(102, 126, 234, 0.1);
}

        .tab-content {
    
            display: none;
    
            padding: 30px;
    
            border: 1px solid rgba(255,255,255,0.2);
    
            background: rgba(255, 255, 255, 0.95);
    
            border-radius: 15px;
    
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
    
            -webkit-backdrop-filter: blur(10px);
    
    backdrop-filter: blur(10px);
    
            -webkit--webkit-backdrop-filter: blur(10px);
    
    backdrop-filter: blur(10px);
}

        .tab-content.active {
    
            display: block;
}

        .section {
    
            margin-bottom: 30px;
}

        .section-title {
    
            display: flex;
    
            color: #333;
    
            font-size: 1.5rem;
    
            font-weight: 600;
    
            margin-bottom: 20px;
    
            justify-content: space-between;
    
            align-items: center;
}

        .btn {
    
            display: inline-block;
    
            padding: 12px 24px;
    
            border: none;
    
    transition: all 0.3s ease;
    
            border-radius: 8px;
    
            font-size: 0.9rem;
    
            font-weight: 500;
    
            cursor: pointer;
    
            -webkit-transition: all 0.3s ease;
    
            text-decoration: none;
}

        .btn-primary {
    
            color: white;
    
            background: #667eea;
}

        .btn-primary:hover {
    
            background: #5a6fd8;
    
    transform: translateY(-2px);
    
            -webkit-transform: translateY(-2px);
    
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
}

        .btn-secondary {
    
            color: white;
    
            background: #6c757d;
}

        .btn-secondary:hover {
    
            background: #5a6268;
}

        .btn-success {
    
            color: white;
    
            background: #28a745;
}

        .btn-success:hover {
    
            background: #218838;
}

        .btn-danger {
    
            color: white;
    
            background: #dc3545;
}

        .btn-danger:hover {
    
            background: #c82333;
}

        .reports-grid {
    
            display: grid;
    
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    
            gap: 20px;
}

        .report-card {
    
            padding: 25px;
    
            border: 1px solid #e9ecef;
    
            background: white;
    
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    
            border-radius: 12px;
    
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    
            -webkit-transition: transform 0.3s ease, box-shadow 0.3s ease;
}

        .report-card:hover {
    
    transform: translateY(-3px);
    
            -webkit-transform: translateY(-3px);
    
            box-shadow: 0 8px 30px rgba(0,0,0,0.15);
}

        .report-header {
    
            display: flex;
    
            justify-content: space-between;
    
            align-items: flex-start;
    
            margin-bottom: 15px;
}

        .report-title {
    
            color: #333;
    
            font-size: 1.2rem;
    
            font-weight: 600;
    
            margin-bottom: 5px;
}

        .report-type {
    
            padding: 4px 12px;
    
            color: white;
    
            background: #667eea;
    
            border-radius: 20px;
    
            font-size: 0.8rem;
    
            font-weight: 500;
}

        .report-description {
    
            color: #666;
    
            margin-bottom: 15px;
    
            line-height: 1.5;
}

        .report-meta {
    
            display: flex;
    
            color: #888;
    
            justify-content: space-between;
    
            align-items: center;
    
            margin-bottom: 15px;
    
            font-size: 0.9rem;
}

        .report-actions {
    
            display: flex;
    
            gap: 10px;
}

        .events-list {
    
            background: white;
    
            border-radius: 12px;
    
            overflow: hidden;
    
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
}

        .event-item {
    
            display: flex;
    
            padding: 20px;
    
            border-bottom: 1px solid #e9ecef;
    
            justify-content: space-between;
    
            align-items: center;
}

        .event-item:last-child {
    
            border-bottom: none;
}

        .event-info {
    
            flex: 1;
}

        .event-name {
    
            color: #333;
    
            font-weight: 600;
    
            margin-bottom: 5px;
}

        .event-meta {
    
            color: #666;
    
            font-size: 0.9rem;
}

        .event-time {
    
            color: #888;
    
            font-size: 0.8rem;
}

        .widgets-grid {
    
            display: grid;
    
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    
            gap: 20px;
}

        .widget-card {
    
            padding: 25px;
    
            border: 1px solid #e9ecef;
    
            background: white;
    
            border-radius: 12px;
    
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
}

        .widget-header {
    
            display: flex;
    
            justify-content: space-between;
    
            align-items: center;
    
            margin-bottom: 15px;
}

        .widget-title {
    
            color: #333;
    
            font-size: 1.1rem;
    
            font-weight: 600;
}

        .widget-type {
    
            padding: 4px 12px;
    
            color: white;
    
            background: #28a745;
    
            border-radius: 20px;
    
            font-size: 0.8rem;
    
            font-weight: 500;
}

        .modal {
    
            display: none;
    
            position: fixed;
    
            top: 0;
    
            left: 0;
    
            width: 100%;
    
            height: 100%;
    
            z-index: 1000;
    
            background-color: rgba(0,0,0,0.5);
    
            -webkit-backdrop-filter: blur(5px);
    
    backdrop-filter: blur(5px);
    
            -webkit--webkit-backdrop-filter: blur(5px);
    
    backdrop-filter: blur(5px);
}

        .modal-content {
    
            width: 90%;
    
            margin: 5% auto;
    
            padding: 0;
    
            background: white;
    
            border-radius: 15px;
    
            max-width: 600px;
    
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    
            -webkit-animation: modalSlideIn 0.3s ease;
    
    animation: modalSlideIn 0.3s ease;
}

        @keyframes modalSlideIn {
    
    transform: translateY(-50px);
    
            from {
                opacity: 0;
    
                -webkit-transform: translateY(-50px);
}
            to {
    
    transform: translateY(0);
    
                opacity: 1;
    
                -webkit-transform: translateY(0);
}
        }

        .modal-header {
    
            display: flex;
    
            padding: 20px 30px;
    
            color: white;
    
            background: #667eea;
    
            border-radius: 15px 15px 0 0;
    
            justify-content: space-between;
    
            align-items: center;
}

        .modal-title {
    
            font-size: 1.3rem;
    
            font-weight: 600;
}

        .close {
    
            color: white;
    
    transition: opacity 0.3s ease;
    
            font-size: 28px;
    
            font-weight: bold;
    
            cursor: pointer;
    
            -webkit-transition: opacity 0.3s ease;
}

        .close:hover {
    
            opacity: 0.7;
}

        .modal-body {
    
            padding: 30px;
}

        .form-group {
    
            margin-bottom: 20px;
}

        .form-label {
    
            display: block;
    
            color: #333;
    
            margin-bottom: 8px;
    
            font-weight: 500;
}

        .form-input, .form-select, .form-textarea {
    
            width: 100%;
    
            padding: 12px 15px;
    
            border: 2px solid #e9ecef;
    
    transition: border-color 0.3s ease;
    
            border-radius: 8px;
    
            font-size: 1rem;
    
            -webkit-transition: border-color 0.3s ease;
}

        .form-input:focus, .form-select:focus, .form-textarea:focus {
    
            outline: none;
    
            border-color: #667eea;
}

        .form-textarea {
    
            resize: vertical;
    
            min-height: 100px;
}

        .form-actions {
    
            display: flex;
    
            gap: 15px;
    
            justify-content: flex-end;
    
            margin-top: 30px;
}

        .loading {
    
            padding: 40px;
    
            color: #666;
    
            text-align: center;
}

        .error {
    
            padding: 15px;
    
            border: 1px solid #f5c6cb;
    
            color: #721c24;
    
            background: #f8d7da;
    
            border-radius: 8px;
    
            margin-bottom: 20px;
}

        .success {
    
            padding: 15px;
    
            border: 1px solid #c3e6cb;
    
            color: #155724;
    
            background: #d4edda;
    
            border-radius: 8px;
    
            margin-bottom: 20px;
}

        .chart-container {
    
            padding: 25px;
    
            background: white;
    
            border-radius: 12px;
    
            margin-bottom: 20px;
    
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
}

        .chart-title {
    
            color: #333;
    
            font-size: 1.2rem;
    
            font-weight: 600;
    
            margin-bottom: 20px;
    
            text-align: center;
}

        .chart-placeholder {
    
            display: flex;
    
            height: 300px;
    
            color: #666;
    
            background: linear-gradient(45deg, #f8f9fa 25%, transparent 25%), 
                        linear-gradient(-45deg, #f8f9fa 25%, transparent 25%), 
                        linear-gradient(45deg, transparent 75%, #f8f9fa 75%), 
                        linear-gradient(-45deg, transparent 75%, #f8f9fa 75%);
    
            background-size: 20px 20px;
    
            background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
    
            border-radius: 8px;
    
            align-items: center;
    
            justify-content: center;
    
            font-size: 1.1rem;
}

        @media (max-width: 768px) {
    
            .container {
                padding: 15px;
}

            .header h1 {
    
                font-size: 2rem;
}

            .stats-grid {
    
                grid-template-columns: 1fr;
}

            .tabs {
    
                flex-direction: column;
}

            .reports-grid, .widgets-grid {
    
                grid-template-columns: 1fr;
}

            .modal-content {
    
                width: 95%;
    
                margin: 10% auto;
}
        }
    </style>
  <style>
    .extracted-style-1 {
     padding: 40px;
     color: #666;
     grid-column: 1 / -1;
     text-align: center;
}
    .extracted-style-2 {
     font-size: 3rem;
     margin-bottom: 20px;
}
    .extracted-style-3 {
     padding: 40px;
     color: #666;
     text-align: center;
}
    .extracted-style-4 {
     font-size: 3rem;
     margin-bottom: 20px;
}
    .extracted-style-5 {
     padding: 40px;
     color: #666;
     grid-column: 1 / -1;
     text-align: center;
}
    .extracted-style-6 {
     font-size: 3rem;
     margin-bottom: 20px;
}
    .extracted-style-7 {
     margin-bottom: 15px;
}
    .extracted-style-8 {
     display: flex;
     gap: 10px;
}
  </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>
                <span class="icon">📊</span>
                Sistema de Relatórios Avançados
            </h1>
            <p>Analytics, relatórios personalizados e insights inteligentes</p>
        </div>

        <!-- Estatísticas -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-value" id="totalReports">0</div>
                <div class="stat-label">Relatórios</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="activeReports">0</div>
                <div class="stat-label">Ativos</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="totalExecutions">0</div>
                <div class="stat-label">Execuções</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="activeWidgets">0</div>
                <div class="stat-label">Widgets</div>
            </div>
        </div>

        <!-- Tabs de Navegação -->
        <div class="tabs">
            <button class="tab active" onclick="showTab('reports')" tabindex="0">📋 Relatórios</button>
            <button class="tab" onclick="showTab('analytics')" tabindex="0">📈 Analytics</button>
            <button class="tab" onclick="showTab('widgets')" tabindex="0">🎛️ Widgets</button>
            <button class="tab" onclick="showTab('charts')" tabindex="0">📊 Gráficos</button>
        </div>

        <!-- Conteúdo das Tabs -->
        <div id="reports-tab" class="tab-content active">
            <div class="section">
                <div class="section-title">
                    Meus Relatórios
                    <button class="btn btn-primary" onclick="showCreateReportModal()" tabindex="0">+ Novo Relatório</button>
                </div>
                <div class="reports-grid" id="reportsGrid">
                    <!-- Relatórios serão carregados aqui -->
                </div>
            </div>
        </div>

        <div id="analytics-tab" class="tab-content">
            <div class="section">
                <div class="section-title">Eventos de Analytics</div>
                <div class="events-list" id="eventsList">
                    <!-- Eventos serão carregados aqui -->
                </div>
            </div>
        </div>

        <div id="widgets-tab" class="tab-content">
            <div class="section">
                <div class="section-title">
                    Widgets do Dashboard
                    <button class="btn btn-primary" onclick="showCreateWidgetModal()" tabindex="0">+ Novo Widget</button>
                </div>
                <div class="widgets-grid" id="widgetsGrid">
                    <!-- Widgets serão carregados aqui -->
                </div>
            </div>
        </div>

        <div id="charts-tab" class="tab-content">
            <div class="section">
                <div class="section-title">Gráficos e Visualizações</div>
                
                <div class="chart-container">
                    <div class="chart-title">Relatórios por Tipo</div>
                    <div class="chart-placeholder" id="reportsByTypeChart">
                        Gráfico de Relatórios por Tipo
                    </div>
                </div>

                <div class="chart-container">
                    <div class="chart-title">Execuções por Status</div>
                    <div class="chart-placeholder" id="executionsByStatusChart">
                        Gráfico de Execuções por Status
                    </div>
                </div>

                <div class="chart-container">
                    <div class="chart-title">Eventos de Analytics</div>
                    <div class="chart-placeholder" id="analyticsEventsChart">
                        Gráfico de Eventos de Analytics
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de Novo Relatório -->
    <div id="reportModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title">Novo Relatório</div>
                <span class="close" onclick="closeModal('reportModal')">&times;</span>
            </div>
            <form id="reportForm">
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label">Nome do Relatório</label>
                        <input id="reportName" aria-label="text input" type="text" class="form-input" id="reportName" required tabindex="0">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Descrição</label>
                        <textarea class="form-textarea" id="reportDescription" tabindex="0"></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" id="reportType" required tabindex="0">
                            <option value="">Selecione o tipo</option>
                            <option value="financial">Financeiro</option>
                            <option value="hr">Recursos Humanos</option>
                            <option value="productivity">Produtividade</option>
                            <option value="custom">Personalizado</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Categoria</label>
                        <input id="reportCategory" aria-label="text input" type="text" class="form-input" id="reportCategory" required tabindex="0">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Público</label>
                        <select class="form-select" id="reportPublic" tabindex="0">
                            <option value="false">Privado</option>
                            <option value="true">Público</option>
                        </select>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" onclick="closeModal('reportModal')" tabindex="0">Cancelar</button>
                        <button type="submit" class="btn btn-primary" tabindex="0">Criar Relatório</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal de Novo Widget -->
    <div id="widgetModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title">Novo Widget</div>
                <span class="close" onclick="closeModal('widgetModal')">&times;</span>
            </div>
            <form id="widgetForm">
                <div class="modal-body">
                    <div class="form-group">
                        <label class="form-label">Nome do Widget</label>
                        <input id="widgetName" aria-label="text input" type="text" class="form-input" id="widgetName" required tabindex="0">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" id="widgetType" required tabindex="0">
                            <option value="">Selecione o tipo</option>
                            <option value="chart">Gráfico</option>
                            <option value="metric">Métrica</option>
                            <option value="table">Tabela</option>
                            <option value="list">Lista</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Fonte de Dados</label>
                        <input id="widgetDataSource" aria-label="text input" type="text" class="form-input" id="widgetDataSource" tabindex="0">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Intervalo de Atualização (segundos)</label>
                        <input id="widgetRefreshInterval" aria-label="number input" type="number" class="form-input" id="widgetRefreshInterval" min="30" value="300" tabindex="0">
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-secondary" onclick="closeModal('widgetModal')" tabindex="0">Cancelar</button>
                        <button type="submit" class="btn btn-primary" tabindex="0">Criar Widget</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Estado global
        let currentUser = null;
        let reports = [];
        let events = [];
        let widgets = [];
        let statistics = {};

        // Inicialização
        document.addEventListener('DOMContentLoaded', function() {
    
            loadUser();
    
            loadStatistics();
    
            loadReports();
    
            loadEvents();
    
            loadWidgets();
});

        // Funções de navegação
        function showTab(tabName) {
    
            // Esconder todas as tabs
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
});
            document.querySelectorAll('.tab').forEach(tab => {
    
                tab.classList.remove('active');
});

            // Mostrar tab selecionada
            document.getElementById(tabName + '-tab').classList.add('active');
            event.target.classList.add('active');
        }

        // Funções de modal
        function showCreateReportModal() {
    
            document.getElementById('reportModal').style.display = 'block';
}

        function showCreateWidgetModal() {
    
            document.getElementById('widgetModal').style.display = 'block';
}

        function closeModal(modalId) {
    
            document.getElementById(modalId).style.display = 'none';
}

        // Fechar modal ao clicar fora
        window.onclick = function(event) {
    
            if (event.target.classList.contains('modal')) {
                event.target.style.display = 'none';
}
        }

        // Carregar usuário
        function loadUser() {
    
            const userData = localStorage.getItem('user');
    
            if (userData) {
                currentUser = JSON.parse(userData);
}
        }

        // Carregar estatísticas
        async function loadStatistics() {
    
            try {
                const response = await fetch('/api/reports-advanced/statistics', {
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token');
}`
                    }
                });

                if (response.ok) {
    
                    const data = await response.json();
    
                    statistics = data.data;
    
                    updateStatisticsDisplay();
}
            } catch (error) {
    
                console.error('Erro ao carregar estatísticas:', error);
}
        }

        function updateStatisticsDisplay() {
    
            document.getElementById('totalReports').textContent = 
                statistics.reports_by_type?.reduce((sum, item) => sum + item.count, 0) || 0;
    
            document.getElementById('activeReports').textContent = 
                statistics.reports_by_type?.find(item => item.type === 'active')?.count || 0;
    
            document.getElementById('totalExecutions').textContent = 
                statistics.executions_by_status?.reduce((sum, item) => sum + item.count, 0) || 0;
    
            document.getElementById('activeWidgets').textContent = 
                statistics.active_widgets || 0;
}

        // Carregar relatórios
        async function loadReports() {
    
            try {
                const response = await fetch('/api/reports-advanced/reports', {
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token');
}`
                    }
                });

                if (response.ok) {
    
                    const data = await response.json();
    
                    reports = data.data;
    
                    displayReports();
}
            } catch (error) {
    
                console.error('Erro ao carregar relatórios:', error);
}
        }

        function displayReports() {
    
            const container = document.getElementById('reportsGrid');
    
            
            if (reports.length === 0) {
                container.innerHTML = `
                    <div class="extracted-style-1">
                        <div class="extracted-style-2">📊</div>
                        <h3>Nenhum relatório encontrado</h3>
                        <p>Crie seu primeiro relatório para começar a analisar seus dados</p>
                    </div>
                `;
    
                return;
}

            container.innerHTML = reports.map(report => `
                <div class="report-card">
                    <div class="report-header">
                        <div>
                            <div class="report-title">${
    report.name;
}</div>
                            <div class="report-description">${
    report.description || 'Sem descrição';
}</div>
                        </div>
                        <span class="report-type">${
    report.type;
}</span>
                    </div>
                    <div class="report-meta">
                        <span>Categoria: ${
    report.category;
}</span>
                        <span>${
    new Date(report.created_at).toLocaleDateString();
}</span>
                    </div>
                    <div class="report-actions">
                        <button class="btn btn-success" onclick="executeReport('${
    report.id;
}')" tabindex="0">
                            ▶️ Executar
                        </button>
                        <button class="btn btn-primary" onclick="editReport('${
    report.id;
}')" tabindex="0">
                            ✏️ Editar
                        </button>
                        <button class="btn btn-danger" onclick="deleteReport('${
    report.id;
}')" tabindex="0">
                            🗑️ Excluir
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // Carregar eventos de analytics
        async function loadEvents() {
    
            try {
                const response = await fetch('/api/reports-advanced/analytics/events?limit=50', {
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token');
}`
                    }
                });

                if (response.ok) {
    
                    const data = await response.json();
    
                    events = data.data;
    
                    displayEvents();
}
            } catch (error) {
    
                console.error('Erro ao carregar eventos:', error);
}
        }

        function displayEvents() {
    
            const container = document.getElementById('eventsList');
    
            
            if (events.length === 0) {
                container.innerHTML = `
                    <div class="extracted-style-3">
                        <div class="extracted-style-4">📈</div>
                        <h3>Nenhum evento encontrado</h3>
                        <p>Os eventos de analytics aparecerão aqui conforme você usa o sistema</p>
                    </div>
                `;
    
                return;
}

            container.innerHTML = events.map(event => `
                <div class="event-item">
                    <div class="event-info">
                        <div class="event-name">${
    event.event_name;
}</div>
                        <div class="event-meta">Tipo: ${
    event.event_type;
} | Sessão: ${
    event.session_id || 'N/A';
}</div>
                    </div>
                    <div class="event-time">
                        ${
    new Date(event.created_at).toLocaleString();
}
                    </div>
                </div>
            `).join('');
        }

        // Carregar widgets
        async function loadWidgets() {
    
            try {
                const response = await fetch('/api/reports-advanced/dashboard/widgets', {
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token');
}`
                    }
                });

                if (response.ok) {
    
                    const data = await response.json();
    
                    widgets = data.data;
    
                    displayWidgets();
}
            } catch (error) {
    
                console.error('Erro ao carregar widgets:', error);
}
        }

        function displayWidgets() {
    
            const container = document.getElementById('widgetsGrid');
    
            
            if (widgets.length === 0) {
                container.innerHTML = `
                    <div class="extracted-style-5">
                        <div class="extracted-style-6">🎛️</div>
                        <h3>Nenhum widget encontrado</h3>
                        <p>Crie widgets personalizados para seu dashboard</p>
                    </div>
                `;
    
                return;
}

            container.innerHTML = widgets.map(widget => `
                <div class="widget-card">
                    <div class="widget-header">
                        <div class="widget-title">${
    widget.name;
}</div>
                        <span class="widget-type">${
    widget.type;
}</span>
                    </div>
                    <div class="extracted-style-7">
                        <strong>Fonte:</strong> ${
    widget.data_source || 'N/A';
}<br>
                        <strong>Atualização:</strong> ${
    widget.refresh_interval ? widget.refresh_interval + 's' : 'Manual';
}
                    </div>
                    <div class="extracted-style-8">
                        <button class="btn btn-primary" onclick="editWidget('${
    widget.id;
}')" tabindex="0">
                            ✏️ Editar
                        </button>
                        <button class="btn btn-danger" onclick="deleteWidget('${
    widget.id;
}')" tabindex="0">
                            🗑️ Excluir
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // Formulários
        document.getElementById('reportForm').addEventListener('submit', async function(e) {
    
            e.preventDefault();
    
            
            const formData = {
                name: document.getElementById('reportName').value,
                description: document.getElementById('reportDescription').value,
                type: document.getElementById('reportType').value,
                category: document.getElementById('reportCategory').value,
                is_public: document.getElementById('reportPublic').value === 'true'
            ;
};

            try {
    
                const response = await fetch('/api/reports-advanced/reports', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${localStorage.getItem('token');
}`
                    },
                    body: JSON.stringify(formData)
                });

                if (response.ok) {
    
                    closeModal('reportModal');
    
                    loadReports();
    
                    loadStatistics();
    
                    showMessage('Relatório criado com sucesso!', 'success');
} else {
    
                    const error = await response.json();
    
                    showMessage(error.error || 'Erro ao criar relatório', 'error');
}
            } catch (error) {
    
                console.error('Erro ao criar relatório:', error);
    
                showMessage('Erro ao criar relatório', 'error');
}
        });

        document.getElementById('widgetForm').addEventListener('submit', async function(e) {
    
            e.preventDefault();
    
            
            const formData = {
                name: document.getElementById('widgetName').value,
                type: document.getElementById('widgetType').value,
                data_source: document.getElementById('widgetDataSource').value,
                refresh_interval: parseInt(document.getElementById('widgetRefreshInterval').value),
                position: { x: 0, y: 0, width: 300, height: 200 ;
},
                config: {
     title: document.getElementById('widgetName').value ;
}
            };

            try {
    
                const response = await fetch('/api/reports-advanced/dashboard/widgets', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${localStorage.getItem('token');
}`
                    },
                    body: JSON.stringify(formData)
                });

                if (response.ok) {
    
                    closeModal('widgetModal');
    
                    loadWidgets();
    
                    loadStatistics();
    
                    showMessage('Widget criado com sucesso!', 'success');
} else {
    
                    const error = await response.json();
    
                    showMessage(error.error || 'Erro ao criar widget', 'error');
}
            } catch (error) {
    
                console.error('Erro ao criar widget:', error);
    
                showMessage('Erro ao criar widget', 'error');
}
        });

        // Funções de ação
        async function executeReport(reportId) {
    
            try {
                const response = await fetch(`/api/reports-advanced/reports/${reportId;
}/execute`, {
    
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${localStorage.getItem('token');
}`
                    },
                    body: JSON.stringify({
     parameters: { period: 'Último mês' ;
} })
                });

                if (response.ok) {
    
                    const data = await response.json();
    
                    showMessage('Relatório executado com sucesso!', 'success');
    
                    console.log('Resultado do relatório:', data.data.result);
} else {
    
                    const error = await response.json();
    
                    showMessage(error.error || 'Erro ao executar relatório', 'error');
}
            } catch (error) {
    
                console.error('Erro ao executar relatório:', error);
    
                showMessage('Erro ao executar relatório', 'error');
}
        }

        async function deleteReport(reportId) {
    
            if (!confirm('Tem certeza que deseja excluir este relatório?')) {
                return;
}

            try {
    
                const response = await fetch(`/api/reports-advanced/reports/${reportId;
}`, {
    
                    method: 'DELETE',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token');
}`
                    }
                });

                if (response.ok) {
    
                    loadReports();
    
                    loadStatistics();
    
                    showMessage('Relatório excluído com sucesso!', 'success');
} else {
    
                    const error = await response.json();
    
                    showMessage(error.error || 'Erro ao excluir relatório', 'error');
}
            } catch (error) {
    
                console.error('Erro ao excluir relatório:', error);
    
                showMessage('Erro ao excluir relatório', 'error');
}
        }

        async function deleteWidget(widgetId) {
    
            if (!confirm('Tem certeza que deseja excluir este widget?')) {
                return;
}

            try {
    
                const response = await fetch(`/api/reports-advanced/dashboard/widgets/${widgetId;
}`, {
    
                    method: 'DELETE',
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('token');
}`
                    }
                });

                if (response.ok) {
    
                    loadWidgets();
    
                    loadStatistics();
    
                    showMessage('Widget excluído com sucesso!', 'success');
} else {
    
                    const error = await response.json();
    
                    showMessage(error.error || 'Erro ao excluir widget', 'error');
}
            } catch (error) {
    
                console.error('Erro ao excluir widget:', error);
    
                showMessage('Erro ao excluir widget', 'error');
}
        }

        function editReport(reportId) {
    
            // Implementar edição de relatório
            showMessage('Funcionalidade de edição em desenvolvimento', 'error');
}

        function editWidget(widgetId) {
    
            // Implementar edição de widget
            showMessage('Funcionalidade de edição em desenvolvimento', 'error');
}

        // Função para mostrar mensagens
        function showMessage(message, type) {
    
            const messageDiv = document.createElement('div');
    
            messageDiv.className = type;
    
            messageDiv.textContent = message;
    
            
            const container = document.querySelector('.container');
    
            container.insertBefore(messageDiv, container.firstChild);
    
            
            setTimeout(() => {
                messageDiv.remove();
}, 5000);
        }

        // Registrar evento de analytics ao carregar a página
        async function registerPageView() {
    
            try {
                await fetch('/api/reports-advanced/analytics/events', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${localStorage.getItem('token');
}`
                    },
                    body: JSON.stringify({
    
                        event_type: 'page_view',
                        event_name: 'Relatórios Avançados',
                        page_url: window.location.href,
                        user_agent: navigator.userAgent
                    ;
})
                });
            } catch (error) {
    
                console.error('Erro ao registrar evento:', error);
}
        }

        // Registrar visualização da página
        registerPageView();
    </script>
</body>
</html>
