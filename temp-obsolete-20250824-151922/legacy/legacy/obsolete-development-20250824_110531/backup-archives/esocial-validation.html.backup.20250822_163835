    <script>
        const API_BASE = 'http://localhost:3001/api';

        // FunÃ§Ãµes de navegaÃ§Ã£o
        function showTab(tabName) {
    
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
});
            document.querySelectorAll('.nav-tab').forEach(tab => {
    
                tab.classList.remove('active');
});

            document.getElementById(tabName).classList.add('active');
            event.target.classList.add('active');
        }

        // FunÃ§Ãµes de API
        async function apiCall(endpoint, options = {}) {
            try {
                const response = await fetch(`${API_BASE}${endpoint}`, {
                    headers: {
                        'Content-Type': 'application/json',
                        ...options.headers
                    },
                    ...options
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                return await response.json();
            } catch (error) {
                console.error('API Error:', error);
            }
        }

        // FunÃ§Ãµes de validaÃ§Ã£o
        async function validateUserData() {
            const formData = {
                cpf: document.getElementById('cpf').value,
                email: document.getElementById('email').value,
                phone: document.getElementById('phone').value,
                cep: document.getElementById('cep').value,
                name: document.getElementById('name').value
            };

            try {
                const response = await apiCall('/esocial/validate-user-data', {
                    method: 'POST',
                    body: JSON.stringify(formData)
                });

                displayValidationResults(response.data);
            } catch (error) {
                showAlert('Erro ao validar dados', 'error');
            }
        }

        async function validateSingleCpf() {
            const cpf = document.getElementById('validateCpf').value;

            if (!cpf) {
                showAlert('Digite um CPF para validar', 'error');
                return;
            }

            try {
                const response = await apiCall('/esocial/validate-cpf', {
                    method: 'POST',
                    body: JSON.stringify({ cpf })
                });

                showValidationResult('CPF', response.data);
            } catch (error) {
                showAlert('Erro ao validar CPF', 'error');
            }
        }

        async function validateSingleEmail() {
            const email = document.getElementById('validateEmail').value;

            if (!email) {
                showAlert('Digite um email para validar', 'error');
                return;
            }

            try {
                const response = await apiCall('/esocial/validate-email', {
                    method: 'POST',
                    body: JSON.stringify({ email })
                });

                showValidationResult('Email', response.data);
            } catch (error) {
                showAlert('Erro ao validar email', 'error');
            }
        }

        async function validateSinglePhone() {
    
            const phone = document.getElementById('validatePhone').value;
    
            if (!phone) {
                showAlert('Digite um telefone para validar', 'error');
    
                return;
}

            try {
    const response = await apiCall('/esocial/validate-phone', {
                    method: 'POST',
                    body: JSON.stringify({ phone
})
                });

                showValidationResult('Telefone', response.data);
            } catch (error) {
    
                showAlert('Erro ao validar telefone', 'error');
}
        }

        async function validateSingleCep() {
    
            const cep = document.getElementById('validateCep').value;
    
            if (!cep) {
                showAlert('Digite um CEP para validar', 'error');
    
                return;
}

            try {
    const response = await apiCall('/esocial/validate-cep', {
                    method: 'POST',
                    body: JSON.stringify({ cep
})
                });

                showValidationResult('CEP', response.data);
            } catch (error) {
    
                showAlert('Erro ao validar CEP', 'error');
}
        }

        // Funções OTP
        async function sendOTP() {
    
            const type = document.getElementById('otpType').value;
    
            const value = document.getElementById('otpValue').value;
    
            const userId = document.getElementById('otpUserId').value;
    

            if (!type || !value || !userId) {
                showAlert('Preencha todos os campos', 'error');
    
                return;
}

            try {
    const response = await apiCall('/esocial/send-otp', {
                    method: 'POST',
                    body: JSON.stringify({ type, value, user_id: userId
})
                });

                showAlert(response.data.message, 'success');
            } catch (error) {
    
                showAlert('Erro ao enviar OTP', 'error');
}
        }

        async function verifyOTP() {
    
            const type = document.getElementById('otpType').value;
    
            const value = document.getElementById('otpValue').value;
    
            const userId = document.getElementById('otpUserId').value;
    
            
            const otpInputs = document.querySelectorAll('.otp-input input');
    
            const otp = Array.from(otpInputs).map(input => input.value).join('');
    

            if (!type || !value || !userId || otp.length !== 6) {
                showAlert('Preencha todos os campos e digite o código OTP completo', 'error');
    
                return;
}

            try {
    const response = await apiCall('/esocial/verify-otp', {
                    method: 'POST',
                    body: JSON.stringify({ type, value, otp, user_id: userId
})
                });

                if (response.data.verified) {
    
                    showAlert('OTP verificado com sucesso!', 'success');
    
                    // Limpar campos
                    otpInputs.forEach(input => input.value = '');
} else {
    
                    showAlert('Código OTP inválido', 'error');
}
            } catch (error) {
    
                showAlert('Erro ao verificar OTP', 'error');
}
        }

        // Função de compliance
        async function checkCompliance() {
    
