                return;
}

            try {
    
                const response = await apiCall(`/esocial/compliance-status/${userId
}`);
                displayComplianceResults(response.data);
            } catch (error) {
    
                showAlert('Erro ao verificar compliance', 'error');
}
        }

        // FunÃ§Ãµes de exibiÃ§Ã£o
        function displayValidationResults(data) {
            const container = document.getElementById('validationResults');
            let html = '<div class="validation-results">';
            
            Object.entries(data.validations).forEach(([field, validation]) => {
                const statusClass = validation.isValid ? 'validation-success' : 'validation-error';
                const statusIcon = validation.isValid ? 'âœ…' : 'âŒ';
                
                html += `
                    <div class="validation-result ${statusClass}">
                        <h4>${statusIcon} ${field.toUpperCase()}</h4>
                        <p><strong>Valor:</strong> ${validation.value || 'NÃ£o informado'}</p>
                        <p><strong>Status:</strong> ${validation.isValid ? 'VÃ¡lido' : 'InvÃ¡lido'}</p>
                        ${validation.exists ? '<p><strong>âš ï¸ Email jÃ¡ cadastrado no sistema</strong></p>' : ''}
                    </div>
                `;
            });
            
            html += `
                <div class="validation-result ${data.allValid ? 'validation-success' : 'validation-error'}">
                    <h4>${data.allValid ? 'âœ…' : 'âŒ'} Resultado Geral</h4>
                    <p><strong>${data.message}</strong></p>
                </div>
            </div>`;
            
            container.innerHTML = html;
        }

        function showValidationResult(field, data) {
            const statusClass = data.isValid ? 'validation-success' : 'validation-error';
            const statusIcon = data.isValid ? 'âœ…' : 'âŒ';
            
            let html = `
                <div class="validation-result ${statusClass}">
                    <h4>${statusIcon} ValidaÃ§Ã£o de ${field}</h4>
                    <p><strong>Valor:</strong> ${data[field.toLowerCase()] || data.value}</p>
                    <p><strong>Status:</strong> ${data.isValid ? 'VÃ¡lido' : 'InvÃ¡lido'}</p>
                    <p><strong>Mensagem:</strong> ${data.message}</p>
                    ${data.addressData ? `
                        <div class="extracted-style-6">
                            <h5>ðŸ“ Dados do EndereÃ§o:</h5>
                            <p><strong>Logradouro:</strong> ${data.addressData.logradouro}</p>
                            <p><strong>Bairro:</strong> ${data.addressData.bairro}</p>
                            <p><strong>Cidade:</strong> ${data.addressData.localidade} - ${data.addressData.uf}</p>
                        </div>
                    ` : ''}
                </div>
            `;
            
            document.getElementById('validationResults').innerHTML = html;
        }

