{
  "name": "dom-v2-backend",
  "version": "2.0.0",
  "description": "Backend DOM v2 - Node.js + Express + TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server-dev.js",
    "dev": "nodemon src/server-simple.ts",
    "dev:clean": "nodemon src/server-clean.ts",
    "dev:original": "nodemon src/server.ts",
    "dev:simple": "nodemon --exec ts-node src/server-simple-dashboard.ts",
    "dev:documents": "nodemon --exec ts-node src/server-documents-only.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "test:api": "jest api-endpoints.test.ts",
    "test:controllers": "jest controllers.test.ts",
    "test:all": "jest --verbose --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed-simple.ts",
    "db:seed:advanced": "ts-node prisma/seed-advanced.ts",
    "db:test": "ts-node prisma/seed-simple-fixed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:reset:advanced": "prisma migrate reset --force && ts-node prisma/seed-advanced.ts",
    "db:migrate:profiles": "ts-node prisma/migrate-profiles.ts",
    "db:migrate:profiles:rollback": "ts-node prisma/migrate-profiles.ts --rollback",
    "db:setup:complete": "prisma migrate reset --force && ts-node prisma/seed-advanced.ts && ts-node prisma/migrate-profiles.ts"
  },
  "keywords": [
    "dom",
    "v2",
    "backend",
    "express",
    "typescript"
  ],
  "author": "DOM Team v2",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.0.2",
    "prisma": "^6.12.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.5",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "tsconfig-paths": "^4.2.0"
  }
}
