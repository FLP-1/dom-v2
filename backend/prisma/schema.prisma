    @@map("esocial_config")
  }

model PayrollItem {
  id              String        @id @default(cuid()) @db.VarChar(50)
  payroll_period_id String      @db.VarChar(50)
  employee_id     String        @db.VarChar(50)
  
  // Dados do Funcionário
  employee_name   String        @db.VarChar(255)
  employee_cpf    String        @db.VarChar(14)
  position        String        @db.VarChar(100)
  admission_date  DateTime      @db.Timestamp(6)
  base_salary     Decimal       @db.Decimal(10,2)
  
  // Horas Trabalhadas
  worked_hours    Decimal       @default(0) @db.Decimal(8,2)
  extra_hours     Decimal       @default(0) @db.Decimal(8,2)
  night_hours     Decimal       @default(0) @db.Decimal(8,2)
  sunday_hours    Decimal       @default(0) @db.Decimal(8,2)
  holiday_hours   Decimal       @default(0) @db.Decimal(8,2)
  
  // Faltas e Atrasos
  absences        Int           @default(0)
  late_minutes    Int           @default(0)
  
  // Proventos (Ganhos)
  base_amount     Decimal       @default(0) @db.Decimal(10,2)
  extra_amount    Decimal       @default(0) @db.Decimal(10,2)
  night_amount    Decimal       @default(0) @db.Decimal(10,2)
  sunday_amount   Decimal       @default(0) @db.Decimal(10,2)
  holiday_amount  Decimal       @default(0) @db.Decimal(10,2)
  bonus_amount    Decimal       @default(0) @db.Decimal(10,2)
  commission_amount Decimal     @default(0) @db.Decimal(10,2)
  other_earnings  Json?         @db.Json
  total_earnings  Decimal       @default(0) @db.Decimal(10,2)
  
  // Descontos
  inss_discount   Decimal       @default(0) @db.Decimal(10,2)
  irrf_discount   Decimal       @default(0) @db.Decimal(10,2)
  transport_discount Decimal    @default(0) @db.Decimal(10,2)
  meal_discount   Decimal       @default(0) @db.Decimal(10,2)
  advance_discount Decimal      @default(0) @db.Decimal(10,2)
  loan_discount   Decimal       @default(0) @db.Decimal(10,2)
  other_discounts Json?         @db.Json
  total_discounts Decimal       @default(0) @db.Decimal(10,2)
  
  // Valores Líquidos
  net_salary      Decimal       @default(0) @db.Decimal(10,2)
  
  // FGTS
  fgts_base       Decimal       @default(0) @db.Decimal(10,2)
  fgts_amount     Decimal       @default(0) @db.Decimal(10,2)
  
  // Férias
  vacation_days   Int           @default(0)
  vacation_amount Decimal       @default(0) @db.Decimal(10,2)
  vacation_advance Decimal      @default(0) @db.Decimal(10,2)
  
  // 13º Salário
  thirteenth_amount Decimal     @default(0) @db.Decimal(10,2)
  thirteenth_advance Decimal    @default(0) @db.Decimal(10,2)
  
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  updated_at      DateTime      @default(now()) @db.Timestamp(6)
  
  // Relations
  payroll_period  PayrollPeriod @relation(fields: [payroll_period_id], references: [id])
  employee        employees     @relation(fields: [employee_id], references: [id])

  @@index([payroll_period_id], map: "idx_payroll_items_period")
  @@index([employee_id], map: "idx_payroll_items_employee")
  @@map("payroll_items")
}

model Payslip {
  id              String        @id @default(cuid()) @db.VarChar(50)
  payroll_period_id String      @db.VarChar(50)
  employee_id     String        @db.VarChar(50)
  
  // Identificação
  payslip_number  String        @db.VarChar(50)
  reference_period String       @db.VarChar(20) // "01/2025"
  
  // Dados da Empresa
  company_name    String        @db.VarChar(255)
  company_cnpj    String?       @db.VarChar(18)
  company_address String?       @db.Text
  
  // Dados do Funcionário
  employee_name   String        @db.VarChar(255)
  employee_cpf    String        @db.VarChar(14)
  employee_pis    String?       @db.VarChar(15)
  position        String        @db.VarChar(100)
  admission_date  DateTime      @db.Timestamp(6)
  
  // Resumo Financeiro
  total_earnings  Decimal       @db.Decimal(10,2)
  total_discounts Decimal       @db.Decimal(10,2)
  net_salary      Decimal       @db.Decimal(10,2)
  fgts_amount     Decimal       @db.Decimal(10,2)
  
  // Detalhamento JSON
  earnings_detail Json          @db.Json
  discounts_detail Json         @db.Json
  
  // Controle
  generated_at    DateTime      @default(now()) @db.Timestamp(6)
  sent_at         DateTime?     @db.Timestamp(6)
  viewed_at       DateTime?     @db.Timestamp(6)
  
  // Relations
  payroll_period  PayrollPeriod @relation(fields: [payroll_period_id], references: [id])
  employee        employees     @relation(fields: [employee_id], references: [id])

  @@unique([payroll_period_id, employee_id])
  @@index([employee_id], map: "idx_payslips_employee")
  @@index([reference_period], map: "idx_payslips_period")
  @@map("payslips")
}

model PayrollConfiguration {
  id              String   @id @default(cuid()) @db.VarChar(50)
  user_id         String   @unique @db.Uuid
  
  // Configurações Gerais
  company_name    String   @db.VarChar(255)
  company_cnpj    String?  @db.VarChar(18)
  company_address String?  @db.Text
  
  // Configurações de Cálculo
  inss_rates      Json     @db.Json // Tabelas INSS
  irrf_rates      Json     @db.Json // Tabelas IR
  fgts_rate       Decimal  @default(8.0) @db.Decimal(5,2)
  
  // Configurações de Benefícios
  transport_percentage Decimal @default(6.0) @db.Decimal(5,2)
  meal_discount   Decimal  @default(0) @db.Decimal(10,2)
  
  // Configurações de Período
  payment_day     Int      @default(5) // Dia do pagamento
  cutoff_day      Int      @default(25) // Dia de fechamento
  
  // Configurações de Férias
  vacation_advance_percentage Decimal @default(33.33) @db.Decimal(5,2)
  vacation_bonus  Boolean  @default(true)
  
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)
  
  // Relations
  user            users    @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "idx_payroll_config_user")
  @@map("payroll_configurations")
}

model TimeEntry {
  id              String   @id @default(cuid()) @db.VarChar(50)
  employee_id     String   @db.VarChar(50)
  entry_date      DateTime @db.Date
  
  // Horários
  clock_in_1      DateTime? @db.Timestamp(6) // Entrada manhã
  clock_out_1     DateTime? @db.Timestamp(6) // Saída almoço
  clock_in_2      DateTime? @db.Timestamp(6) // Volta almoço
  clock_out_2     DateTime? @db.Timestamp(6) // Saída final
  
  // Horas Extras
  extra_start     DateTime? @db.Timestamp(6)
  extra_end       DateTime? @db.Timestamp(6)
  
  // Cálculos Automáticos
  total_hours     Decimal   @default(0) @db.Decimal(8,2)
  regular_hours   Decimal   @default(0) @db.Decimal(8,2)
  extra_hours     Decimal   @default(0) @db.Decimal(8,2)
  night_hours     Decimal   @default(0) @db.Decimal(8,2)
  
  // Status e Observações
  status          String    @default("normal") @db.VarChar(20) // normal, absence, holiday, vacation
  absence_type    String?   @db.VarChar(50) // sick, personal, justified, unjustified
  notes           String?   @db.Text
  
  // Geolocalização (opcional)
  clock_in_location String? @db.VarChar(255)
  clock_out_location String? @db.VarChar(255)
  
  // Controle
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)
  
  // Relations
  employee        employees @relation(fields: [employee_id], references: [id])

  @@unique([employee_id, entry_date])
  @@index([employee_id], map: "idx_time_entries_employee")
  @@index([entry_date], map: "idx_time_entries_date")
  @@index([status], map: "idx_time_entries_status")
  @@map("time_entries")
}

// Consentimentos LGPD
model UserConsent {
  id                String    @id @default(cuid()) @db.VarChar(50)
  user_id           String?   @db.Uuid
  users             users?    @relation(fields: [user_id], references: [id])
  cpf               String?   @db.VarChar(14)
  termsAccepted     Boolean
  privacyAccepted   Boolean
  marketingAccepted Boolean?
  user_agent        String?   @db.VarChar(255)
  ip_address        String?   @db.VarChar(50)
  created_at        DateTime  @default(now()) @db.Timestamp(6)

  @@index([user_id], map: "idx_user_consents_user_id")
  @@index([cpf], map: "idx_user_consents_cpf")
  @@map("user_consents")
}

// Registros de Ponto
model TimeClockEntry {
  id         String    @id @default(cuid()) @db.VarChar(50)
  user_id    String?   @db.Uuid
  users      users?    @relation(fields: [user_id], references: [id])
  type       String    @db.VarChar(10)
  note       String?   @db.VarChar(255)
  timestamp  DateTime  @default(now()) @db.Timestamp(6)
  created_at DateTime  @default(now()) @db.Timestamp(6)

  @@index([user_id], map: "idx_timeclock_user_id")
  @@index([timestamp], map: "idx_timeclock_timestamp")
  @@map("timeclock_entries")
}
