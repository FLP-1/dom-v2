  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @db.Timestamp(6)
  
  user        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  context     DomesticContext? @relation(fields: [contextId], references: [id], onDelete: Cascade)
  
  @@unique([userId, roleType, contextId])
  @@index([userId], map: "idx_user_roles_user_id")
  @@index([roleType], map: "idx_user_roles_role_type")
  @@index([contextId], map: "idx_user_roles_context_id")
  @@index([active], map: "idx_user_roles_active")
  @@map("user_roles")
}

model DomesticContext {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  type      String   @db.VarChar(50) // 'family', 'business', 'partnership'
  ownerId   String   @db.Uuid
  members   Json     @default("[]")
  settings  Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
  
  owner     users      @relation(fields: [ownerId], references: [id])
  roles     UserRole[]
  employments EmploymentRelationship[]
  families   FamilyRelationship[]
  
  @@index([ownerId], map: "idx_domestic_contexts_owner_id")
  @@index([type], map: "idx_domestic_contexts_type")
  @@index([active], map: "idx_domestic_contexts_active")
  @@map("domestic_contexts")
}

model EmploymentRelationship {
  id           String   @id @default(cuid())
  employerId   String   @db.Uuid
  employeeId   String   @db.Uuid
  contextId    String   @default(cuid())
  position     String   @db.VarChar(100)
  salary       Decimal  @db.Decimal(10, 2)
  startDate    DateTime @db.Date
  endDate      DateTime? @db.Date
  status       String   @default("active") @db.VarChar(20)
  contractType String   @db.VarChar(50) // 'formal', 'informal', 'temporary'
  permissions  Json     @default("{}")
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @db.Timestamp(6)
  
  employer    users            @relation("EmploymentEmployer", fields: [employerId], references: [id])
  employee    users            @relation("EmploymentEmployee", fields: [employeeId], references: [id])
  context     DomesticContext  @relation(fields: [contextId], references: [id], onDelete: Cascade)
  
  @@unique([employerId, employeeId, contextId])
  @@index([employerId], map: "idx_employment_relationships_employer_id")
  @@index([employeeId], map: "idx_employment_relationships_employee_id")
  @@index([contextId], map: "idx_employment_relationships_context_id")
  @@index([status], map: "idx_employment_relationships_status")
  @@map("employment_relationships")
}

model FamilyRelationship {
  id               String   @id @default(cuid())
  familyContextId  String   @default(cuid())
  memberId         String   @db.Uuid
  relationshipType String   @db.VarChar(50) // 'spouse', 'child', 'parent', 'sibling'
  permissions      Json     @default("{}")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamp(6)
  
  familyContext    DomesticContext @relation(fields: [familyContextId], references: [id], onDelete: Cascade)
  member           users           @relation(fields: [memberId], references: [id])
  
  @@unique([familyContextId, memberId])
  @@index([familyContextId], map: "idx_family_relationships_family_context_id")
  @@index([memberId], map: "idx_family_relationships_member_id")
  @@index([relationshipType], map: "idx_family_relationships_type")
  @@index([active], map: "idx_family_relationships_active")
  @@map("family_relationships")
}

model UserProfile {
  id                String   @id @default(cuid()) @db.VarChar(50)
  userId            String   @db.Uuid
  profileType       String   @db.VarChar(50) // 'employer', 'employee', 'family', 'partner', 'system_owner'
  contextId         String?  @db.VarChar(50) // ID do contexto (família, empresa, etc.)
  contextType       String?  @db.VarChar(50) // 'family', 'business', 'system'
  isPrimary         Boolean  @default(false) // Se é o perfil principal do usuário
  isActive          Boolean  @default(true)
  permissions       Json?    @default("{}") @db.Json
  metadata          Json?    @default("{}") @db.Json // Dados específicos do perfil
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @default(now()) @db.Timestamp(6)
  user              users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, profileType, contextId])
  @@index([userId], map: "idx_user_profiles_user_id")
  @@index([profileType], map: "idx_user_profiles_type")
  @@index([contextId], map: "idx_user_profiles_context")
  @@index([isPrimary], map: "idx_user_profiles_primary")
  @@map("user_profiles")
}

// Modelos para Sistema de Relatórios Avançados e Analytics
model Report {
  id          String   @id @default(cuid()) @db.VarChar(50)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  type        String   @db.VarChar(50) // 'financial', 'hr', 'productivity', 'custom'
  category    String   @db.VarChar(100)
  template    Json?    @db.Json // Configuração do template do relatório
  filters     Json?    @db.Json // Filtros aplicados
  parameters  Json?    @db.Json // Parâmetros do relatório
  schedule    Json?    @db.Json // Configuração de agendamento
  is_public   Boolean  @default(false)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
  user_id     String   @db.Uuid
  user        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  executions  ReportExecution[]

  @@index([user_id], map: "idx_reports_user_id")
  @@index([type], map: "idx_reports_type")
  @@index([category], map: "idx_reports_category")
  @@index([is_active], map: "idx_reports_active")
  @@map("reports")
}

model ReportExecution {
  id         String   @id @default(cuid()) @db.VarChar(50)
  report_id  String   @db.VarChar(50)
  status     String   @db.VarChar(20) // 'pending', 'running', 'completed', 'failed'
  started_at DateTime @default(now()) @db.Timestamp(6)
  completed_at DateTime? @db.Timestamp(6)
  duration   Int? // Duração em segundos
  result     Json? @db.Json // Resultados do relatório
  error      String? @db.Text
  parameters Json? @db.Json // Parâmetros usados na execução
  user_id    String @db.Uuid
  user       users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  report     Report @relation(fields: [report_id], references: [id], onDelete: Cascade)

  @@index([report_id], map: "idx_report_executions_report_id")
  @@index([status], map: "idx_report_executions_status")
  @@index([user_id], map: "idx_report_executions_user_id")
  @@index([started_at], map: "idx_report_executions_started_at")
  @@map("report_executions")
}

model AnalyticsEvent {
  id          String   @id @default(cuid()) @db.VarChar(50)
  event_type  String   @db.VarChar(100)
  event_name  String   @db.VarChar(200)
  user_id     String   @db.Uuid
  session_id  String?  @db.VarChar(100)
  page_url    String?  @db.VarChar(500)
  user_agent  String?  @db.Text
  ip_address  String?  @db.VarChar(45)
  metadata    Json?    @db.Json
  created_at  DateTime @default(now()) @db.Timestamp(6)
  user        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_analytics_events_user_id")
  @@index([event_type], map: "idx_analytics_events_type")
  @@index([event_name], map: "idx_analytics_events_name")
  @@index([created_at], map: "idx_analytics_events_created_at")
  @@map("analytics_events")
}

model DashboardWidget {
  id          String   @id @default(cuid()) @db.VarChar(50)
  name        String   @db.VarChar(200)
  type        String   @db.VarChar(50) // 'chart', 'metric', 'table', 'list'
  position    Json     @db.Json // Posição no dashboard (x, y, width, height)
  config      Json     @db.Json // Configuração do widget
  data_source String?  @db.VarChar(200) // Fonte de dados
  refresh_interval Int? // Intervalo de atualização em segundos
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
  user_id     String   @db.Uuid
  user        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_dashboard_widgets_user_id")
  @@index([type], map: "idx_dashboard_widgets_type")
  @@index([is_active], map: "idx_dashboard_widgets_active")
  @@map("dashboard_widgets")
}

// Modelos para Sistema de Qualidade e Inspeção
model QualityCheck {
  id          String   @id @default(cuid()) @db.VarChar(50)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  category    String   @db.VarChar(100) // 'cleaning', 'maintenance', 'organization', 'safety'
  priority    String   @db.VarChar(20) // 'low', 'medium', 'high', 'critical'
  status      String   @db.VarChar(20) // 'pending', 'in_progress', 'completed', 'failed'
  score       Int? // Pontuação de 0-100
  notes       String?  @db.Text
  before_photo String? @db.VarChar(500) // URL da foto antes
  after_photo  String? @db.VarChar(500) // URL da foto depois
  completed_at DateTime? @db.Timestamp(6)
  created_at   DateTime @default(now()) @db.Timestamp(6)
  updated_at   DateTime @default(now()) @db.Timestamp(6)
  user_id     String   @db.Uuid
  assigned_to String?  @db.Uuid
  user        users    @relation("QualityCheckCreator", fields: [user_id], references: [id], onDelete: Cascade)
  assigned_user users? @relation("QualityCheckAssigned", fields: [assigned_to], references: [id], onDelete: SetNull)

  @@index([user_id], map: "idx_quality_checks_user_id")
  @@index([assigned_to], map: "idx_quality_checks_assigned_to")
  @@index([category], map: "idx_quality_checks_category")
  @@index([status], map: "idx_quality_checks_status")
  @@index([priority], map: "idx_quality_checks_priority")
  @@map("quality_checks")
}

model QualityTemplate {
  id          String   @id @default(cuid()) @db.VarChar(50)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  category    String   @db.VarChar(100)
  items       Json     @db.Json // Array de itens do checklist
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
  user_id     String   @db.Uuid
  user        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_quality_templates_user_id")
  @@index([category], map: "idx_quality_templates_category")
  @@index([is_active], map: "idx_quality_templates_active")
  @@map("quality_templates")
}

model QualityReport {
  id          String   @id @default(cuid()) @db.VarChar(50)
  title       String   @db.VarChar(200)
  description String?  @db.Text
  period      String   @db.VarChar(50) // 'daily', 'weekly', 'monthly'
  start_date  DateTime @db.Timestamp(6)
  end_date    DateTime @db.Timestamp(6)
  total_checks Int     @default(0)
  completed_checks Int @default(0)
  failed_checks Int    @default(0)
  average_score Decimal? @db.Decimal(5,2)
  summary     Json?    @db.Json // Resumo dos resultados
  created_at  DateTime @default(now()) @db.Timestamp(6)
  user_id     String   @db.Uuid
  user        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_quality_reports_user_id")
  @@index([period], map: "idx_quality_reports_period")
  @@index([start_date], map: "idx_quality_reports_start_date")
  @@map("quality_reports")
}
