generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Budget {
  id         String   @id @db.VarChar(50)
  name       String   @db.VarChar(200)
  amount     Float
  spent      Float    @default(0)
  category   String   @db.VarChar(100)
  start_date DateTime @db.Timestamp(6)
  end_date   DateTime @db.Timestamp(6)
  status     String   @default("active") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  user_id    String?  @db.Uuid
  users      users?   @relation(fields: [user_id], references: [id])

  @@index([category], map: "idx_budgets_category")
  @@index([status], map: "idx_budgets_status")
  @@index([user_id], map: "idx_budgets_user_id")
  @@map("budgets")
}

model employees {
  id            String        @id @db.VarChar(50)
  name          String        @db.VarChar(200)
  cpf           String        @unique @db.VarChar(14)
  position      String        @db.VarChar(100)
  salary        Float
  status        String        @default("active") @db.VarChar(20)
  created_at    DateTime      @default(now()) @db.Timestamp(6)
  updated_at    DateTime      @default(now()) @db.Timestamp(6)
  user_id       String?       @db.Uuid
  documents     Document[]
  users         users?        @relation(fields: [user_id], references: [id])
  payroll_items PayrollItem[]
  payrolls      payrolls[]
  payslips      Payslip[]
  time_entries  TimeEntry[]

  @@index([cpf], map: "idx_employees_cpf")
  @@index([status], map: "idx_employees_status")
  @@index([user_id], map: "idx_employees_user_id")
}

model groups {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @db.VarChar(255)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  description      String?
  type             String?            @db.VarChar(50)
  active           Boolean            @default(true)
  messages         Message[]
  user_group_roles user_group_roles[]
  user_sessions    user_sessions[]
}

model notifications {
  id           String    @id @db.VarChar(50)
  type         String    @db.VarChar(50)
  title        String    @db.VarChar(200)
  message      String
  recipient_id String    @db.VarChar(50)
  sender_id    String?   @db.VarChar(50)
  read         Boolean?
  created_at   DateTime? @db.Timestamp(6)
  read_at      DateTime? @db.Timestamp(6)
  extra_data   Json?     @db.Json
  priority     String?   @db.VarChar(20)
  category     String?   @db.VarChar(50)
  active       Boolean?
  updated_at   DateTime? @db.Timestamp(6)

  @@index([id], map: "ix_notifications_id")
}

model Payment {
  id          String   @id @db.VarChar(50)
  amount      Float
  description String   @db.VarChar(500)
  status      String   @default("pending") @db.VarChar(20)
  due_date    DateTime @db.Timestamp(6)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
  user_id     String?  @db.Uuid
  users       users?   @relation(fields: [user_id], references: [id])

  @@index([due_date], map: "idx_payments_due_date")
  @@index([status], map: "idx_payments_status")
  @@index([user_id], map: "idx_payments_user_id")
  @@map("payments")
}

model payrolls {
  id             String     @id @db.VarChar(50)
  employee_code  String     @db.VarChar(50)
  employee_name  String     @db.VarChar(200)
  base_salary    Float
  overtime_hours Float      @default(0)
  overtime_rate  Float      @default(1.5)
  bonuses        Float      @default(0)
  deductions     Float      @default(0)
  inss           Float      @default(0)
  irrf           Float      @default(0)
  fgts           Float      @default(0)
  net_salary     Float      @default(0)
  gross_salary   Float      @default(0)
  month          Int
  year           Int
  status         String     @default("pending") @db.VarChar(20)
  created_at     DateTime   @default(now()) @db.Timestamp(6)
  updated_at     DateTime   @default(now()) @db.Timestamp(6)
  user_id        String?    @db.Uuid
  employee_id    String?    @db.VarChar(50)
  employees      employees? @relation(fields: [employee_id], references: [id])
  users          users?     @relation(fields: [user_id], references: [id])

  @@index([employee_id], map: "idx_payrolls_employee_id")
  @@index([month, year], map: "idx_payrolls_month_year")
  @@index([status], map: "idx_payrolls_status")
  @@index([user_id], map: "idx_payrolls_user_id")
}

model purchases {
  id          String   @id @db.VarChar(50)
  title       String   @db.VarChar(200)
  description String?
  amount      Float
  status      String   @default("pending") @db.VarChar(20)
  category    String?  @db.VarChar(100)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
  user_id     String?  @db.Uuid
  users       users?   @relation(fields: [user_id], references: [id])

  @@index([category], map: "idx_purchases_category")
  @@index([status], map: "idx_purchases_status")
  @@index([user_id], map: "idx_purchases_user_id")
}

model tasks {
  id             String    @id @db.VarChar(50)
  title          String    @db.VarChar(200)
  description    String?
  status         String    @db.VarChar(20)
  priority       Int?
  created_at     DateTime? @db.Timestamp(6)
  due_date       DateTime? @db.Timestamp(6)
  completed_at   DateTime? @db.Timestamp(6)
  creator_id     String    @db.Uuid
  responsible_id String?   @db.Uuid
  category       String?   @db.VarChar(50)
  tags           Json?     @db.Json
  attachments    Json?     @db.Json
  comments       Json?     @db.Json
  active         Boolean?
  updated_at     DateTime? @db.Timestamp(6)

  @@index([id], map: "ix_tasks_id")
}

model user_group_roles {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  group_id   String    @db.Uuid
  role       String    @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  ativo      Boolean   @default(true)
  groups     groups    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, group_id])
  @@index([group_id], map: "idx_user_group_roles_group_id")
  @@index([user_id], map: "idx_user_group_roles_user_id")
}

model user_sessions {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String    @db.Uuid
  session_token           String    @unique @db.VarChar(255)
  active_group_id         String?   @db.Uuid
  active_role             String?   @db.VarChar(50)
  expires_at              DateTime  @db.Timestamp(6)
  created_at              DateTime? @default(now()) @db.Timestamp(6)
  updated_at              DateTime? @default(now()) @db.Timestamp(6)
  active_context_group_id String?   @db.Uuid
  active_context_role     String?   @db.VarChar(50)
  user_agent              String?   @db.VarChar(255)
  ip_address              String?   @db.VarChar(50)
  groups                  groups?   @relation(fields: [active_group_id], references: [id], onUpdate: NoAction)
  users                   users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_token], map: "idx_user_sessions_token")
  @@index([user_id], map: "idx_user_sessions_user_id")
}

model users {
  id                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String                @db.VarChar(255)
  nickname                  String?               @unique @db.VarChar(50)
  cpf                       String                @unique @db.VarChar(14) // Aumentado para suportar CPF formatado
  email                     String                @unique @db.VarChar(255)
  user_photo                Bytes?
  password_hash             String                @db.VarChar(255)
  created_at                DateTime?             @default(now()) @db.Timestamp(6)
  updated_at                DateTime?             @default(now()) @db.Timestamp(6)
  phone                     String?               @db.VarChar(20)
  profile                   String?               @default("employer") @db.VarChar(20) // Perfil principal/dominante
  active                    Boolean?              @default(true)
  last_login                DateTime?             @db.Timestamp(6)
  platforms                 Json?                 @default("[]") @db.Json
  permissions               Json?                 @default("[]") @db.Json
  budgets                   Budget[]
  shared_documents_sent     DocumentShare[]       @relation("DocumentShareSender")
  shared_documents_received DocumentShare[]       @relation("DocumentShareReceiver")
  document_versions         DocumentVersion[]
  documents                 Document[]
  employees                 employees[]
  esocial_certificates      ESocialCertificate[]
  esocial_config            ESocialConfig?
  esocial_events            ESocialEvent[]
  message_reads             MessageRead[]
  messages                  Message[]
  partner_links             PartnerEmployerLink[]
  partner_profile           PartnerProfile?
  partner_reviews           PartnerReview[]
  payments                  Payment[]
  payroll_configurations    PayrollConfiguration?
  payroll_periods           PayrollPeriod[]
  payrolls                  payrolls[]
  purchases                 purchases[]
  service_bookings          ServiceBooking[]
  subscriptions             Subscription[]
  supplier_orders           SupplierOrder[]
  supplier_profile          SupplierProfile?
  timeclock_entries         TimeClockEntry[]
  user_achievements         UserAchievement[]
  user_challenges           UserChallenge[]
  user_consents             UserConsent[]
  user_group_roles          user_group_roles[]
  user_points               UserPoints[]
  user_sessions             user_sessions[]
  user_settings             UserSettings?
  white_label_configs       WhiteLabelConfig[]
  user_roles                UserRole[]
  user_profiles             UserProfile[]         // Novos perfis específicos
  ownedContexts             DomesticContext[]
  employmentAsEmployer      EmploymentRelationship[] @relation("EmploymentEmployer")
  employmentAsEmployee      EmploymentRelationship[] @relation("EmploymentEmployee")
  familyMemberships         FamilyRelationship[]
          reports                   Report[]
        report_executions         ReportExecution[]
        analytics_events          AnalyticsEvent[]
        dashboard_widgets         DashboardWidget[]
        quality_checks_created    QualityCheck[] @relation("QualityCheckCreator")
        quality_checks_assigned   QualityCheck[] @relation("QualityCheckAssigned")
        quality_templates         QualityTemplate[]
        quality_reports           QualityReport[]

  @@index([active], map: "idx_users_active")
  @@index([cpf], map: "idx_users_cpf")
  @@index([email], map: "idx_users_email")
  @@index([profile], map: "idx_users_profile")
}

model Message {
  id          String        @id @default(cuid()) @db.VarChar(50)
  content     String
  type        String        @default("text") @db.VarChar(20)
  sender_id   String        @db.Uuid
  group_id    String?       @db.Uuid
  reply_to_id String?       @db.VarChar(50)
  metadata    Json?         @db.Json
  status      String        @default("sent") @db.VarChar(20)
  created_at  DateTime      @default(now()) @db.Timestamp(6)
  updated_at  DateTime      @default(now()) @db.Timestamp(6)
  active      Boolean       @default(true)
  reads       MessageRead[]
  group       groups?       @relation(fields: [group_id], references: [id])
  reply_to    Message?      @relation("MessageReplies", fields: [reply_to_id], references: [id])
  replies     Message[]     @relation("MessageReplies")
  sender      users         @relation(fields: [sender_id], references: [id])

  @@index([sender_id], map: "idx_messages_sender_id")
  @@index([group_id], map: "idx_messages_group_id")
  @@index([created_at], map: "idx_messages_created_at")
  @@index([status], map: "idx_messages_status")
  @@map("messages")
}

model MessageRead {
  id         String   @id @default(cuid()) @db.VarChar(50)
  message_id String   @db.VarChar(50)
  user_id    String   @db.Uuid
  read_at    DateTime @default(now()) @db.Timestamp(6)
  message    Message  @relation(fields: [message_id], references: [id])
  user       users    @relation(fields: [user_id], references: [id])

  @@unique([message_id, user_id])
  @@index([user_id], map: "idx_message_reads_user_id")
  @@index([message_id], map: "idx_message_reads_message_id")
  @@map("message_reads")
}

model Achievement {
  id                String            @id @default(cuid()) @db.VarChar(50)
  name              String            @db.VarChar(100)
  description       String?           @db.VarChar(500)
  icon              String?           @db.VarChar(50)
  category          String            @db.VarChar(50)
  type              String            @db.VarChar(30)
  criteria          Json              @db.Json
  points            Int               @default(0)
  rarity            String            @default("common") @db.VarChar(20)
  active            Boolean           @default(true)
  created_at        DateTime          @default(now()) @db.Timestamp(6)
  updated_at        DateTime          @default(now()) @db.Timestamp(6)
  user_achievements UserAchievement[]

  @@index([category], map: "idx_achievements_category")
  @@index([type], map: "idx_achievements_type")
  @@index([active], map: "idx_achievements_active")
  @@map("achievements")
}

model UserAchievement {
  id             String      @id @default(cuid()) @db.VarChar(50)
  user_id        String      @db.Uuid
  achievement_id String      @db.VarChar(50)
  unlocked_at    DateTime    @default(now()) @db.Timestamp(6)
  progress       Json?       @db.Json
  achievement    Achievement @relation(fields: [achievement_id], references: [id])
  user           users       @relation(fields: [user_id], references: [id])

  @@unique([user_id, achievement_id])
  @@index([user_id], map: "idx_user_achievements_user_id")
  @@index([achievement_id], map: "idx_user_achievements_achievement_id")
  @@map("user_achievements")
}

model UserPoints {
  id           String   @id @default(cuid()) @db.VarChar(50)
  user_id      String   @db.Uuid
  action       String   @db.VarChar(100)
  points       Int
  category     String   @db.VarChar(50)
  reference_id String?  @db.VarChar(50)
  metadata     Json?    @db.Json
  created_at   DateTime @default(now()) @db.Timestamp(6)
  user         users    @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "idx_user_points_user_id")
  @@index([action], map: "idx_user_points_action")
  @@index([category], map: "idx_user_points_category")
  @@index([created_at], map: "idx_user_points_created_at")
  @@map("user_points")
}

model Challenge {
  id              String          @id @default(cuid()) @db.VarChar(50)
  name            String          @db.VarChar(100)
  description     String?         @db.VarChar(500)
  type            String          @db.VarChar(30)
  category        String          @db.VarChar(50)
  criteria        Json            @db.Json
  reward_points   Int             @default(0)
  reward_badge    String?         @db.VarChar(50)
  start_date      DateTime        @db.Timestamp(6)
  end_date        DateTime        @db.Timestamp(6)
  active          Boolean         @default(true)
  created_at      DateTime        @default(now()) @db.Timestamp(6)
  updated_at      DateTime        @default(now()) @db.Timestamp(6)
  user_challenges UserChallenge[]

  @@index([type], map: "idx_challenges_type")
  @@index([category], map: "idx_challenges_category")
  @@index([active], map: "idx_challenges_active")
  @@index([start_date, end_date], map: "idx_challenges_dates")
  @@map("challenges")
}

model UserChallenge {
  id           String    @id @default(cuid()) @db.VarChar(50)
  user_id      String    @db.Uuid
  challenge_id String    @db.VarChar(50)
  status       String    @default("active") @db.VarChar(20)
  progress     Json?     @db.Json
  started_at   DateTime  @default(now()) @db.Timestamp(6)
  completed_at DateTime? @db.Timestamp(6)
  challenge    Challenge @relation(fields: [challenge_id], references: [id])
  user         users     @relation(fields: [user_id], references: [id])

  @@unique([user_id, challenge_id])
  @@index([user_id], map: "idx_user_challenges_user_id")
  @@index([challenge_id], map: "idx_user_challenges_challenge_id")
  @@index([status], map: "idx_user_challenges_status")
  @@map("user_challenges")
}

model UserSettings {
  id            String   @id @default(cuid()) @db.VarChar(50)
  user_id       String   @unique @db.Uuid
  theme         Json     @default("{}") @db.Json
  preferences   Json     @default("{}") @db.Json
  ui_config     Json     @default("{}") @db.Json
  notifications Json     @default("{}") @db.Json
  privacy       Json     @default("{}") @db.Json
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @default(now()) @db.Timestamp(6)
  user          users    @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "idx_user_settings_user_id")
  @@map("user_settings")
}

model SubscriptionPlan {
  id            String         @id @default(cuid()) @db.VarChar(50)
  name          String         @db.VarChar(100)
  description   String?
  price         Decimal        @db.Decimal(10, 2)
  currency      String         @default("BRL") @db.VarChar(3)
  interval      String         @db.VarChar(20)
  features      Json           @db.Json
  limits        Json           @db.Json
  active        Boolean        @default(true)
  created_at    DateTime       @default(now()) @db.Timestamp(6)
  updated_at    DateTime       @default(now()) @db.Timestamp(6)
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                   String           @id @default(cuid()) @db.VarChar(50)
  user_id              String           @db.Uuid
  plan_id              String           @db.VarChar(50)
  status               String           @db.VarChar(20)
  current_period_start DateTime         @db.Timestamp(6)
  current_period_end   DateTime         @db.Timestamp(6)
  cancel_at_period_end Boolean          @default(false)
  cancelled_at         DateTime?        @db.Timestamp(6)
  trial_start          DateTime?        @db.Timestamp(6)
  trial_end            DateTime?        @db.Timestamp(6)
  metadata             Json?            @db.Json
  created_at           DateTime         @default(now()) @db.Timestamp(6)
  updated_at           DateTime         @default(now()) @db.Timestamp(6)
  commissions          Commission[]
  payments             PaymentRecord[]
  plan                 SubscriptionPlan @relation(fields: [plan_id], references: [id])
  user                 users            @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "idx_subscriptions_user_id")
  @@index([status], map: "idx_subscriptions_status")
  @@map("subscriptions")
}

model PaymentRecord {
  id              String       @id @default(cuid()) @db.VarChar(50)
  subscription_id String       @db.VarChar(50)
  amount          Decimal      @db.Decimal(10, 2)
  currency        String       @default("BRL") @db.VarChar(3)
  status          String       @db.VarChar(20)
  payment_method  String       @db.VarChar(50)
  external_id     String?      @db.VarChar(100)
  paid_at         DateTime?    @db.Timestamp(6)
  metadata        Json?        @db.Json
  created_at      DateTime     @default(now()) @db.Timestamp(6)
  commissions     Commission[]
  subscription    Subscription @relation(fields: [subscription_id], references: [id])

  @@index([subscription_id], map: "idx_payment_records_subscription")
  @@index([status], map: "idx_payment_records_status")
  @@map("payment_records")
}

model PartnerProfile {
  id                  String                @id @default(cuid()) @db.VarChar(50)
  user_id             String                @unique @db.Uuid
  company_name        String                @db.VarChar(255)
  cnpj                String?               @db.VarChar(18)
  service_type        String                @db.VarChar(100)
  description         String?
  service_area        Json                  @db.Json
  price_range         Json                  @db.Json
  availability        Json                  @db.Json
  rating              Decimal?              @db.Decimal(3, 2)
  total_reviews       Int                   @default(0)
  verified            Boolean               @default(false)
  active              Boolean               @default(true)
  white_label_enabled Boolean               @default(false)
  brand_name          String?               @db.VarChar(255)
  brand_logo_url      String?               @db.VarChar(500)
  brand_colors        Json?                 @db.Json
  custom_domain       String?               @db.VarChar(255)
  custom_subdomain    String?               @unique @db.VarChar(100)
  brand_settings      Json?                 @db.Json
  commission_enabled  Boolean               @default(false)
  commission_type     String?               @db.VarChar(20)
  commission_rate     Decimal?              @db.Decimal(5, 2)
  commission_tiers    Json?                 @db.Json
  payment_terms       Json?                 @db.Json
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @default(now()) @db.Timestamp(6)
  commissions         Commission[]
  linked_employers    PartnerEmployerLink[]
  user                users                 @relation(fields: [user_id], references: [id])
  reviews             PartnerReview[]
  services            PartnerService[]
  white_label_configs WhiteLabelConfig[]

  @@index([service_type], map: "idx_partner_profiles_service_type")
  @@index([verified], map: "idx_partner_profiles_verified")
  @@index([custom_subdomain], map: "idx_partner_profiles_subdomain")
  @@index([white_label_enabled], map: "idx_partner_profiles_white_label")
  @@map("partner_profiles")
}

model PartnerService {
  id          String           @id @default(cuid()) @db.VarChar(50)
  partner_id  String           @db.VarChar(50)
  name        String           @db.VarChar(255)
  description String?
  price       Decimal          @db.Decimal(10, 2)
  unit        String           @db.VarChar(50)
  active      Boolean          @default(true)
  created_at  DateTime         @default(now()) @db.Timestamp(6)
  partner     PartnerProfile   @relation(fields: [partner_id], references: [id])
  bookings    ServiceBooking[]

  @@index([partner_id], map: "idx_partner_services_partner")
  @@map("partner_services")
}

model PartnerReview {
  id         String         @id @default(cuid()) @db.VarChar(50)
  partner_id String         @db.VarChar(50)
  user_id    String         @db.Uuid
  rating     Int            @db.SmallInt
  comment    String?
  created_at DateTime       @default(now()) @db.Timestamp(6)
  partner    PartnerProfile @relation(fields: [partner_id], references: [id])
  user       users          @relation(fields: [user_id], references: [id])

  @@index([partner_id], map: "idx_partner_reviews_partner")
  @@map("partner_reviews")
}

model ServiceBooking {
  id             String         @id @default(cuid()) @db.VarChar(50)
  service_id     String         @db.VarChar(50)
  user_id        String         @db.Uuid
  scheduled_date DateTime       @db.Timestamp(6)
  status         String         @db.VarChar(20)
  total_price    Decimal        @db.Decimal(10, 2)
  notes          String?
  created_at     DateTime       @default(now()) @db.Timestamp(6)
  updated_at     DateTime       @default(now()) @db.Timestamp(6)
  service        PartnerService @relation(fields: [service_id], references: [id])
  user           users          @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "idx_service_bookings_user")
  @@index([status], map: "idx_service_bookings_status")
  @@map("service_bookings")
}

model SupplierProfile {
  id             String            @id @default(cuid()) @db.VarChar(50)
  user_id        String            @unique @db.Uuid
  company_name   String            @db.VarChar(255)
  cnpj           String?           @db.VarChar(18)
  supplier_type  String            @db.VarChar(100)
  description    String?
  delivery_areas Json              @db.Json
  min_order      Decimal?          @db.Decimal(10, 2)
  payment_terms  Json              @db.Json
  rating         Decimal?          @db.Decimal(3, 2)
  total_orders   Int               @default(0)
  verified       Boolean           @default(false)
  active         Boolean           @default(true)
