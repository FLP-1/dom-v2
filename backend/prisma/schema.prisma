generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Budget {
  id         String   @id @db.VarChar(50)
  name       String   @db.VarChar(200)
  amount     Float
  spent      Float    @default(0)
  category   String   @db.VarChar(100)
  start_date DateTime @db.Timestamp(6)
  end_date   DateTime @db.Timestamp(6)
  status     String   @default("active") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  user_id    String?  @db.Uuid
  users      users?   @relation(fields: [user_id], references: [id])

  @@index([category], map: "idx_budgets_category")
  @@index([status], map: "idx_budgets_status")
  @@index([user_id], map: "idx_budgets_user_id")
  @@map("budgets")
}

model employees {
  id         String     @id @db.VarChar(50)
  name       String     @db.VarChar(200)
  cpf        String     @unique @db.VarChar(14)
  position   String     @db.VarChar(100)
  salary     Float
  status     String     @default("active") @db.VarChar(20)
  created_at DateTime   @default(now()) @db.Timestamp(6)
  updated_at DateTime   @default(now()) @db.Timestamp(6)
  user_id    String?    @db.Uuid
  users      users?     @relation(fields: [user_id], references: [id])
  payrolls   payrolls[]
  documents  Document[]
  payroll_items PayrollItem[]
  payslips   Payslip[]
  time_entries TimeEntry[]

  @@index([cpf], map: "idx_employees_cpf")
  @@index([status], map: "idx_employees_status")
  @@index([user_id], map: "idx_employees_user_id")
}

model groups {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @db.VarChar(255)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  description      String?
  type             String?            @db.VarChar(50)
  active           Boolean            @default(true)
  user_group_roles user_group_roles[]
  user_sessions    user_sessions[]
  messages         Message[]
}

model notifications {
  id           String    @id @db.VarChar(50)
  type         String    @db.VarChar(50)
  title        String    @db.VarChar(200)
  message      String
  recipient_id String    @db.VarChar(50)
  sender_id    String?   @db.VarChar(50)
  read         Boolean?
  created_at   DateTime? @db.Timestamp(6)
  read_at      DateTime? @db.Timestamp(6)
  extra_data   Json?     @db.Json
  priority     String?   @db.VarChar(20)
  category     String?   @db.VarChar(50)
  active       Boolean?
  updated_at   DateTime? @db.Timestamp(6)

  @@index([id], map: "ix_notifications_id")
}

model Payment {
  id          String   @id @db.VarChar(50)
  amount      Float
  description String   @db.VarChar(500)
  status      String   @default("pending") @db.VarChar(20)
  due_date    DateTime @db.Timestamp(6)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
  user_id     String?  @db.Uuid
  users       users?   @relation(fields: [user_id], references: [id])

  @@index([due_date], map: "idx_payments_due_date")
  @@index([status], map: "idx_payments_status")
  @@index([user_id], map: "idx_payments_user_id")
  @@map("payments")
}

model payrolls {
  id             String     @id @db.VarChar(50)
  employee_code  String     @db.VarChar(50)
  employee_name  String     @db.VarChar(200)
  base_salary    Float
  overtime_hours Float      @default(0)
  overtime_rate  Float      @default(1.5)
  bonuses        Float      @default(0)
  deductions     Float      @default(0)
  inss           Float      @default(0)
  irrf           Float      @default(0)
  fgts           Float      @default(0)
  net_salary     Float      @default(0)
  gross_salary   Float      @default(0)
  month          Int
  year           Int
  status         String     @default("pending") @db.VarChar(20)
  created_at     DateTime   @default(now()) @db.Timestamp(6)
  updated_at     DateTime   @default(now()) @db.Timestamp(6)
  user_id        String?    @db.Uuid
  employee_id    String?    @db.VarChar(50)
  employees      employees? @relation(fields: [employee_id], references: [id])
  users          users?     @relation(fields: [user_id], references: [id])

  @@index([employee_id], map: "idx_payrolls_employee_id")
  @@index([month, year], map: "idx_payrolls_month_year")
  @@index([status], map: "idx_payrolls_status")
  @@index([user_id], map: "idx_payrolls_user_id")
}

model purchases {
  id          String   @id @db.VarChar(50)
  title       String   @db.VarChar(200)
  description String?
  amount      Float
  status      String   @default("pending") @db.VarChar(20)
  category    String?  @db.VarChar(100)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
  user_id     String?  @db.Uuid
  users       users?   @relation(fields: [user_id], references: [id])

  @@index([category], map: "idx_purchases_category")
  @@index([status], map: "idx_purchases_status")
  @@index([user_id], map: "idx_purchases_user_id")
}

model tasks {
  id             String    @id @db.VarChar(50)
  title          String    @db.VarChar(200)
  description    String?
  status         String    @db.VarChar(20)
  priority       Int?
  created_at     DateTime? @db.Timestamp(6)
  due_date       DateTime? @db.Timestamp(6)
  completed_at   DateTime? @db.Timestamp(6)
  creator_id     String    @db.Uuid
  responsible_id String?   @db.Uuid
  category       String?   @db.VarChar(50)
  tags           Json?     @db.Json
  attachments    Json?     @db.Json
  comments       Json?     @db.Json
  active         Boolean?
  updated_at     DateTime? @db.Timestamp(6)

  @@index([id], map: "ix_tasks_id")
}

model user_group_roles {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  group_id   String    @db.Uuid
  role       String    @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  ativo      Boolean   @default(true)
  groups     groups    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, group_id])
  @@index([group_id], map: "idx_user_group_roles_group_id")
  @@index([user_id], map: "idx_user_group_roles_user_id")
}

model user_sessions {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String    @db.Uuid
  session_token           String    @unique @db.VarChar(255)
  active_group_id         String?   @db.Uuid
  active_role             String?   @db.VarChar(50)
  expires_at              DateTime  @db.Timestamp(6)
  created_at              DateTime? @default(now()) @db.Timestamp(6)
  updated_at              DateTime? @default(now()) @db.Timestamp(6)
  active_context_group_id String?   @db.Uuid
  active_context_role     String?   @db.VarChar(50)
  user_agent              String?   @db.VarChar(255)
  ip_address              String?   @db.VarChar(50)
  groups                  groups?   @relation(fields: [active_group_id], references: [id], onUpdate: NoAction)
  users                   users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_token], map: "idx_user_sessions_token")
  @@index([user_id], map: "idx_user_sessions_user_id")
}

model users {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @db.VarChar(255)
  nickname         String?            @unique @db.VarChar(20)
  cpf              String             @unique @db.VarChar(11)
  email            String             @unique @db.VarChar(255)
  user_photo       Bytes?
  password_hash    String             @db.VarChar(255)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  phone            String?            @db.VarChar(20)
  profile          String?            @default("employer") @db.VarChar(20)
  active           Boolean?           @default(true)
  last_login       DateTime?          @db.Timestamp(6)
  platforms        Json?              @default("[]") @db.Json
  permissions      Json?              @default("[]") @db.Json
  budgets          Budget[]
  employees        employees[]
  payments         Payment[]
  payrolls         payrolls[]
  purchases        purchases[]
  user_group_roles user_group_roles[]
  user_sessions    user_sessions[]
  user_consents    UserConsent[]
  timeclock_entries TimeClockEntry[]
  payroll_periods   PayrollPeriod[]
  payroll_configurations PayrollConfiguration?
  messages         Message[]
  message_reads    MessageRead[]
  user_achievements UserAchievement[]
  user_points      UserPoints[]
  user_challenges  UserChallenge[]
  user_settings    UserSettings?
  subscriptions    Subscription[]
  partner_profile  PartnerProfile?
  supplier_profile SupplierProfile?
  partner_reviews  PartnerReview[]
  service_bookings ServiceBooking[]
  supplier_orders  SupplierOrder[]
  documents        Document[]
  document_versions DocumentVersion[]
  shared_documents_received DocumentShare[] @relation("DocumentShareReceiver")
  shared_documents_sent     DocumentShare[] @relation("DocumentShareSender")
  partner_links             PartnerEmployerLink[]
  white_label_configs       WhiteLabelConfig[]
  esocial_certificates      ESocialCertificate[]
  esocial_events            ESocialEvent[]
  esocial_config            ESocialConfig?

  @@index([active], map: "idx_users_active")
  @@index([cpf], map: "idx_users_cpf")
  @@index([email], map: "idx_users_email")
}

// Sistema de Comunicação
model Message {
  id          String    @id @default(cuid()) @db.VarChar(50)
  content     String
  type        String    @default("text") @db.VarChar(20) // text, audio, image, file
  sender_id   String    @db.Uuid
  group_id    String?   @db.Uuid
  reply_to_id String?   @db.VarChar(50)
  metadata    Json?     @db.Json // audio_duration, file_size, etc.
  status      String    @default("sent") @db.VarChar(20) // sent, delivered, read
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @default(now()) @db.Timestamp(6)
  active      Boolean   @default(true)
  
  // Relations
  sender      users     @relation(fields: [sender_id], references: [id])
  group       groups?   @relation(fields: [group_id], references: [id])
  reply_to    Message?  @relation("MessageReplies", fields: [reply_to_id], references: [id])
  replies     Message[] @relation("MessageReplies")
  reads       MessageRead[]

  @@index([sender_id], map: "idx_messages_sender_id")
  @@index([group_id], map: "idx_messages_group_id")
  @@index([created_at], map: "idx_messages_created_at")
  @@index([status], map: "idx_messages_status")
  @@map("messages")
}

model MessageRead {
  id         String   @id @default(cuid()) @db.VarChar(50)
  message_id String   @db.VarChar(50)
  user_id    String   @db.Uuid
  read_at    DateTime @default(now()) @db.Timestamp(6)
  
  // Relations
  message    Message  @relation(fields: [message_id], references: [id])
  user       users    @relation(fields: [user_id], references: [id])

  @@unique([message_id, user_id])
  @@index([user_id], map: "idx_message_reads_user_id")
  @@index([message_id], map: "idx_message_reads_message_id")
  @@map("message_reads")
}

// Sistema de Gamificação
model Achievement {
  id          String    @id @default(cuid()) @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  icon        String?   @db.VarChar(50) // emoji ou nome do ícone
  category    String    @db.VarChar(50) // tasks, finance, communication, etc.
  type        String    @db.VarChar(30) // milestone, streak, challenge, etc.
  criteria    Json      @db.Json // critérios para desbloquear
  points      Int       @default(0)
  rarity      String    @default("common") @db.VarChar(20) // common, rare, epic, legendary
  active      Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @default(now()) @db.Timestamp(6)
  
  // Relations
  user_achievements UserAchievement[]

  @@index([category], map: "idx_achievements_category")
  @@index([type], map: "idx_achievements_type")
  @@index([active], map: "idx_achievements_active")
  @@map("achievements")
}

model UserAchievement {
  id             String      @id @default(cuid()) @db.VarChar(50)
  user_id        String      @db.Uuid
  achievement_id String      @db.VarChar(50)
  unlocked_at    DateTime    @default(now()) @db.Timestamp(6)
  progress       Json?       @db.Json // progresso atual se aplicável
  
  // Relations
  user           users       @relation(fields: [user_id], references: [id])
  achievement    Achievement @relation(fields: [achievement_id], references: [id])

  @@unique([user_id, achievement_id])
  @@index([user_id], map: "idx_user_achievements_user_id")
  @@index([achievement_id], map: "idx_user_achievements_achievement_id")
  @@map("user_achievements")
}

model UserPoints {
  id         String   @id @default(cuid()) @db.VarChar(50)
  user_id    String   @db.Uuid
  action     String   @db.VarChar(100) // task_completed, budget_saved, message_sent, etc.
  points     Int
  category   String   @db.VarChar(50) // tasks, finance, communication, etc.
  reference_id String? @db.VarChar(50) // ID da tarefa, orçamento, etc.
  metadata   Json?    @db.Json // dados extras sobre a ação
  created_at DateTime @default(now()) @db.Timestamp(6)
  
  // Relations
  user       users    @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "idx_user_points_user_id")
  @@index([action], map: "idx_user_points_action")
  @@index([category], map: "idx_user_points_category")
  @@index([created_at], map: "idx_user_points_created_at")
  @@map("user_points")
}

model Challenge {
  id          String    @id @default(cuid()) @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  type        String    @db.VarChar(30) // daily, weekly, monthly, custom
  category    String    @db.VarChar(50)
  criteria    Json      @db.Json // critérios do desafio
  reward_points Int     @default(0)
  reward_badge String?  @db.VarChar(50)
  start_date  DateTime  @db.Timestamp(6)
  end_date    DateTime  @db.Timestamp(6)
  active      Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @default(now()) @db.Timestamp(6)
  
  // Relations
  user_challenges UserChallenge[]

  @@index([type], map: "idx_challenges_type")
  @@index([category], map: "idx_challenges_category")
  @@index([active], map: "idx_challenges_active")
  @@index([start_date, end_date], map: "idx_challenges_dates")
  @@map("challenges")
}

model UserChallenge {
  id           String    @id @default(cuid()) @db.VarChar(50)
  user_id      String    @db.Uuid
  challenge_id String    @db.VarChar(50)
  status       String    @default("active") @db.VarChar(20) // active, completed, failed, abandoned
  progress     Json?     @db.Json // progresso atual
  started_at   DateTime  @default(now()) @db.Timestamp(6)
  completed_at DateTime? @db.Timestamp(6)
  
  // Relations
  user         users     @relation(fields: [user_id], references: [id])
  challenge    Challenge @relation(fields: [challenge_id], references: [id])

  @@unique([user_id, challenge_id])
  @@index([user_id], map: "idx_user_challenges_user_id")
  @@index([challenge_id], map: "idx_user_challenges_challenge_id")
  @@index([status], map: "idx_user_challenges_status")
  @@map("user_challenges")
}

// Sistema de Configurações de Usuário
model UserSettings {
  id         String   @id @default(cuid()) @db.VarChar(50)
  user_id    String   @unique @db.Uuid
  theme      Json     @default("{}") @db.Json // tema personalizado
  preferences Json    @default("{}") @db.Json // preferências gerais
  ui_config  Json     @default("{}") @db.Json // configurações de interface
  notifications Json  @default("{}") @db.Json // configurações de notificação
  privacy    Json     @default("{}") @db.Json // configurações de privacidade
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  
  // Relations
  user       users    @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "idx_user_settings_user_id")
  @@map("user_settings")
}

// Sistema de Planos e Assinaturas
model SubscriptionPlan {
  id          String   @id @default(cuid()) @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  price       Decimal  @db.Decimal(10,2)
  currency    String   @default("BRL") @db.VarChar(3)
  interval    String   @db.VarChar(20) // monthly, yearly
  features    Json     @db.Json
  limits      Json     @db.Json // max_employees, storage_gb, etc
  active      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @db.Timestamp(6)
  
  // Relations
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                String           @id @default(cuid()) @db.VarChar(50)
  user_id           String           @db.Uuid
  plan_id           String           @db.VarChar(50)
  status            String           @db.VarChar(20) // active, inactive, cancelled, expired
  current_period_start DateTime       @db.Timestamp(6)
  current_period_end   DateTime       @db.Timestamp(6)
  cancel_at_period_end Boolean        @default(false)
  cancelled_at      DateTime?        @db.Timestamp(6)
  trial_start       DateTime?        @db.Timestamp(6)
  trial_end         DateTime?        @db.Timestamp(6)
  metadata          Json?            @db.Json
  created_at        DateTime         @default(now()) @db.Timestamp(6)
  updated_at        DateTime         @default(now()) @db.Timestamp(6)
  
  // Relations
  user              users            @relation(fields: [user_id], references: [id])
  plan              SubscriptionPlan @relation(fields: [plan_id], references: [id])
  payments          PaymentRecord[]
  commissions       Commission[]

  @@index([user_id], map: "idx_subscriptions_user_id")
  @@index([status], map: "idx_subscriptions_status")
  @@map("subscriptions")
}

model PaymentRecord {
  id              String       @id @default(cuid()) @db.VarChar(50)
  subscription_id String       @db.VarChar(50)
  amount          Decimal      @db.Decimal(10,2)
  currency        String       @default("BRL") @db.VarChar(3)
  status          String       @db.VarChar(20) // pending, paid, failed, refunded
  payment_method  String       @db.VarChar(50) // credit_card, pix, boleto
  external_id     String?      @db.VarChar(100) // Stripe, banco, etc
  paid_at         DateTime?    @db.Timestamp(6)
  metadata        Json?        @db.Json
  created_at      DateTime     @default(now()) @db.Timestamp(6)
  
  // Relations
  subscription    Subscription @relation(fields: [subscription_id], references: [id])
  commissions     Commission[]

  @@index([subscription_id], map: "idx_payment_records_subscription")
  @@index([status], map: "idx_payment_records_status")
  @@map("payment_records")
}

// Sistema de Parceiros
model PartnerProfile {
  id              String   @id @default(cuid()) @db.VarChar(50)
  user_id         String   @unique @db.Uuid
  company_name    String   @db.VarChar(255)
  cnpj            String?  @db.VarChar(18)
  service_type    String   @db.VarChar(100) // cleaning, gardening, maintenance, etc
  description     String?  @db.Text
  service_area    Json     @db.Json // regions, neighborhoods
  price_range     Json     @db.Json // min, max prices
  availability    Json     @db.Json // schedule, days
  rating          Decimal? @db.Decimal(3,2)
  total_reviews   Int      @default(0)
  verified        Boolean  @default(false)
  active          Boolean  @default(true)
  
  // White-label Configuration
  white_label_enabled Boolean @default(false)
  brand_name         String? @db.VarChar(255)
  brand_logo_url     String? @db.VarChar(500)
  brand_colors       Json?   @db.Json // primary, secondary, accent
  custom_domain      String? @db.VarChar(255)
  custom_subdomain   String? @unique @db.VarChar(100)
  brand_settings     Json?   @db.Json // custom CSS, fonts, etc
  
  // Commission Configuration
  commission_enabled Boolean @default(false)
  commission_type    String? @db.VarChar(20) // percentage, fixed, tiered
  commission_rate    Decimal? @db.Decimal(5,2) // percentage or fixed amount
  commission_tiers   Json?   @db.Json // tiered commission structure
  payment_terms      Json?   @db.Json // when and how commissions are paid
  
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)
  
  // Relations
  user            users    @relation(fields: [user_id], references: [id])
  services        PartnerService[]
  reviews         PartnerReview[]
  linked_employers PartnerEmployerLink[]
  commissions     Commission[]
  white_label_configs WhiteLabelConfig[]

  @@index([service_type], map: "idx_partner_profiles_service_type")
  @@index([verified], map: "idx_partner_profiles_verified")
  @@index([custom_subdomain], map: "idx_partner_profiles_subdomain")
  @@index([white_label_enabled], map: "idx_partner_profiles_white_label")
  @@map("partner_profiles")
}

model PartnerService {
  id          String         @id @default(cuid()) @db.VarChar(50)
  partner_id  String         @db.VarChar(50)
  name        String         @db.VarChar(255)
  description String?        @db.Text
  price       Decimal        @db.Decimal(10,2)
  unit        String         @db.VarChar(50) // hour, day, service
  active      Boolean        @default(true)
  created_at  DateTime       @default(now()) @db.Timestamp(6)
  
  // Relations
  partner     PartnerProfile @relation(fields: [partner_id], references: [id])
  bookings    ServiceBooking[]

  @@index([partner_id], map: "idx_partner_services_partner")
  @@map("partner_services")
}

model PartnerReview {
  id          String         @id @default(cuid()) @db.VarChar(50)
  partner_id  String         @db.VarChar(50)
  user_id     String         @db.Uuid
  rating      Int            @db.SmallInt
  comment     String?        @db.Text
  created_at  DateTime       @default(now()) @db.Timestamp(6)
  
  // Relations
  partner     PartnerProfile @relation(fields: [partner_id], references: [id])
  user        users          @relation(fields: [user_id], references: [id])

  @@index([partner_id], map: "idx_partner_reviews_partner")
  @@map("partner_reviews")
}

model ServiceBooking {
  id          String         @id @default(cuid()) @db.VarChar(50)
  service_id  String         @db.VarChar(50)
  user_id     String         @db.Uuid
  scheduled_date DateTime     @db.Timestamp(6)
  status      String         @db.VarChar(20) // pending, confirmed, completed, cancelled
  total_price Decimal        @db.Decimal(10,2)
  notes       String?        @db.Text
  created_at  DateTime       @default(now()) @db.Timestamp(6)
  updated_at  DateTime       @default(now()) @db.Timestamp(6)
  
  // Relations
  service     PartnerService @relation(fields: [service_id], references: [id])
  user        users          @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "idx_service_bookings_user")
  @@index([status], map: "idx_service_bookings_status")
  @@map("service_bookings")
}

// Sistema de Fornecedores
model SupplierProfile {
  id              String   @id @default(cuid()) @db.VarChar(50)
  user_id         String   @unique @db.Uuid
  company_name    String   @db.VarChar(255)
  cnpj            String?  @db.VarChar(18)
  supplier_type   String   @db.VarChar(100) // products, materials, equipment
  description     String?  @db.Text
  delivery_areas  Json     @db.Json
  min_order       Decimal? @db.Decimal(10,2)
  payment_terms   Json     @db.Json
  rating          Decimal? @db.Decimal(3,2)
  total_orders    Int      @default(0)
  verified        Boolean  @default(false)
  active          Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)
  
  // Relations
  user            users    @relation(fields: [user_id], references: [id])
  products        SupplierProduct[]
  orders          SupplierOrder[]

  @@index([supplier_type], map: "idx_supplier_profiles_type")
  @@index([verified], map: "idx_supplier_profiles_verified")
  @@map("supplier_profiles")
}

model SupplierProduct {
  id          String          @id @default(cuid()) @db.VarChar(50)
  supplier_id String          @db.VarChar(50)
  name        String          @db.VarChar(255)
  description String?         @db.Text
  category    String          @db.VarChar(100)
  price       Decimal         @db.Decimal(10,2)
  unit        String          @db.VarChar(50)
  stock       Int?
  active      Boolean         @default(true)
  created_at  DateTime        @default(now()) @db.Timestamp(6)
  updated_at  DateTime        @default(now()) @db.Timestamp(6)
  
  // Relations
  supplier    SupplierProfile @relation(fields: [supplier_id], references: [id])
  order_items SupplierOrderItem[]

  @@index([supplier_id], map: "idx_supplier_products_supplier")
  @@index([category], map: "idx_supplier_products_category")
  @@map("supplier_products")
}

model SupplierOrder {
  id          String          @id @default(cuid()) @db.VarChar(50)
  supplier_id String          @db.VarChar(50)
  user_id     String          @db.Uuid
  order_number String         @unique @db.VarChar(50)
  status      String          @db.VarChar(20) // pending, confirmed, shipped, delivered, cancelled
  total_amount Decimal        @db.Decimal(10,2)
  delivery_date DateTime?     @db.Timestamp(6)
  notes       String?         @db.Text
  created_at  DateTime        @default(now()) @db.Timestamp(6)
  updated_at  DateTime        @default(now()) @db.Timestamp(6)
  
  // Relations
  supplier    SupplierProfile @relation(fields: [supplier_id], references: [id])
  user        users           @relation(fields: [user_id], references: [id])
  items       SupplierOrderItem[]

  @@index([user_id], map: "idx_supplier_orders_user")
  @@index([status], map: "idx_supplier_orders_status")
  @@map("supplier_orders")
}

model SupplierOrderItem {
  id         String          @id @default(cuid()) @db.VarChar(50)
  order_id   String          @db.VarChar(50)
  product_id String          @db.VarChar(50)
  quantity   Decimal         @db.Decimal(10,2)
  unit_price Decimal         @db.Decimal(10,2)
  total_price Decimal        @db.Decimal(10,2)
  
  // Relations
  order      SupplierOrder   @relation(fields: [order_id], references: [id])
  product    SupplierProduct @relation(fields: [product_id], references: [id])

  @@index([order_id], map: "idx_supplier_order_items_order")
  @@map("supplier_order_items")
}

// Sistema de Gestão de Documentos
model DocumentCategory {
  id          String     @id @default(cuid()) @db.VarChar(50)
  name        String     @db.VarChar(100)
  description String?    @db.Text
  icon        String?    @db.VarChar(50)
  color       String?    @db.VarChar(7)
  active      Boolean    @default(true)
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  
  // Relations
  documents   Document[]

  @@map("document_categories")
}

model Document {
  id            String           @id @default(cuid()) @db.VarChar(50)
  name          String           @db.VarChar(255)
  description   String?          @db.Text
  category_id   String           @db.VarChar(50)
  user_id       String           @db.Uuid
  employee_id   String?          @db.VarChar(50)
  file_name     String           @db.VarChar(255)
  file_path     String           @db.VarChar(500)
  file_size     Int              // bytes
  file_type     String           @db.VarChar(100) // mime type
  file_hash     String           @db.VarChar(64) // SHA-256
  version       Int              @default(1)
  status        String           @default("active") @db.VarChar(20) // active, archived, deleted
  tags          Json?            @db.Json
  metadata      Json?            @db.Json
  expiry_date   DateTime?        @db.Timestamp(6)
  is_sensitive  Boolean          @default(false)
  access_level  String           @default("private") @db.VarChar(20) // public, private, restricted
  created_at    DateTime         @default(now()) @db.Timestamp(6)
  updated_at    DateTime         @default(now()) @db.Timestamp(6)
  
  // Relations
  category      DocumentCategory @relation(fields: [category_id], references: [id])
  user          users            @relation(fields: [user_id], references: [id])
  employee      employees?       @relation(fields: [employee_id], references: [id])
  versions      DocumentVersion[]
  shares        DocumentShare[]

  @@index([user_id], map: "idx_documents_user")
  @@index([category_id], map: "idx_documents_category")
  @@index([employee_id], map: "idx_documents_employee")
  @@index([status], map: "idx_documents_status")
  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(cuid()) @db.VarChar(50)
  document_id String   @db.VarChar(50)
  version     Int
  file_name   String   @db.VarChar(255)
  file_path   String   @db.VarChar(500)
  file_size   Int
  file_hash   String   @db.VarChar(64)
  changes     String?  @db.Text
  created_by  String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamp(6)
  
  // Relations
  document    Document @relation(fields: [document_id], references: [id])
  creator     users    @relation(fields: [created_by], references: [id])

  @@unique([document_id, version])
  @@index([document_id], map: "idx_document_versions_document")
  @@map("document_versions")
}

model DocumentShare {
  id          String   @id @default(cuid()) @db.VarChar(50)
  document_id String   @db.VarChar(50)
  shared_with String   @db.Uuid
  shared_by   String   @db.Uuid
  permissions Json     @db.Json // read, write, delete
  expires_at  DateTime? @db.Timestamp(6)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  
  // Relations
  document    Document @relation(fields: [document_id], references: [id])
  shared_user users    @relation("DocumentShareReceiver", fields: [shared_with], references: [id])
  sharer      users    @relation("DocumentShareSender", fields: [shared_by], references: [id])

  @@index([document_id], map: "idx_document_shares_document")
  @@index([shared_with], map: "idx_document_shares_receiver")
  @@map("document_shares")
}

// Sistema White-Label e Comissionamento
model PartnerEmployerLink {
  id              String   @id @default(cuid()) @db.VarChar(50)
  partner_id      String   @db.VarChar(50)
  employer_id     String   @db.Uuid
  link_type       String   @db.VarChar(20) // referral, managed, white_label
  status          String   @default("active") @db.VarChar(20) // active, inactive, suspended
  referral_code   String?  @unique @db.VarChar(50)
  commission_rate Decimal? @db.Decimal(5,2) // override partner default
  white_label_config Json? @db.Json // custom branding for this employer
  metadata        Json?    @db.Json
  linked_at       DateTime @default(now()) @db.Timestamp(6)
  activated_at    DateTime? @db.Timestamp(6)
  
  // Relations
  partner         PartnerProfile @relation(fields: [partner_id], references: [id])
  employer        users          @relation(fields: [employer_id], references: [id])
  commissions     Commission[]

  @@index([partner_id], map: "idx_partner_employer_links_partner")
  @@index([employer_id], map: "idx_partner_employer_links_employer")
  @@index([referral_code], map: "idx_partner_employer_links_referral")
  @@index([status], map: "idx_partner_employer_links_status")
  @@map("partner_employer_links")
}

model Commission {
  id              String   @id @default(cuid()) @db.VarChar(50)
  partner_id      String   @db.VarChar(50)
  employer_link_id String  @db.VarChar(50)
  subscription_id String?  @db.VarChar(50)
  payment_record_id String? @db.VarChar(50)
  
  // Commission Details
  commission_type String   @db.VarChar(20) // subscription, payment, signup, renewal
  base_amount     Decimal  @db.Decimal(10,2) // amount that commission is calculated on
  commission_rate Decimal  @db.Decimal(5,2) // percentage or fixed
  commission_amount Decimal @db.Decimal(10,2) // calculated commission
  currency        String   @default("BRL") @db.VarChar(3)
  
  // Status and Timing
  status          String   @default("pending") @db.VarChar(20) // pending, approved, paid, cancelled
  earned_at       DateTime @default(now()) @db.Timestamp(6)
  due_date        DateTime @db.Timestamp(6)
  paid_at         DateTime? @db.Timestamp(6)
  
  // Payment Details
  payment_method  String?  @db.VarChar(50)
  payment_reference String? @db.VarChar(100)
  notes           String?  @db.Text
  metadata        Json?    @db.Json
  
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)
  
  // Relations
  partner         PartnerProfile @relation(fields: [partner_id], references: [id])
  employer_link   PartnerEmployerLink @relation(fields: [employer_link_id], references: [id])
  subscription    Subscription? @relation(fields: [subscription_id], references: [id])
  payment_record  PaymentRecord? @relation(fields: [payment_record_id], references: [id])

  @@index([partner_id], map: "idx_commissions_partner")
  @@index([employer_link_id], map: "idx_commissions_employer_link")
  @@index([status], map: "idx_commissions_status")
  @@index([earned_at], map: "idx_commissions_earned_at")
  @@index([due_date], map: "idx_commissions_due_date")
  @@map("commissions")
}

model WhiteLabelConfig {
  id              String   @id @default(cuid()) @db.VarChar(50)
  partner_id      String   @db.VarChar(50)
  employer_id     String?  @db.Uuid // null = default partner config
  
  // Branding
  brand_name      String   @db.VarChar(255)
  logo_url        String?  @db.VarChar(500)
  favicon_url     String?  @db.VarChar(500)
  colors          Json     @db.Json // primary, secondary, accent, text, background
  fonts           Json?    @db.Json // font families and sizes
  
  // Domain Configuration
  custom_domain   String?  @db.VarChar(255)
  subdomain       String?  @db.VarChar(100)
  ssl_enabled     Boolean  @default(false)
  
  // UI Customization
  custom_css      String?  @db.Text
  header_config   Json?    @db.Json // logo position, navigation style
  footer_config   Json?    @db.Json // custom footer content
  login_config    Json?    @db.Json // custom login page
  
  // Features Toggle
  features_enabled Json    @db.Json // which features to show/hide
  modules_config  Json?    @db.Json // module-specific customizations
  
  // SEO and Meta
  meta_title      String?  @db.VarChar(255)
  meta_description String? @db.VarChar(500)
  meta_keywords   String?  @db.Text
  
  active          Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)
  
  // Relations
  partner         PartnerProfile @relation(fields: [partner_id], references: [id])
  employer        users?         @relation(fields: [employer_id], references: [id])

  @@unique([partner_id, employer_id])
  @@index([partner_id], map: "idx_white_label_configs_partner")
  @@index([employer_id], map: "idx_white_label_configs_employer")
  @@index([subdomain], map: "idx_white_label_configs_subdomain")
  @@map("white_label_configs")
}

  // Sistema de Folha de Pagamento
  model PayrollPeriod {
    id              String   @id @default(cuid()) @db.VarChar(50)
    user_id         String   @db.Uuid
    reference_month Int      // 1-12
    reference_year  Int      // 2024, 2025, etc
    status          String   @default("draft") @db.VarChar(20) // draft, calculated, approved, paid, closed
